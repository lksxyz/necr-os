HANDLE INT 11h
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HAVE INTERRUPT 11h (GET EQUIPMENT LIST) RUN THIS PROGRAM EVERY TIME IT OCCURS
;Inputs:
;Outputs: {E}AX = Equipment List, making sure it shows a PS2 Port is Installed
;Changes:
;------------------------------------------------------------------------------
Int11Hdr:
  DB TYPE IntHdr DUP (0) ;Header for removable interrupt vector code

Int11:
  PUSHF                        ;Call the
  CALL D CS:Int11Hdr.OldVector ;  Old Handler (returns {E}AX)
  TEST CS:TSRFlags,EmuHardware ;Emulating the BIOS?
  JNZ >V90                     ;If not, we're done
  OR   AL,Int11PS2Installed    ;If so, mark PS2 Port as installed
V90:                           ;Done
  IRET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE INT 15h
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HAVE INTERRUPT 15h (BIOS SERVICES) RUN THIS PROGRAM EVERY TIME IT OCCURS
;Inputs:
;Outputs: Emulates a PS2 Port with a Mouse Attached to it
;         Depending on Exact Call SubType (value in AL), will return
;           various values in AX, BX, CX and/or DX
;Changes:
;------------------------------------------------------------------------------
Int15Hdr:
  DB TYPE IntHdr DUP (0) ;Header for removable interrupt vector code

Int15:
  PUSHF                            ;Save flags
  STI                              ;Enable interrupts
  CLD                              ;Go forward with string functions
  TEST CS:TSRFlags,EmuHardware     ;Are we emulating hardware?
  JNZ  Int15Old                    ;If so, let the old handler process it
  CMP  AH,Int15PS2PortCall         ;Is it one of the PS2 functions?
  JNE  Int15Old                    ;If not, it's not for us
  CMP  AL,I15ALSetHandler          ;Valid Function Number?
  JBE >F05                         ;If so, handle it
  CMP  AL,I15ALGetHandler          ;Valid Function Number?
  JE  >F05                         ;If so, handle it
  MOV  AH,Int15ErrInvalidFunction  ;If not,
  JMP >F75                         ;  it's an error
F05:                               ;It's for us!
  CALL MakeStack                   ;Set up our own Stack Space
  PUSH BP,DS,ES                    ;Save used registers
  MOV  BP,ES                       ;Save users ES on the call (may need it)
  MOV  DS,CS                       ;Point DS at our data area
  MOV  ES,CS                       ;Point ES at our data area
  CALL DoInt15Function             ;Do our thing
  JNC >F80                         ;If no error, jump to handle it
F70:                               ;Error
  POP  ES,DS,BP                    ;Restore used registers
  CALL ReturnStack                 ;Restore original Stack Space
F75:                               ;Error, no saved registers
  POPF                             ;Restore flags
  PUSH BP                          ;Save used registers
  MOV  BP,SP                       ;Point BP at the stack
  OR   B SS:[BP+6],CarryFlag       ;Set Carry Flag for the return
  JMP >F90                         ;Done
F80:                               ;No Error
  POP  ES,DS,BP                    ;Restore used registers
  CALL ReturnStack                 ;Restore original Stack Space
  POPF                             ;Restore flags
  PUSH BP                          ;Save used registers
  MOV  BP,SP                       ;Point BP at the stack
  AND  B SS:[BP+6],(NOT CarryFlag) ;Clear Carry Flag for the return
F90:                               ;Done
  POP  BP                          ;Restore used registers
  IRET

Int15Old:
  POPF                             ;Restore flags
  JMP  D CS:Int15Hdr.OldVector     ;Let the Old Interrupt Handler do it

;------------------------------------------------------------------------------
;DO APPROPRIATE INT 15 (PS2/MOUSE) SUBFUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AL = SubFunction to Perform
;         BP = Caller's ES
;         BX = Unchanged from Caller
;Outputs: CF = Clear if OK
;           Returns various values in AX, BX, CX and/or DX, depending on call
;         CF = Set if Error
;           AH = Error Code, all other registers unchanged
;Changes:
;------------------------------------------------------------------------------
DoInt15Function:
  PUSH DI                         ;Save used registers
  MOV  DI,BX                      ;Save original BX
  MOV  AH,Int15ErrInvalidFunction ;Assume invalid function
  MOV  BX,Int15FunctionTbl        ;Point at function table
  CALL SearchByteToWordTbl        ;Look for our function
  XCHG  BX,DI                     ;Put Function Code in DI,
                                  ;  restore original BX
  JC  >I70                        ;If error, we're done
  CMP  AL,I15ALSetSampling        ;Is it Set Sample Rate?
  JE  >I10                        ;If so, continue
  MOV  W EnableWheelCounter,0     ;If not, Reset Enable Wheel Counters
I10:                              ;Do Function
  XOR  AH,AH                      ;Assume no errors from now on
  CALL DI                         ;Call the function
  JNC >I80                        ;If no error, we're done
  OR   AH,AH                      ;Did it return a valid error code?
  JNZ >I70                        ;If so, we're done
  MOV  AH,Int15ErrNeedToResend    ;If not, default = Resend
I70:                              ;Error
  STC                             ;Set Error Flag
  JMP >I90                        ;Done
I80:                              ;OK
  CLC                             ;Set OK flag
I90:                              ;Done
  POP  DI                         ;Restore used registers
  RET

;------------------------------------------------------------------------------
;DO THE PS2 ENABLE/DISABLE HANDLER FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AL = Original INT 15h Function Code (Enable/Disable)
;         AH = 0
;         BH = Function to Perform (0 = Disable, 1 = Enable)
;Outputs: CF = Set if error
;              AH = Error Code
;            = Clear if OK
;              AH = Unchanged
;              Int15Enabled changed as appropriate
;Changes:
;------------------------------------------------------------------------------
PS2EnableDisable:
  CMP  BH,1                        ;Is it Enable or Disable?
  JA  >E70                         ;If neither, Error
  JE  >E20                         ;If Enable, jump to handle it
E10:                               ;Disable
  AND  TSRFlags,(NOT Int15Enabled) ;Mark as Disabled
  JMP >E80                         ;Done
E20:                               ;Enable
  CMP  W MouseUserFarCall[2],0     ;Is there a registered Handler address?
  JNE >E30                         ;If so, it's OK to Enable
  MOV  AH,Int15ErrNoDeviceHandler  ;If not, Error = No Handler
  JMP >E75                         ;Done
E30:                               ;OK to Enable
  OR   TSRFlags,Int15Enabled       ;Mark as Enabled
  CALL ResetTotals                 ;Reset Movement Counters
  JMP >E80                         ;Done
E70:                               ;Error
  MOV  AH,Int15ErrInvalidInput     ;Error = Invalid value in BH
E75:                               ;Error, AH = Error Code
  STC                              ;Set Error Flag
  JMP >E90                         ;Done
E80:                               ;No Error
  CLC                              ;Set OK flag
E90:                               ;Done
  RET

;------------------------------------------------------------------------------
;DO THE PS2 RESET FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AH = 0
;Outputs: CF = Set if error
;              AH = Error Code
;            = Clear if OK
;              AH = Unchanged (0)
;              BH = Device ID (0)
;              BL = Device Type (Mouse)
;              Mouse has been Reset
;Changes:
;------------------------------------------------------------------------------
PS2Reset:
;  MOV  BH,3                    ;Default Data Size = 3 Bytes
  MOV  BH,Int15DataSize        ;Data Size = Unchanged
  CALL PS2Initialize           ;Do a Soft Initialization
  ;MOV  DeviceID,DvcIDWheelNo   ;Disable Wheel(s)
  MOV  W MouseUserFarCall[2],0 ;Reset Far Call Address
  ;CALL RePointPS2Handler       ;RePoint PS2 handler at us
  MOV  BX,DvcTypeMouse         ;Rtn BH = Device ID = 0 (No Wheels)
                               ;Rtn BL = Device Type = Mouse
  CLC                          ;Set Return Flag
  RET

;------------------------------------------------------------------------------
;DO THE PS2 INITIALIZE FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AH = 0
;         BH = Data Package Size to use (1-8 bytes)
;              We will only allow a size of 3 or 4 for the Mouse
;Outputs: CF = Set if error
;              AH = Error Code
;            = Clear if OK
;              AH = Unchanged (0)
;              Mouse Software has been Initialized
;Changes:
;------------------------------------------------------------------------------
PS2Initialize:
  PUSH BX                            ;Save used registers
  CMP  BH,4                          ;Is data valid?
  JA  >I70                           ;If not, error
  CMP  BH,3                          ;Is data valid?
  JB  >I70                           ;If not, error
  MOV  Int15DataSize,BH              ;Store it
  MOV  DeviceID,DvcIDWheelNo         ;Disable Wheel(s)
  MOV  SampleRateCode,SampleCode100  ;Store the Default Sample Rate Code
  MOV  BL,DefaultPeriodicity         ;Set the
  CALL ChangePeriodicity             ;  Default Periodicity
  AND  TSRFlags,(NOT ScalingFactor2) ;Default Scaling Factor is 1:1
  MOV  Resolution,Resolution4        ;Default Resolution is 4 counts/mm
  AND  TSRFlags,(NOT Int15Enabled)   ;Default = Disabled
  JMP >I80                           ;Done
I70:                                 ;Error
  MOV  AH,Int15ErrInvalidInput       ;Error Code
  STC                                ;Error Flag
  JMP >I90                           ;Done
I80:                                 ;OK
  CALL ResetTotals                   ;Reset Movement Counters
  CLC                                ;Set OK Flag
I90:                                 ;Done
  POP  BX                            ;Restore used registers
  RET

;------------------------------------------------------------------------------
;DO THE PS2 SET SAMPLE RATE FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AL = Original INT 15h Function Code (Set Sample Rate)
;         AH = 0
;         BH = Sample Rate Code (See SampleRateTable)
;Outputs: CF = Set if error
;              AH = Error Code (Invalid Input)
;            = Clear if OK
;              AH = Unchanged
;              Sample Rate changed as appropriate
;Changes:
;------------------------------------------------------------------------------
PS2SetSampleRate:
  PUSH BX,DX                   ;Save used registers
  CMP  BH,SampleCode200        ;Is it a valid Function Code?
  JA  >S70                     ;If not, error
  CMP  BH,SampleCode080        ;Is it the possible end of a Setup?
  JNE >S05                     ;If not, it's OK
  MOV  BH,SampleCode010        ;If so, send a Code to make sure it doesn't
  CALL DoPS2MouseFunction      ;  Change the PS2 Mouse Setup
  MOV  BH,SampleCode080        ;Restore original Sample Code
S05:                           ;PS2 Mouse handled
  CALL DoPS2MouseFunction      ;If OK, send it to the PS2 Mouse
  MOV  DX,W EnableWheelCounter ;Put Wheel Counter in DX
  CMP  BH,SampleCode200        ;Is it a valid Function Code?
  JE  >S30                     ;If so, see if it's part of a Wheel Enable
  CMP  BH,SampleCode100        ;Possible Wheel enable?
  JE  >S20                     ;If so, handle it
  CMP  BH,SampleCode080        ;Possible Wheel enable?
  JNE >S50                     ;If not, continue
S10:                           ;Setting 80
  CMP  DL,2                    ;End of Wheel Enable?
  JNE >S15                     ;If not, try next possibility
  MOV  DeviceID,DvcIDWheel1Yes ;If so, Enable Wheel
  JMP >S40                     ;Reset Wheel Enable Counter
S15:                           ;Not enabling 1 wheel
  CMP  DH,2                    ;End of Wheels Enable?
  JNE >S40                     ;If not, reset Wheel Enable Counters
  MOV  DeviceID,DvcIDWheel2Yes ;If so, Enable Wheels
  JMP >S40                     ;Reset Wheel Enable Counter
S20:                           ;Setting 100
  CMP  DL,1                    ;Possible Wheel Enable?
  JNE >S40                     ;If not, reset Wheel Enable Counter
  INC  DL                      ;If so, Increment the Wheel Enable Counter
  JMP >S50                     ;Continue
S30:                           ;Setting 200
  OR   DX,DX                   ;Possible Wheel(s) Enable?
  JNZ >S35                     ;If not, try next possibility
  ADD  DX,0101h                ;If so, increment both Wheel Counters
  ;MOV  IntelliTimer,5          ;Initialize Timeout Counter
  JMP >S50                     ;Continue
S35:                           ;Not enabling 1 wheel
  CMP  DH,1                    ;Possible enable Wheels?
  JNE >S40                     ;If not, reset Wheel Enable Counters
  INC  DH                      ;If so, increment Wheels Counter
  XOR  DL,DL                   ;Reset Wheel Counter
  JMP >S50                     ;Continue
S40:                           ;Not part of Wheel enable
  XOR  DX,DX                   ;Reset Wheel Enable Counters
S50:                           ;Wheel enable Accounted for
  MOV  W EnableWheelCounter,DX ;Store Counters for next time
  MOV  SampleRateCode,BH       ;If OK, store it
  PUSH AX                      ;Save AX for a second
  MOV  AL,BH                   ;Convert Sample Rate Code
  MOV  BX,SampleRateTable      ;  Code to a
  CALL SearchByteToWordTbl     ;  Periodicity factor (BH)
  POP  AX                      ;Restore AX
  JC  >S70                     ;Quit if error
  MOV  BL,BH                   ;If OK,
  CALL ChangePeriodicity       ;  Change Periodicity
  JMP >S80                     ;Done
S70:                           ;Error
  MOV  AH,Int15ErrInvalidInput ;Error = Invalid value in BH
  STC                          ;Set Error Flag
  JMP >S90                     ;Done
S80:                           ;No Error
;  XOR  AH,AH                   ;Error Code = None
  CLC                          ;Set OK flag
S90:                           ;Done
  POP  DX,BX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;DO THE PS2 SET RESOLUTION FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AL = Original INT 15h Function Code (Set Resolution)
;         AH = 0
;         BH = Resolution Code
;              0 = 1 Counts/mm
;              1 = 2 Counts/mm
;              2 = 4 Counts/mm
;              3 = 8 Counts/mm
;         AL = Original Function Code (Set Resolution)
;Outputs: CF = Set if error
;              AH = Error Code (Invalid Input)
;            = Clear if OK
;              AH = Unchanged
;              Resolution changed as appropriate
;Changes:
;------------------------------------------------------------------------------
PS2SetResolution:
  CMP  BH,Resolution8          ;Is it a valid function code?
  JA  >R70                     ;If not, error
;  CALL DoPS2MouseFunction      ;If OK, pass on to PS2 Handler
  MOV  Resolution,BH           ;Store it
  JMP >R80                     ;Done
R70:                           ;Error
  MOV  AH,Int15ErrInvalidInput ;Error = Invalid value in BH
  STC                          ;Set Error Flag
  JMP >R90                     ;Done
R80:                           ;OK
  CLC                          ;Set OK Flag
R90:                           ;Done
  RET

;------------------------------------------------------------------------------
;DO THE PS2 GET DEVICE ID FUNCTION
;Inputs:  ES = TSR Data Area
;         AL = Original INT 15h Function Code (Get Device ID)
;         AH = 0
;Outputs: CF = Clear
;              BH = Device ID (DvcIDWheelNo, Wheel1Yes, or Wheel2Yes)
;Changes:
;------------------------------------------------------------------------------
PS2GetDeviceIDBH:
  MOV  BH,ES:DeviceID ;Set BH = Device ID
  CLC                 ;Set OK Flag
  RET

;------------------------------------------------------------------------------
;DO THE PS2 GET STATUS/EXTENDED COMMANDS FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         BH = 0 for Get Status
;            = 1 for Set 1:1 Scaling
;            = 2 for Set 2:1 Scaling
;         AL = Original INT 15h Function Code (Get Status)
;         AH = 0
;Outputs: CF = Set if error
;              AH = Error Code
;            = Clear if OK
;              AH = Unchanged
;              Appropriate Function performed
;              If Get Status:
;                BL = Enabled, Scaling, Buttons 1-3
;                CL = Resolution
;                DL = Sampling Rate
;Changes:
;NOTES: If Function = Get Status, does not pass on to PS2 Handler.
;       If Function = Set Scaling, does pass on to PS2 Handler.
;------------------------------------------------------------------------------
PS2GetStatus:
  PUSH SI                            ;Save used registers
  CMP  BH,2                          ;Is it a valid subfunction?
  JA  >E70                           ;If not, error
  JE  >E40                           ;If function 2 (Set 2:1 Scaling), handle it
  OR   BH,BH                         ;Is it function 1 (Set 1:1 Scaling)?
  JNZ >E30                           ;If so, handle it
E10:                                 ;Function 0 (Get Status)
  CALL CalcStatus                    ;Calculate correct status (Returns BL)
  MOV  CL,Resolution                 ;Get Resolution
  CALL CalcSampleRate                ;Calculate the Sample Rate (Returns DL)
  JMP >E80                           ;Done
E30:                                 ;Set Scaling Factor to 1:1
;  CALL DoPS2MouseFunction            ;Pass on to PS2 Handler
  AND  TSRFlags,(NOT ScalingFactor2) ;Set Scaling Factor at 1:1
  JMP >E80                           ;Done
E40:                                 ;Set Scaling Factor at 2:1
;  CALL DoPS2MouseFunction            ;Pass on to PS2 Handler
  OR   TSRFlags,ScalingFactor2       ;Set Scaling Factor at 2:1
  JMP >E80                           ;Done
E70:                                 ;Error
  MOV  AH,Int15ErrInvalidInput       ;Error Code
  STC                                ;Error Flag
  JMP >E90                           ;Done
E80:                                 ;OK
  CLC                                ;Set OK Flag
E90:                                 ;Done
  POP  SI                            ;Restore used registers
  RET

;------------------------------------------------------------------------------
;DO THE PS2 SET HANDLER ADDRESS FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AL = Original INT 15h Function Code (Set Handler Address)
;         AH = 0
;         BP:BX = New Far Call Address (0 if resetting)
;Outputs: CF = Set if error
;              AH = Error Code
;            = Clear if OK
;              New Device Address Stored
;Changes:
;NOTES: If Handler is already Disabled (0), it is an Error to Disable it
;       If Set, it is an Error to Set it Again
;------------------------------------------------------------------------------
PS2SetHandlerAddress:
  OR   BP,BP                      ;Are we resetting the Address?
  JZ  >H30                        ;If so, handle it
  CMP  W MouseUserFarCall[2],0    ;If not, is it currently 0 (Disabled)?
  JNE >H70                        ;If not, error
  JMP >H50                        ;If so, it's OK
H30:                              ;Resetting
  OR   BX,BX                      ;Is the Offset also 0?
  JNZ >H70                        ;If not, error
  CMP  W MouseUserFarCall[2],0    ;Is it already 0?
  JE  >H70                        ;If so, there's an error
H50:                              ;OK to store it
  MOV  W MouseUserFarCall[2],BP   ;Store Far Call Segment
  MOV  W MouseUserFarCall[0],BX   ;Store Far Call Offset
  JMP >H80                        ;Done
H70:                              ;Error
  MOV  AH,Int15ErrNoDeviceHandler ;Error Code
  STC                             ;Error flag
  JMP >H90                        ;Done
H80:                              ;OK
  CLC                             ;Set OK Flag
H90:                              ;Done
  RET

;------------------------------------------------------------------------------
;DO THE PS2 GET HANDLER ADDRESS FUNCTION
;Inputs:  DS = ES = TSR Data Area
;         AL = Original INT 15h Function Code (Get Handler Address)
;         AH = 0
;Outputs: CF = Clear
;              CX:DX = Handler Address
;Changes:
;------------------------------------------------------------------------------
PS2GetHandlerAddress:
  MOV  CX,W MouseUserFarCall[2] ;CX = Far Call Segment
  MOV  DX,W MouseUserFarCall[0] ;DX = Far Call Offset
  CLC                           ;Set OK Flag
  RET

;;------------------------------------------------------------------------------
;;RE-POINT PS2 (BIOS) HANDLER AT OUR USER CODE
;;Inputs:  ES = TSR Data Area
;;         PS2DeviceID
;;Outputs:
;;Changes: Resets PS2 Mouse, and enables IntelliMouse functions if there
;;         Re-Points PS2 (BIOS) Handler to our Code
;;------------------------------------------------------------------------------
;RePointPS2Handler:
;  PUSH AX,BX,DS              ;Save used registers
;  MOV  DS,ES                 ;Point DS at TSR Data Area
;  MOV  BX,PS2FarCall         ;Re-Point
;  MOV  AL,I15ALSetHandler    ;  PS2 (BIOS) at us
;  CALL DoPS2MouseFunction    ;Do it
;  MOV  BH,1                  ;SubFunction 1 (Enable)
;  MOV  AL,I15ALEnableDisable ;Function = Enable/Disable
;  CALL DoPS2MouseFunction    ;Do it
;H90:                         ;Done
;  POP  DS,BX,AX              ;Restore used registers
;  RET

;------------------------------------------------------------------------------
;SEND A REQUEST TO THE PS2 MOUSE (NOT THE USB MICE)
;Inputs:  DS = ES = TSR Data Area
;         AL = Function to call
;         Other registers (typically BH/BX) as needed for call
;         Int15Hdr.OldVector
;Outputs: Performs function for PS2 Mouse (not USB Mice)
;         Preserves AX, BX, CX, DX, and Flags across the call
;Changes:
;------------------------------------------------------------------------------
DoPS2MouseFunction:
  PUSH AX,BX,CX,DX          ;Save used registers
  PUSHF                     ;Save flags
  TEST B [DIPS2Offset].DIFlags,DIFlagInUse ;Is there a PS2 Mouse installed?
  JZ  >P90                  ;If not, quit
  MOV  AH,Int15PS2PortCall  ;Set correct value for AH
  PUSHF                     ;Do
  CALL D Int15Hdr.OldVector ;  it
P90:                        ;Done
  POPF                      ;Restore flags
  POP  DX,CX,BX,AX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE CURRENT STATUS BYTE
;Inputs:  DS = ES = TSR Data Area
;         Various Registers (mostly in Int14 Request)
;Outputs: BL = Current Status (as needed by Int 15h GetStatus Request)
;Changes:
;------------------------------------------------------------------------------
CalcStatus:
  PUSH AX                      ;Save used registers
  XOR  BL,BL                   ;Default = 0
  TEST TSRFlags,Int15Enabled   ;Enabled?
  JZ  >S10                     ;If not, continue
  OR   BL,StatusEnabled        ;If so, mark it as Enabled
S10:                           ;Test Buttons
  CALL GetAllRawBtns           ;Get combined Buttons Status (AL, 5 buttons)
S20:                           ;Test Left Button
  TEST AL,RawLBtn              ;Left Button pressed?
  JZ  >S30                     ;If not, continue
  OR   BL,StatusLBtn           ;If so, mark it as pressed
S30:                           ;Test Right Button
  TEST AL,RawRBtn              ;Right Button pressed?
  JZ  >S40                     ;If not, continue
  OR   BL,StatusRBtn           ;If so, mark it as pressed
S40:                           ;Test Center Button
  TEST AL,RawCBtn              ;Center Buton pressed?
  JZ  >S50                     ;If not, continue
  OR   BL,StatusCBtn           ;If so, mark it as pressed
S50:                           ;Test Scaling
  TEST TSRFlags,ScalingFactor2 ;Scaling Factor at 2:1?
  JZ  >S60                     ;If not, continue
  OR   BL,StatusScaling2       ;If so, mark as 2:1 Scaling
S60:                           ;Test Stream/Remote Mode
                               ;Mode Always Stream!
S90:                           ;Done
  POP  AX                      ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE CURRENT SAMPLE RATE
;Inputs:  DS = ES = TSR Data Area
;         Periodicity contains last Periodicity rate set
;Outputs: DL = Sample Rate (Reports/Second)
;Changes:
;------------------------------------------------------------------------------
CalcSampleRate:
  PUSH AX,BX               ;Save used registers
  MOV  AL,SampleRateCode   ;Get current Sample Rate Code
S10:                       ;Test for 100
  CMP  AL,SampleCode100    ;Is it 100 or 200 (if so, we're really 80)?
  JB  >S40                 ;If not, just use the table
  JA  >S20                 ;If 200, jump to handle it
  MOV  BL,100              ;Tell the user it's 100
  JMP >S80                 ;Done
S20:                       ;It's 200
  MOV  BL,200              ;If so, tell the user it's 200
  JMP >S80                 ;Done
S40:                       ;Convert Code using the Table
  MOV  BX,SampleRateTable  ;Convert the Code
  CALL SearchByteToWordTbl ;  to an Interrupt Rate
S80:                       ;BL contains Sampel Rate
  MOV  DL,BL               ;Put it in DL for the Return
  POP  BX,AX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE CURRENT IDLE RATE FACTOR TO USE
;Inputs:  DS = ES = TSR Data Area
;         SampleRateCode
;Outputs: AL = Idle Rate to set Device to
;         (Periodicity = 2+4*IdleRate)
;Changes:
;------------------------------------------------------------------------------
CalcIdleRate:
  PUSH BX              ;Save used registers
  MOV  BH,AH           ;Save AH
  CALL CalcPeriodicity ;Get Periodicity (AL)
I20:                   ;Periodicity >= 10
  SUB  AL,2            ;Subtract 2
  SHR  AL,1            ;Divide
  SHR  AL,1            ;  by 4
  MOV  AH,BH           ;Restore AH
  POP  BX              ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE CURRENT PERIODICITY FACTOR TO USE
;Inputs:  DS = ES = TSR Data Area
;         SampleRateCode
;Outputs: AX = Periodicity
;Changes:
;------------------------------------------------------------------------------
CalcPeriodicity:
  PUSH BX                  ;Save used registers
  MOV  AL,SampleRateCode   ;Get current Sample Rate Code
  MOV  BX,SampleRateTable  ;Convert the Code
  CALL SearchByteToWordTbl ;  to an Interrupt Rate
  MOV  AL,BH               ;Put Periodicity
  XOR  AH,AH               ;  in AX
  POP  BX                  ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CHANGE THE SAMPLE RATE TO A NEW PERIODICITY
;Inputs:  DS = ES = TSR Data Area
;         BL = New Periodicity to use
;Outputs:
;Changes: Modifies Interrupt Periodicity (for all mice)
;         Modifies Idle Rate of Device (for all mice)
;NOTES: Thos does NOT change anything on the PS2 Mouse, only on the USB Mice.
;------------------------------------------------------------------------------
ChangePeriodicity:
  PUSH AX,BX,CX,DI,SI                          ;Save used registers
  MOV  SI,Int14Request2                        ;Point at Request Structure
  MOV  [SI].I14REndPoint,0                     ;End Point 0
  XOR  BH,BH                                   ;Store Periodicity
  MOV  [SI].I14RPeriodicity,BX                 ;  in Request
  MOV  CX,SetHIDIdleReq                        ;Point at Idle Request Struc
  CALL CopySetupReqToInt14SI                   ;Copy Setup Pkt (CX)
  MOV  CL,2                                    ;Calculate Idle Rate
  SUB  BL,CL                                   ;Calculate Idle Rate to use
  SHR  BL,CL                                   ;  (2ms + 4 * this number)
  MOV  B [SI].I14RSetHIDIdleDuration,BL        ;Store it in the Request
  MOV  W [SI].I14RCallBackAddr[0],-1           ;Do nothing when done
  MOV  CX,MaxDevices                           ;Number of Table Entries
  MOV  DI,DeviceInfoTable                      ;Point at Table
P10:                                           ;Loop to here for each Table Entry
  TEST [DI].DIFlags,DIFlagInUse                ;Valid Table Entry?
  JZ  >P50                                     ;If not, skip it
  MOV  AX,W [DI].DIHostIndex                   ;Copy the Host Index
  MOV  W [SI].I14RHostIndex,AX                 ;  and Device Address
  MOV  AX,[DI].DIIntHandle                     ;Copy the
  MOV  [SI].I14RRequestHandle,AX               ;  Interrupt Handle Number
  MOV  AL,[DI].DIInterfaceNum                  ;Copy the
  MOV  B [SI].I14RSetHIDIdleIntf,AL            ;  Interface Number
  MOV  AL,[DI].DIReportID                      ;Copy the Report ID
  MOV  B [SI].I14RSetHIDIdleRptID,AL           ;  (will be 0 if no ID's used)
  MOV  [SI].I14RRequestType,I14RRTChangeIntPer ;Request = Change Periodicity
  CALL DoInt14CallSaveAllSI                    ;Do it
  MOV  [SI].I14RRequestType,I14RRTDoControl    ;Type = Control
  CALL DoInt14CallSaveAllSI                    ;Do it
P50:                                           ;Done with this Table Entry
  ADD  DI,DeviceInfoStrucSize                  ;Point at next Table Entry
  LOOP P10                                     ;Keep going until we're done
  POP  SI,DI,CX,BX,AX                          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;RESET MOVEMENT AND BUTTON VALUES TO 0
;Inputs:  DS = ES = TSR Data Area
;Outputs: XTotal, YTotal
;Changes:
;------------------------------------------------------------------------------
ResetTotals:
  PUSH AX,CX,DI               ;Save used registers
  XOR  AX,AX                  ;Reset to zeroes
  MOV  CX,(MaxDevices+1)      ;Number of Table entries to do
  MOV  DI,DeviceInfoTable     ;Point at Table
R10:                          ;Loop to here for each table entry
  MOV  W [DI].DIXRemainder,AX ;Reset Remainders
  MOV  W [DI].DIRawData[0],AX ;Reset
  MOV  W [DI].DIRawData[2],AX ;  All
  MOV  W [DI].DIRawData[4],AX ;  Raw
  MOV  W [DI].DIRawData[6],AX ;  Data
  ADD  DI,DeviceInfoStrucSize ;Point at next entry
  LOOP R10                    ;Keep going
  POP  DI,CX,AX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;SEARCH A BYTE-TO-WORD LOOKUP TABLE FOR A MATCH
;Inputs:  ES:[BX] = Table to search
;         AL      = Byte to search for
;Outputs: CF = Clear if a byte match as found in table
;              BX = Word from Table
;            = Set if no match found in table
;              BX = unchanged
;Changes: Last Entry in Table (end-of-table marker) = DB -1, DW -1
;------------------------------------------------------------------------------
SearchByteToWordTbl:
  PUSH AX,SI,DS  ;Save used registers
  CLD            ;Go forward with string functions
  MOV  DS,ES     ;Point DS at correct data area
  MOV  SI,BX     ;Put pointer in SI
  MOV  AH,AL     ;Put byte to check in AH
B10:             ;Loop to here for each table entry
  LODSB          ;Get the next table entry
  CMP  AL,-1     ;Is it possibly the end of the table?
  JNE >B20       ;If not, continue
  CMP  W [SI],-1 ;Is it actually the end of the table?
  JE  >B70       ;If so, there's no match
B20:             ;Not end of table
  CMP  AL,AH     ;Is it a match?
  JE  >B80       ;If so, handle it!
  INC  SI,2      ;If not, skip over this table entry
  JMP  B10       ;And keep looking
B70:             ;No entry found
  STC            ;Set the not found flag
  JMP >B90       ;Quit
B80:             ;Entry found [SI]
  MOV  BX,[SI]   ;Point BX at the table entry
  CLC            ;Set the found flag
B90:             ;Done
  POP  DS,SI,AX  ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE INT 08h (Timer Tick)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HAVE INTERRUPT 08 (TIMER) RUN THIS EVERY TIME IT OCCURS
;Inputs:
;Outputs: Searches for Newly attached Device
;Changes:
;NOTES: In theory, we shouldn't even need to do this since we are registering
;         and will be notified automatically if a new Device is attached.
;       We will do this just in case we miss it or are busy for some reason.
;------------------------------------------------------------------------------
Int08Hdr:
  DB TYPE IntHdr DUP (0) ;Header for removable interrupt vector code

Int08:
  PUSHF                          ;Process the
  CALL D CS:Int08Hdr.OldVector   ;  Old Interrupt Handler
  STI                            ;Enable interrupts
  CLD                            ;Go forward with string functions
  CALL MakeStack                 ;Set up our own Stack Space
  PUSH BX,DI,SI,DS,ES            ;Save used registers
  MOV  DS,CS                     ;Point DS and
  MOV  ES,CS                     ;  ES at our data area
  CALL EnableIRQ8                ;Enable IRQ 8 (CMOS Timer)
  CALL EnableInt70               ;Enable INT 70h (CMOS Timer)
  ;CALL DoIntelliTimer            ;Count down the IntelliMouse Timer
  MOV  BX,OFFSET TSRFlags2       ;Point [BX] at TSRFlags2
  TEST B [BX],Int08InUse         ;Still processing the previous IRQ?
  JNZ >E95                       ;If so, quit
  OR   B [BX],Int08InUse         ;If not, mark as processing
E10:                             ;OK to process
  MOV  DI,OFFSET Int08Counter    ;Point DI at Int08Counter
  MOV  SI,OFFSET DontLookCounter ;Point BX at DontLookCounter
  CMP  W [SI],0                  ;Need to Decrement DontLookCounter?
  JE  >E20                       ;If not, continue
  DEC  W [SI]                    ;If so, Decrement it
  JNZ >E90                       ;If not 0 yet, quit
  CMP  B [DI],0                  ;Disabled?
  JE  >E90                       ;If so, quit
  MOV  B [DI],1                  ;If not, look for Device right away
E20:                             ;Done with DontLookCounter
  CMP  B [DI],0                  ;Are we supposed to look yet?
  JE  >E90                       ;If not, just quit
  DEC  B [DI]                    ;Decrement the Delay Counter
  JNZ >E90                       ;If not 0 yet, quit
  MOV  B [DI],182                ;If 0, reset for next time (approx 10 seconds)
  PUSH AX,BX,CX,DX,BP            ;Save used registers
  CALL LookForNewDevice          ;Look for a new Device
  POP  BP,DX,CX,BX,AX            ;Restore used registers
E90:                             ;Done, mark as not processing any more
  AND  B [BX],(NOT Int08InUse)   ;Mark as done processing
E95:                             ;Done
  POP  ES,DS,SI,DI,BX            ;Restore used registers
  CALL ReturnStack               ;Restore Original Stack Space
  IRET

;;------------------------------------------------------------------------------
;;COUNTDOWN THE INTELLIMOUSE COUNTDOWN TIMER, IF NECESSARY
;;Inputs:  DS = ES = TSR Data Area
;;         IntelliTimer
;;Outputs: IntelliTimer
;;         EnableWheelCounter, EnableWheelCounter2
;;Changes:
;;------------------------------------------------------------------------------
;DoIntelliTimer:
;  CMP  IntelliTimer,0         ;Do we need to do anything?
;  JE  >I90                    ;If not, quit
;  DEC  IntelliTimer           ;If so, decrement by 1
;  JNZ >I90                    ;If not 0 yet, we're done
;  MOV  W EnableWheelCounter,0 ;If timed out, reset tracking Counters
;I90:                          ;Done
;  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE INT 70h (CMOS Delay Timer)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;;------------------------------------------------------------------------------
;;STARTS THE EVENT WAIT INTERVAL (INT 70h's DON'T GET ISSUED OTHERWISE)
;;Inputs:  DS = ES = TSR Data Area
;;Outputs: CF = Set if error or function already busy
;;            = Clear if it worked (or nothing to type)
;;Changes: Starts the Event Wait Handler (allows Int 70h to occur)
;;         Int 70h will enable high bit of CS:ChangeThisByte)
;;------------------------------------------------------------------------------
;StartEvent:
;  PUSH AX,BX,CX,DX       ;Save used registers
;  XOR  CX,CX             ;CX:DX = number of microseconds
;  MOV  DX,950            ;  to delay
;  MOV  BX,ChangeThisByte ;Event Wait Handler will set the high bit of
;                         ;  ES:[BX] when the delay is over
;  MOV  B [BX],0          ;Make sure ChangeThisByte is 0 when we start
;  MOV  AX,8300h          ;Function 83h, subfun 00h (Set Event Interval)
;  INT  15h               ;Do it
;  POP  DX,CX,BX,AX       ;Restore used registers
;  RET

;------------------------------------------------------------------------------
;HAVE INTERRUPT 70h (RTC Interrupt) RUN THIS PROGRAM WHEN IT OCCURS
;Inputs:
;Outputs:
;Changes: Types all the keys in our Buffer
;------------------------------------------------------------------------------
Int70Hdr:
  DB TYPE IntHdr DUP (0) ;Header for removable interrupt vector code

Int70:
  CALL MakeStack                   ;Create our own stack space
  PUSH AX,BX,DS,ES                 ;Save used registers
  MOV  DS,CS                       ;Point DS
  MOV  ES,CS                       ;  and ES at our data area
  STI                              ;Enable interrupts
  CMP  W Int70Hdr.OldVector[2],0   ;Is the Old Vector Valid?
  JE  >S20                         ;If not, handle it
  CMP  W Int70Hdr.OldVector[2],70h ;Is the Old Vector DOS (FreeDOS bug)?
  JE  >S20                         ;If not, handle it
  PUSHF                            ;Call the Old Interrupt Vector
  CALL D Int70Hdr.OldVector        ;  (this will issue the End-of-Interrupt)
  JMP >S40                         ;Continue
S20:                               ;Old Vector is invalid
  CALL IssueEOI2                   ;Issue End-of-Interrupt
S40:                               ;Done handling End-of-Interrupt
  MOV  BX,OFFSET TSRFlags2         ;Point [BX] at TSRFlags2
  TEST B [BX],Int70InUse           ;Still processing the last IRQ?
  JNZ >S90                         ;If so, quit
  OR   B [BX],Int70InUse           ;If not, mark as processing
  CALL SendCodes                   ;Send the Codes
  CALL EnableIRQ8                  ;Make sure IRQ 8 remains enabled in PIC
  CALL EnableInt70                 ;Make sure Int 70h remains enabled in CMOS
  AND  B [BX],(NOT Int70InUse)     ;Mark as done processing
S90:                               ;Done
  POP  ES,DS,BX,AX                 ;Restore used registers
  CALL ReturnStack                 ;Restore original Stack Space
  IRET

;------------------------------------------------------------------------------
;ISSUE AN END-OF-INTERRUPT SIGNAL TO THE PICs FOR AN IRQ ON THE SECOND PIC
;Inputs:
;Outputs:
;Changes: Issues End-of-Interrupt Signal for an IRQ on the second PIC
;------------------------------------------------------------------------------
IssueEOI2:
  PUSH AX                                   ;Save used registers
  PUSHF                                     ;Save flags
  CLI                                       ;Disable interrupts
  MOV  AL,OCW2SelectOCW2+OCW2NonSpecificEOI ;Non-specific EOI
  OUT  PIC2Addr,AL                          ;Send to PIC 2
  MOV  AL,OCW3SelectOCW3+OCW3ReadISR        ;Get the
  OUT  PIC2Addr,AL                          ;  Interrupt In-Service Register
  MOV  AX,AX                                ;  from
  IN   AL,PIC2Addr                          ;  PIC 2
  OR   AL,AL                                ;Other Ints still being serviced?
  JNZ >P90                                  ;If so, don't reset PIC 1 yet
  MOV  AL,OCW2SelectOCW2+OCW2NonSpecificEOI ;If not, Non-specific EOI
  OUT  PIC1Addr,AL                          ;Send to PIC 1
P90:                                        ;Done
  POPF                                      ;Restore flags
  POP  AX                                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;ENABLE IRQ 8 (INT 70h)
;Inputs:
;Outputs:
;Changes: Makes sure IRQ 8 (INT 70h) is Enabled
;NOTES: We need to call this after every call to INT 70h, since many BIOSes
;       will Disable it (the Periodic Interrupt) when they are called.
;------------------------------------------------------------------------------
EnableIRQ8:
  PUSH AX              ;Save used registers
  PUSHF                ;Save flags
  CLI                  ;Disable Interrupts
  IN   AL,(PIC2Addr+1) ;Get the PIC2 IRQ Mask
  AND  AL,(NOT 01h)    ;Enable IRQ8
  OUT  (PIC2Addr+1),AL ;  (Int 70h)
  POPF                 ;Restore Flags
  POP  AX              ;Restore used registers
  RET

;------------------------------------------------------------------------------
;ENABLE INT 70h PERIODIC INTERRUPT, IF APPOPRIATE
;Inputs:  ES:CPUClass
;Outputs:
;Changes: Int 70 Frequency Divider & Periodic Interrupt Flag
;------------------------------------------------------------------------------
EnableInt70:
  PUSH AX             ;Save used registers
  MOV  AH,CMOSPortA   ;Get the current
  CALL GetCMOS        ;  frequency divider
  CMP  AL,Period1024  ;Is it 1024Hz?
  JE  >E30            ;If so, test the periodic interrupt flag
  MOV  AL,Period1024  ;If not, set it
  CALL SetCMOS        ;  to 1024Hz
E30:                  ;Enable periodic interrupt flag
  MOV  AH,CMOSPortB   ;Get the current
  CALL GetCMOS        ;  Periodic Interrupt status
  TEST AL,PeriodicInt ;Periodic Interrupts already enabled?
  JNZ >E80            ;If so, we're done
  OR   AL,PeriodicInt ;If not,
  CALL SetCMOS        ;  Enable Periodic Interrupt
E80:                  ;Done changing CMOS
  CALL FinishCMOS     ;Clean up the CMOS data so Int's are reissued
E90:                  ;We're done
  POP  AX             ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CLEAN UP THE CMOS AFTER AN INT 70 IS ISSUED SO IT CAN GET ISSUED AGAIN
;Inputs:
;Outputs:
;Changes: "Resets" CMOS IRQ 08 Stuff
;NOTES: I ran across some documentation (thanks to a SLOWDOWN user) that says
;         after an IRQ 08/Int 70h occurs, CMOS Port C must be read or Periodic
;         Interrupts won't be re-issued (this supposedly tells the CMOS that
;         the Interrupt processing is complete).  The documentation also
;         stated that after done messing with the CMOS, you should leave the
;         CMOS pointed at CMOS Port D.  There was never a specific, practical
;         reason stated for doing this, but I guess is just good practice.
;         This little subroutine simply reads CMOS ports C & D, but doesn't
;         do anything with the data.
;       The documentation also stated that one should disable NMI while
;         messing with the CMOS.  The reason stated for this was that if the
;         NMI caused a reboot, and you were in the middle of changing
;         something in the CMOS, the computer could reboot to an unknown
;         state.  This is because the CMOS retains its state even through a
;         reboot.  While booting, most computers do not reset the CMOS to
;         a known state, because the CMOS contains things like the Date & Time
;         and BIOS configuration items.
;       Well, what we're changing here, even though it is in the CMOS, is
;         reset at reboot.  All we do to the CMOS is set the Periodic Interrupt
;         rate to 1024Hz (which is what it's supposed to be after a reboot)
;         and Enable (allow) the Periodic Interrupts to occur (which is
;         also supposed to be reset after a reboot, even if nothing else is).
;       Because Disabling NMI is a little bit cumbersome to do, and because
;         it really doesn't do anything useful anyway, we won't worry about
;         it!!
;------------------------------------------------------------------------------
FinishCMOS:
  PUSH AX           ;Save used registers
  MOV  AH,CMOSPortC ;Read Port C
  CALL GetCMOS      ;  (this supposedly allows Periodic Int's to keep happening)
  MOV  AH,CMOSPortD ;Read Port D
  CALL GetCMOS      ;  (this supposedly sets things to a "normalized" state)
  POP  AX           ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET A BYTE FROM THE CMOS
;Inputs:  AH = CMOS port number to get
;Outputs: AL = Byte from CMOS
;Changes:
;------------------------------------------------------------------------------
GetCMOS:
  PUSHF       ;Save flags
  CLI         ;Disable interrupts
  MOV  AL,AH  ;Put Port number in AL
  OUT  70h,AL ;Tell CMOS which port number we want
;  PUSH AX     ;Wait for
;  POP  AX     ;  output
  IN   AL,71h ;Get the byte from the CMOS
  POPF        ;Restore flags
  RET

;------------------------------------------------------------------------------
;SET A BYTE IN THE CMOS
;Inputs:  AH = CMOS port number to change
;         AL = What to change the CMOS byte to
;Outputs:
;Changes: Byte in CMOS
;------------------------------------------------------------------------------
SetCMOS:
  PUSHF       ;Save flags
  CLI         ;Disable interrupts
  XCHG AL,AH  ;Tell CMOS which
  OUT  70h,AL ;  port number we want
  XCHG AL,AH  ;Get what we want to change it to
  OUT  71h,AL ;Change the CMOS byte
  POPF        ;Restore flags
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE THE ORIGINAL (REAL) PS2 MOUSE BIOS SOFTWARE
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HANDLE THE PS2 FAR CALL (FROM THE ORIGINAL PS2 BIOS HANDLER)
;Inputs:
;Outputs:
;Changes: If appropriate, passes Far Call along to the Int 33h Handler
;           after modifying the data locations and "ORing" in the
;           buttons from the USB Mice
;------------------------------------------------------------------------------
PS2FarCall:
  PUSH BP                          ;Save used registers
  MOV  BP,SP                       ;Get Stack Pointer
                                   ;[BP+00] = Original BP
                                   ;[BP+02] = PS2 Far Call Return Addr
                                   ;[BP+06] = Stack Word 4 (Always 0)
                                   ;[BP+08] = Stack Word 3 (Y, Z if Wheel)
                                   ;[BP+10] = Stack Word 2 (X, Y if Wheel)
                                   ;[BP+12] = Stack Word 1 (Btns, & X if Wheel)
  PUSHA                            ;Save all registers
  PUSH DS,ES                       ;Save used registers
  MOV  DS,CS                       ;Point DS and
  MOV  ES,CS                       ;  ES at TSR Data Area
  MOV  BX,DIPS2Offset              ;Point at the PS2 Table Entry
  MOV  DI,12                       ;Point SS:[BP+DI] at buttons on stack
  MOV  AL,SS:[BP+DI]               ;Get the Buttons off the stack
  AND  AL,RawAll3Btns              ;Mask out unwanted bits
  CMP  [BX].DINumWheels,2          ;Are there any more buttons?
  JB  >F10                         ;If not, we're done with the buttons
  MOV  AH,SS:[BP+DI].StackZWheel   ;If so, get the Button Data
  AND  AH,30h                      ;Mask out everything but buttons 4 & 5
  SHR  AH,1                        ;Move it over so we can mask it in
  OR   AL,AH                       ;Mask it in
F10:                               ;AL contains button status
  MOV  [BX].DIBtnOffset,AL         ;Store the Buttons
  CMP  [BX].DINumWheels,0          ;Any Wheels?
  JA  >F20                         ;If so, jump to handle it
  MOV  AL,SS:[BP+DI].StackXNoWheel ;If not, put X Data in AL
  MOV  AH,SS:[BP+DI].StackYNoWheel ;  and Y Data in AH
  JMP >F30                         ;Continue
F20:                               ;Has at least one wheel
  MOV  AL,SS:[BP+DI].StackXWheel   ;Put X Data in AL
  MOV  AH,SS:[BP+DI].StackYWheel   ;  and Y Data in AH
F30:                               ;AL = X Data, AH = Y Data
  NEG  AH                          ;Make Y Data backwards
  MOV  W [BX].DIXDataPS2,AX        ;Store X & Y Data
  MOV  AL,SS:[BP+DI].StackZWheel   ;Get the Wheel Data
  XOR  AH,AH                       ;Start with Z2 Data at 0
  CMP  [BX].DINumWheels,1          ;How many wheels are there?
  JB  >F90                         ;If none, we're ready to send it
  JE  >F80                         ;If 1, it's OK to send it
F40:                               ;PS2 Mouse has 2 Wheels
  AND  AL,0Fh                      ;Mask out the buttons
  TEST AL,08h                      ;Is it Negative?
  JZ  >F45                         ;If not, continue
  OR   AL,0F0h                     ;If so, convert it to a byte
F45:                               ;Nibble converted to byte
  CMP  AL,1                        ;Is it 0, 1, or 2?
  JBE >F80                         ;If 0 or 1, it's OK like it is
  JG  >F60                         ;If 2, jump to handle it
  CMP  AL,-1                       ;Is it -2 or -1?
  JE  >F80                         ;If -1, it's OK like it is
F50:                               ;Z Data is -2
  MOV  AH,-1                       ;Mark Z2 as moved
  JMP >F70                         ;Continue
F60:                               ;Z Data is 2
  MOV  AH,1                        ;Mark Z2 as moved
F70:                               ;Need to make Z1 Data 0
  XOR  AL,AL                       ;Z1 = 0
F80:                               ;AX contains Wheels Data
  MOV  W [BX].DIZ1DataPS2,AX       ;Store the Wheels Data
  NEG  B [BX].DIZ1DataPS2          ;Make the Vertical Wheel
  ;NEG  B [BX].DIZ2Data             ;  Data backwards
F90:                               ;Data has been stored
  CALL DeviceChangeMouse           ;Do it
  POP  ES,DS                       ;Restore used registers
  POPA                             ;Restore all registers
  POP  BP                          ;Restore used registers
  RETF


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;STACK-RELATED FUNCTIONS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;CREATE/DELETE OUR OWN STACK
;Inputs:  CS = TSR Data Area
;         StackInUse
;Outputs: Interrupts Enabled
;Changes: SS,SP to/from our stack
;------------------------------------------------------------------------------
MakeStack:
  CLI                  ;Disable interrupts
  PUSHF                ;Save
  POP  CS:TempFlags    ;  Flags
  INC  CS:StackInUse   ;Increment number-of-calls counter
  CMP  CS:StackInUse,1 ;Is this the first call?
  JNE >M90             ;If not, the stack is already in use
  MOV  CS:TempBX,BX    ;  BX in memory
  POP  BX              ;Save MakeStack's return address in BX
  MOV  CS:OldSS,SS     ;Save original SS
  MOV  CS:OldSP,SP     ;Save original SP
  MOV  SP,CS           ;Put our CS
  MOV  SS,SP           ;  into SS
  MOV  SP,LastTSRByte  ;SP = Top of Stack
  PUSH BX              ;Restore MakeStack's return address to stack
  MOV  BX,CS:TempBX    ;Restore BX from memory
M90:                   ;Done
  PUSH CS:TempFlags    ;Restore
  POPF                 ;  Flags
  STI                  ;Enable interrupts
  RET

ReturnStack:
  CLI                ;Disable interrupts
  PUSHF              ;Save
  POP  CS:TempFlags  ;  Flags
  DEC  CS:StackInUse ;Decrement number-of-calls counter
  JNZ >R90           ;If sack is still in use, quit
  MOV  CS:TempBX,BX  ;Save BX in memory
  POP  BX            ;Save MakeStack's return address in BX
  MOV  SS,CS:OldSS   ;Restore original SS
  MOV  SP,CS:OldSP   ;Restore original SP
  PUSH BX            ;Restore MakeStack's return address to stack
  MOV  BX,CS:TempBX  ;Restore BX from memory
R90:                 ;Done
  PUSH CS:TempFlags  ;Restore
  POPF               ;  Flags
  STI                ;Enable interrupts
  RET


;;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;;DEBUGGING CODE - NOT NEEDED IN FINAL RELEASE OF PROGRAM!!!
;;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;
;;  VideoOffsetFirst EQU ((80*2*27)+(50*2)) ;Row 27, Column 50
;  VideoOffsetFirst EQU ((80*2*27)+(10*2)) ;Row 27, Column 10
;  VideoOffsetLast  EQU ((80*2)*50)        ;End of Screen (51st Row)
;
;  VideoOffset  DW VideoOffsetFirst ;Video Offset to use this time
;
;;Inputs: DS:DI = Buffer Entry Pointer
;WritePS2Buttons:
;  PUSH AX,DI,ES
;  PUSHF
;  CLD
;  CALL GetVideoOffset ;(ES:DI)
;  MOV  AL,PS2Buttons
;  CALL WriteALByte
;  POPF
;  POP  ES,DI,AX
;  RET
;
;WriteCL:
;  PUSH AX,DI,ES
;  PUSHF
;  CLD
;  CALL GetVideoOffset ;(ES:DI)
;  MOV  AL,CL
;  CALL WriteALByte
;  POPF
;  POP  ES,DI,AX
;  RET
;
;;WriteRawData:
;;  PUSH AX,CX,DI,SI,ES     ;Save used registers
;;  PUSHF                   ;Save flags
;;  CLD                     ;Go forward with string functions
;;  LEA  SI,[DI].DIRawData  ;Point SI at Raw Data
;;  CALL GetVideoOffset     ;Get video offset to use (ES:DI)
;;  MOV  CX,MaxKeybDataSize ;Number of bytes in buffer
;;B10:                      ;Loop to here for each byte in buffer
;;;  MOVSB                   ;Copy the character into video memory
;;  LODSB                   ;Write the
;;  CALL WriteALByte        ;  Buffer Contents
;;;  XOR  B ES:[DI],077h     ;Toggle the color
;;;  INC  DI                 ;Point at next character in video memory
;;  LOOP B10                ;Keep going until we're done
;;  POPF                    ;Restore flags
;;  POP  ES,SI,DI,CX,AX     ;Restore used registers
;;  RET
;
;
;;WriteAXBXCXDX:
;;  PUSH AX,DI,ES       ;Save used registers
;;  PUSHF               ;Save Flags
;;  CALL GetVideoOffset ;Get video offset to use (ES:DI)
;;  CALL WriteAXWord    ;Write AX
;;  MOV  AX,BX          ;Write
;;  CALL WriteAXWord    ;  BX
;;  MOV  AX,CX          ;Write
;;  CALL WriteAXWord    ;  CX
;;  MOV  AX,DX          ;Write
;;  CALL WriteAXWord    ;  DX
;;  POPF                ;Restore flags
;;  POP  ES,DI,AX       ;Restore used registers
;;  RET
;;
;;WriteAXWord:
;;  PUSH AX,CX         ;Save used registers
;;  MOV  CH,4          ;Need to write 4 characters
;;  MOV  CL,4          ;Need to shift 4 bits at a time
;;W30:                 ;Loop to here for each Nibble we write
;;  ROL  AX,CL         ;Put bits to write in low nibble
;;  CALL WriteNibbleC  ;Write the Nibble
;;  XOR  B ES:[DI],77h ;Toggle the Color
;;  INC  DI            ;Skip over the Attribute Byte
;;  DEC  CH            ;Decrement the Loop Counter
;;  JNZ  W30           ;If not 0 yet, keep writing
;;  MOV  AL,' '        ;Write a
;;  STOSB              ;  Space
;;  XOR  B ES:[DI],77h ;Toggle the Color
;;  INC  DI            ;Skip over the Attribute Byte
;;  POP  CX,AX         ;Restore used registers
;;  RET
;
;WriteALByte:
;  PUSH AX,CX         ;Save used registers
;  MOV  CH,2          ;Need to write 4 characters
;  MOV  CL,4          ;Need to shift 4 bits at a time
;W30:                 ;Loop to here for each Nibble we write
;  ROL  AL,CL         ;Put bits to write in low nibble
;  CALL WriteNibbleC  ;Write the Nibble
;  XOR  B ES:[DI],77h ;Toggle the Color
;  INC  DI            ;Skip over the Attribute Byte
;  DEC  CH            ;Decrement the Loop Counter
;  JNZ  W30           ;If not 0 yet, keep writing
;  MOV  AL,' '        ;Write a
;  STOSB              ;  Space
;  XOR  B ES:[DI],77h ;Toggle the Color
;  INC  DI            ;Skip over the Attribute Byte
;  POP  CX,AX         ;Restore used registers
;  RET
;
;WriteAX:
;  PUSH AX,CX,DI,ES    ;Save used registers
;  PUSHF               ;Save Flags
;  CALL GetVideoOffset ;Get video offset to use (ES:DI)
;  MOV  CH,4           ;Need to write 4 characters
;  MOV  CL,4           ;Need to shift 4 bits at a time
;F20:                  ;Loop to here for each Nibble we write
;  ROL  AX,CL          ;Put bits to write in low nibble
;  CALL WriteNibbleC   ;Write the Nibble
;  XOR  B ES:[DI],77h  ;Toggle the Color
;  INC  DI             ;Skip over the Attribute Byte
;  DEC  CH             ;Decrement the Loop Counter
;  JNZ  F20            ;If not 0 yet, keep writing
;  POPF                ;Restore flags
;  POP  ES,DI,CX,AX    ;Restore used registers
;  RET
;
;WriteNibbleC:
;  PUSH AX             ;Save used register
;  AND  AL,0Fh         ;Get rid of the high nibble
;  ADD  AL,'0'         ;Convert it to a number
;  CMP  AL,'9'         ;Should it be a number?
;  JBE >N90            ;If so, we're done
;  ADD  AL,('A'-'9'-1) ;If not, convert it to a letter
;N90:                  ;We're done
;  STOSB               ;Write it to the string
;  POP  AX             ;Restore used register
;  RET                 ;We're done
;
;;Outputs:  ES = 0B800h (Video Segment)
;;          [DI] = Video Offset to use
;GetVideoOffset:
;  MOV  DI,0B800h                       ;Point ES at
;  MOV  ES,DI                           ;  Video Memory
;  MOV  DI,CS:VideoOffset               ;Point at Video Offset we want to change
;  ADD  CS:VideoOffset,160              ;Go to next row for next time
;  CMP  CS:VideoOffset,VideoOffsetLast  ;Gone too far yet?
;  JB  >V90                             ;If not, we're done
;  MOV  CS:VideoOffset,VideoOffsetFirst ;If so, reset it to the top
;V90:                                   ;Video Offset updated for next time
;  RET
;
;  TRow EQU 20 ;Row to Toggle Color in (1-based)
;  TCol EQU  1 ;Column to Toggle Color in (1-based)
;
;ToggleColor:
;  PUSH BX,DS        ;Save used registers
;  PUSHF             ;Save Flags
;  MOV  BX,0B800h    ;Point DS at
;  MOV  DS,BX        ;  video memory
;  MOV  BX,((TRow-1)*160)+((TCol-1)*2)
;  INC  B [BX]       ;Change the character
;  XOR  B [BX+1],77h ;Toggle the Color
;  POPF              ;Restore flags
;  POP  DS,BX        ;Restore used registers
;  RET
;
;
;;WriteFrameNum:
;;  PUSHF                        ;Save Flags
;;  PUSH AX,CX,DX,DI,DS,ES       ;Save used registers
;;  MOV  DS,CS                   ;Point DS at Local data Area
;;  MOV  DI,Int14Request2        ;Point at Request Structure
;;  MOV  [DI].I14RRequestType,I14RRTGetHostStatus ;Get Host Status
;;  MOV  [DI].I14RHostIndex,15   ;Host Index 15
;;  MOV  DX,DI                   ;Do the Call
;;  CALL DoInt14CallCX           ;  (Returns CX = Current Frame Index)
;;  MOV  AX,CX                   ;Put Frame Nubmer in AX
;;  MOV  DI,0B800h               ;Point ES at
;;  MOV  ES,DI                   ;  Video Memory
;;  MOV  DI,4160                 ;Point at Character we want to change
;;  MOV  CH,4                    ;Need to write 4 characters
;;  MOV  CL,4                    ;Need to shift 4 bits at a time
;;F10:                           ;Loop to here for each Nibble we write
;;  ROL  AX,CL                   ;Put bits to write in low nibble
;;  CALL WriteNibbleC            ;Write the Nibble
;;  XOR  B ES:[DI],77h           ;Toggle the Color
;;  INC  DI                      ;Skip over the Attribute Byte
;;  DEC  CH                      ;Decrement the Loop Counter
;;  JNZ  F10                     ;If not 0 yet, keep writing
;;  POP  ES,DS,DI,DX,CX,AX       ;Restore used registers
;;  POPF                         ;Restore flags
;;  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SPACE FOR OUR TSR STACK
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

  EVEN 16
  DB (StackSize/8) DUP ('TSRStack')


LastTSRByte:


;ÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛ
;ÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛ


;ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
;DATA NEEDED TO INSTALL/UPDATE/SHOW STATUS (NOT NEEDED DIRECTLY IN TSR)
;ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ

;==============================================================================
;TSR Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Table of Interrupt Numbers that the TSR Intercepts
  ;First byte of each entry is the Interrupt Number
  ;Second word is the Pointer to our Interrupt Handler Code Header
  ;----------------------------------------------------------------------------
  IntNumTable:
    DB 70h       ;Real-time Clock
     DW Int70Hdr
    DB 2Fh       ;TSR Multiplex
     DW Int2FHdr
    DB 15h       ;BIOS Services
     DW Int15Hdr
    DB 11h       ;Get Equipment List
     DW Int11Hdr
    DB 08h       ;Timer Tick
     DW Int08Hdr
    DB 0         ;End of Table

  ;----------------------------------------------------------------------------
  ;Data needed to install as a TSR, Hooking into the Multiplex Int
  ;----------------------------------------------------------------------------
  FirstHandle DB 0 ;First available user handle for Int 2Fh


;==============================================================================
;Miscellaneous
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Miscellaneous Yes/No flags (individual bits)
  ;----------------------------------------------------------------------------
  ProgFlags        DB 00h ;Yes/No Test bits #1
    FoundSuptFile EQU 01h ;Found Support File in the Path
    Uninstall     EQU 02h ;Uninstall resident program?
    InMemory      EQU 04h ;Already installed in memory?
    UseLowMemory  EQU 08h ;User does not want us in High Memory
    MemoryMoved   EQU 10h ;TSR Memory has been moved by our Auto-Code
    PS2ResetDone  EQU 20h ;PS2 Mouse has already been reset at least once
    NoInstall     EQU 40h ;Don't Install as TSR

  ProgFlags2   DB 00h ;Yes/No Test bits #2
    Help      EQU 01h ;User wants help?
    DoEnvir   EQU 02h ;Parsing/Testing Environment variable
    DoStdIn   EQU 04h ;Parsing/Testing StdIn buffer
    Write2Err EQU 08h ;Write to ERR instead of Pause/CON

  StatusFlags    DB 00h ;Yes/No Test bits #2
    Report      EQU 01h ;Show HID Report Data
    Status      EQU 02h ;Show Status
    Descriptors EQU 04h ;Show Device/Config Descriptors Data
    Reset       EQU 08h ;Do a Hardware Reset
    BadDevices  EQU 10h ;Print Bad Device Table
    Alias       EQU 20h ;Write the Alias List to the Screen
    ErrLvl      EQU 40h ;Show ErrorLevel Table
    RawData     EQU 80h ;Show Raw Data

  ;----------------------------------------------------------------------------
  ;Miscellaneous Strings we need to write to the screen
  ;----------------------------------------------------------------------------
  HexString: DB '0000',0
  CrLfMsg:   DB CR,LF,0
  SingleMsg: DB ' '
  NoMsg:     DB 0
  Space4Msg: DB ' '
  Space3Msg: DB ' '
  Space2Msg: DB ' '
  SpaceMsg:  DB ' ',0

  ;----------------------------------------------------------------------------
  ;Data needed to test which hardware emulation method to use
  ;----------------------------------------------------------------------------
  TestByte DB -1


;==============================================================================
;Pause Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings and Data needed to Pause the screen
  ;----------------------------------------------------------------------------
  PauseMsg:
    DB CR,LF
    DB ' MORE   (Esc stops Pausing, Ctrl-C stops Completely, any other Continues)',CR,0
  PauseNMsg:
    DB ' MORE                                                                    ',CR,LF,0
  PauseDMsg:
    DB '                                                                               ',CR,0
  PauseRows       DW ? ;Number of rows per screen
  PauseHeaderPtr  DW 1 ;Pointer to Header Message (start with a fake one <> 0)
  PauseHeaderSize DW 2 ;Number of lines in the Header Message
  PauseRowCount   DW 2 ;Current Row Counter


;==============================================================================
;DOS Environment Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Variables to search for our Environment Variable
  ;----------------------------------------------------------------------------
  EnvVarString:  DB 'USBMOUSE='    ;Environment Variable String
  EnvVarSize    EQU $-EnvVarString ;Length of String
  EnvVarPointer  DW -1             ;Pointer to Program Environment Variable

  ;----------------------------------------------------------------------------
  ;Variables to search for an extended Command Line String
  ;This should only be valid/needed if the Command Line Size (PSP:[80h]) is 7Eh
  ;----------------------------------------------------------------------------
  CmdLineVarString:  DB 'CMDLINE='         ;Environment Variable String
  CmdLineVarSize    EQU $-CmdLineVarString ;Length of String
  CmdLineVarPointer  DW -1                 ;Pointer to Program Environment Variable


;==============================================================================
;EXEC Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Size of our program stack (in bytes)
  ;----------------------------------------------------------------------------
  ProgStackSize EQU 512

  ;----------------------------------------------------------------------------
  ;Variables to Locate and Run another Program (EXEC Child Program)
  ;----------------------------------------------------------------------------
  PathToUse:      DB MaxPathSize DUP (0) ;Path to Use
  OurPathPointer  DW -1                  ;Pointer to our Path String
  CurrentPath:    DB  0                  ;Current Path (Zero-Length ASCIIZ)
  PathVarPointer  DW -1                  ;Pointer to PATH Environment Variable
  SupportFile:    DB 'USBSUPT1.COM',0    ;Support File Name to Look for
  PathVarString1: DB 'PATH='             ;PATH Environment String Header (DOS)
  PathVarString2: DB 'Path='             ;PATH Environment String Header (NT?)
  PathVarSize    EQU $-PathVarString2    ;Length of String

  ;----------------------------------------------------------------------------
  ;Variables needed to do EXEC Call
  ;----------------------------------------------------------------------------
  CmdTailSize DB CmdTailMax-2           ;Length of command tail (Maximize it)
  CmdTail:    DB CmdTailMax DUP (CR)    ;Command Tail for EXEC Call
  ParamBlock: DB ParamBlockSize DUP (?) ;Parameter Block for EXEC Call
  FCB1:       DB FCBSize DUP (?)        ;File Control Block #1
  FCB2:       DB FCBSize DUP (?)        ;File Control Block #2
  OldSPExec   DW ?                      ;SP may be destroyed by EXEC Call

  ;----------------------------------------------------------------------------
  ;Strings needed to write Descriptor Header Information to the screen
  ;----------------------------------------------------------------------------
  HostIndexMsg:  DB 'USB HOST INDEX: ',0
  DvcAddressMsg: DB 'DEVICE ADDRESS: ',0

  ;----------------------------------------------------------------------------
  ;Strings needed to set up Command Tail for Exec Call
  ;----------------------------------------------------------------------------
  ReportDescrMsg:     DB 'ReportDescriptor '
  ReportDescrMsgAddr: DB 'xxxx:xxxx '
  ReportDescrCallBk:  DB 'xxxx:xxxx'
                      DB  0

  DescriptorMsg:     DB 'Descriptor '
  DescriptorMsgAddr: DB 'xxxx:xxxx '
  DescriptorMsgHost: DB 'xxh '
  DescriptorMsgDvc:  DB 'xxh '
  DescriptorCallBk:  DB 'xxxx:xxxx'
                     DB  0

  TDStatusMsg:    DB 'TDStatusCode '
  TDStatusCode:   DB 'xxxxh '
  TDStatusCallBk: DB 'xxxx:xxxx'
                  DB 0

  Int14ErrMsg:    DB 'Int14ErrorCode '
  Int14ErrCode:   DB 'xxxxh '
  Int14ErrCallBk: DB 'xxxx:xxxx'
                  DB 0

  ;----------------------------------------------------------------------------
  ;Error Message for when the Support File is not found
  ;----------------------------------------------------------------------------
  NoSuptFileMsg:
    DB 'Error! Need Support File ',0


;==============================================================================
;Help Screen Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Data needed if the User has changed the name of the program from USBMOUSE
  ;----------------------------------------------------------------------------
  RealName:
    DB 'USBMOUSE',0 ;Real name of our program (MUST end in 0)
                    ;  & MUST have enough space for 8-char name
  RealNameSz DW 8   ;Size of RealName (not incl 0)

  ;----------------------------------------------------------------------------
  ;Syntax Help String (if user asks for, or otherwise needs, Help)
  ;----------------------------------------------------------------------------
  SyntaxMsgHdr:
    DB 'SYNTAX: ',0
  SyntaxMsg:
    DB '[Options]',CR,LF
    DB LF
    DB '  /?      Í Show this HELP screen',CR,LF
    DB '  /A      Í Show all ALIASES for these command line Options',CR,LF
    DB '  /ErrLvl Í Show all ErrorLevels (DOS Return Codes)',CR,LF
    DB '  /U      Í UNINSTALL from memory',CR,LF
    DB '  /L:Y|N  Í Force installation into LOW memory (Default = No)',CR,LF
    DB LF
    DB '  /S   Í Display current STATUS of Program',CR,LF
    DB '  /C   Í Diplay CONFIGURATION (& other) descriptors of last mouse found',CR,LF
    DB '  /R   Í Show HID REPORT descriptor of last mouse found',CR,LF
    DB '  /Raw Í Display RAW Data from all mice',CR,LF
    DB LF
    DB '  /B        Í Show list of BAD (incompatible) mice found',CR,LF
    DB '  /Beep:Y|N Í BEEP Speaker when bad mouse is found (Default = Yes)',CR,LF
    DB LF
    DB '  /D:# Í DISABLE mouse index # (0-7, 8=PS2 Mouse)',CR,LF
    DB '  /E:# Í ENABLE mouse index # (0-7, 8=PS2 Mouse)',CR,LF
    DB '  /X:# Í eXCHANGE L/R Btns on Mouse Index # (0-7, 8=PS2 Mouse, 255=All)',CR,LF
    DB LF
    DB '  /BIOS:Y|N Í Use BIOS emulation (as opposed to hardware) (Default = Yes)',CR,LF
    DB '  /M:#      Í Hardware emulation METHOD (1-3, Default = Auto)',CR,LF
;    DB '  W:#      Í Number of WHEELS in hardware emulation (0-2, Default = 0)',CR,LF
    DB LF
    DB '  /Reset           Í RESET PS2 Mouse Hardware',CR,LF
    DB '  /Resolution:#    Í Change RESOLUTION to # Counts/mm (1,2,4,8)',CR,LF
    DB '  /SamplingRate:#  Í Change SAMPLING RATE to # Hz (10,20,40,60,80,100,200)',CR,LF
    DB '  /ScalingFactor:# Í Change SCALING FACTOR to #:1 (1,2)',CR,LF
    DB '  /I:Y|N           Í Install TSR into Memory (Default = Yes)'
    DB 0


;==============================================================================
;Program Status Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings needed to print the Status to the screen
  ;----------------------------------------------------------------------------
  NoMouseMsg:
    DB 'No USB or PS2 Mice are Currently Installed.',CR,LF,0
  StatusMsg1:
    DB '  COMBINED PS2/USB MOUSE STATUS             INDIVIDUAL MOUSE STATUSES',CR,LF
    DB '  ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ     ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB '  Int 33h Driver Enabled:    ',0
  StatusMsg2:
    DB                                 '     Idx Enbl Xchg Btns Wheels Host Addr Intf',CR,LF
    DB '  Wheel(s) Enabled:          ',0
  StatusMsg3:
    DB                                 '     ÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ',CR,LF
    DB '  Resolution (Counts/mm):    ',0
  StatusMsg4:
    DB '  Scaling Factor:            ',0
  StatusMsg5:
    DB '  Samples/Second:            ',0
  StatusMsg6:
    DB '  Exchange All L/R Buttons:  ',0
  Status1EndMsg:
    DB '  ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',0
  EmulationMsg:
    DB '  Emulation Level:      ',0
  MethodMsg:
    DB '  HW Emulation Method:       ',0
  Status2EndMsg:
    DB '                                     ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF,0

  YesMsg:         DB 'Yes',0
  NoMsgS:         DB ' No',0
  Scaling1Msg:    DB '1:1',0
  Scaling2Msg:    DB '2:1',0
  PS2Msg:         DB 'PS2',0
  BtnsUnknownMsg: DB '2~3',0
  Maybe2Msg:      DB ' 2?',0
  Maybe3Msg:      DB ' 3?',0
  Maybe5Msg:      DB ' 5?',0
  NAMsg:          DB ' na',0
  BIOSMsg:        DB '    BIOS',0
  HardwareMsg:    DB 'Hardware',0
  NoPS2Msg:       DB ' * No PS2 Mouse Installed *',0

  ;----------------------------------------------------------------------------
  ;Strings needed to handle NoInstall Option
  ;----------------------------------------------------------------------------
  NoResetMsg:
    DB CR,LF
    DB 'USBMOUSE did NOT Reset the PS/2 Mouse, since doing it',CR,LF
    DB '  could cause your DOS Mouse Driver to stop working.',CR,LF
    DB LF,0
  BIOSUpdateMsg:
    DB 'The appropriate requests have been sent to the PS/2 BIOS.'
  NoInstallMsg:
    DB CR,LF
    DB LF
    DB 'USBMOUSE has NOT been installed into memory.',0
  BIOSErrMsg:
    DB 'Could not locate a PS/2 Mouse.',CR,LF
    DB 'No Mouse Status is available.',0
  EnabledMsg:
    DB CR,LF,
    DB '     PS/2 MOUSE STATUS',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 'INT 33h Driver Enabled: ',0
  WheelsMsg:
    DB CR,LF
    DB 'Wheel(s) Enabled:       ',0
  ResolutionMsg:
    DB CR,LF
    DB 'Resolution (Counts/mm): ',0
  ScalingMsg:
    DB CR,LF
    DB 'Scaling Factor:         ',0
  SamplesMsg:
    DB CR,LF
    DB 'Samples/Second:         ',0


;==============================================================================
;Raw Mouse Data Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings and Data needed to print Raw Mouse Data to the screen
  ;----------------------------------------------------------------------------
  RawDataHdr:
    DB CR,LF
    DB 'Press any Key to Quit',CR,LF
    DB 'ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ',CR,LF
    DB '                                    RAW DATA',CR,LF
    DB '                   ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 'Mous Host Dvc Itf  Buttons  Byte Byte Byte Byte Byte Byte Byte',CR,LF
    DB 'Indx Indx Adr Num  LRC45678   2    3    4    5    6    7    8 ',CR,LF
    DB 'ÄÄÄÄ ÄÄÄÄ ÄÄÄ ÄÄÄ  ÄÄÄÄÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ ÄÄÄÄ',CR,LF
    DB (MaxDevices+1) DUP (LF)
    DB 0

  RawBtnMsg: DB 'LRC45678'

  VideoPage DB -1 ;Current Video Page


;==============================================================================
;Bad Device Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings needed to print Bad Device Table to the screen
  ;----------------------------------------------------------------------------
  BadDeviceHdr:
    DB '   BAD (INCOMPATIBLE) MICE',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB  LF
    DB 'HOST  DVC   INTF  STAGE  ERROR',CR,LF
    DB 'INDX  ADDR  NUM    NUM   CODE',CR,LF
    DB 'ÄÄÄÄ  ÄÄÄÄ  ÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄ',CR,LF
    DB  0

  NoneFoundMsg:
    DB '#ÄÄ#  #ÄÄ#  None  #ÄÄÄ# #ÄÄÄ#',CR,LF,0
  BadBeepMsg:
    DB 'Beep for Bad Mice: ',0


;==============================================================================
;ErrorLevel Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;ErrorLevels, and Table for ErrorLevel Description Strings
  ;----------------------------------------------------------------------------
  ErLvlOption   EQU  1 ;Bad Option on the command line
  ErLvlMemory   EQU  2 ;Memory problem with the computer
  ErLvlUninst   EQU  3 ;Not in memory yet, can't perform Request
  ErLvlVersion  EQU  4 ;Another version of the program already installed
  ErLvlDOSVer   EQU  5 ;DOS Version too old
  ErLvlStdIn    EQU  6 ;StdIn file too big
  ErLvlBadCPU   EQU  7 ;Incompatible CPU
  ErLvlNoHost   EQU  8 ;No USB Host Driver installed
  ErLvlHostInit EQU  9 ;Error while trying to initialize host request
  ErLvlNoData   EQU 10 ;No Report/Descriptor Data to Print
  ErLvlSuptFile EQU 11 ;Could not Find Support File
  ErLvlNoDevice EQU 12 ;No Devices installed, can't show Raw Data

  ErrLvlHdr:
    DB  CR,LF
    DB '                      ERRORLEVELS (DOS RETURN CODES)',CR,LF
    DB '  ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB '   0 No Error.',CR,LF
    DB 0

  ErrLvlTbl:
    DB ErLvlOption
       DB "Bad Command-line Option.",0
    DB ErLvlMemory
       DB "Memory problem with the computer.",0
    DB ErLvlUninst
       DB "USBMOUSE is not installed in memory yet -- can't perform Request.",0
    DB ErLvlVersion
       DB "A different version of USBMOUSE is already installed in memory.",0
    DB ErLvlDOSVer
       DB "DOS must be at least version 3.00.",0
    DB ErLvlStdIn
       DB "The Redirected Input Option File (USBMOUSE < InFile) is too big.",0
    DB ErLvlBadCPU
       DB "This program requires at least an 80286 CPU.",0
    DB ErLvlNoHost
       DB "Could not find a compatible USB Host Driver in memory.",0
    DB ErLvlHostInit
       DB "Could not properly initialize the USB Host Driver.",0
    DB ErLvlNoData
       DB "There is no Report or Configuration Descriptor data to write.",0
    DB ErLvlSuptFile
       DB "Could not find the required USBSUPT1.COM support file.",0
    DB ErLvlNoDevice
       DB "No Mouse is available to show the Raw Data for.",0
    DB -1,-1 ;End of Table


;==============================================================================
;Alias Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings needed to print Command Line Aliases to the screen
  ;----------------------------------------------------------------------------
  AliasHdrMsg:
    DB '                   ALIASES FOR COMMAND-LINE OPTIONS',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  YesNoHdrMsg:
    DB '       ALIASES FOR YES & NO',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  MouseIdxHdrMsg:
    DB ' ALIASES FOR MICE INDEXES',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  ;----------------------------------------------------------------------------
  ;Table needed to temporarily store Aliases.
  ;They are originally sorted in reverse alphabetical order.
  ;To write them in forward alphabetical order, we temporarily store
  ;  the String Pointers, in the original reverse order, in this table.
  ;  We then write the strings, starting with the last entry in this table
  ;  and moving backwards.
  ;The number of entries in this table must be AT LEAST as big as the largest
  ;  number of Aliases for a single command Option.  Most Options don't have
  ;  more than a dozen or so Aliases.
  ;----------------------------------------------------------------------------
  AliasSortTbl: DW 100 DUP (?) ;Table to store Alias Strings (to reverse order)


;==============================================================================
;Command-line (Parsing) Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Data needed to perform command-line configuration changes to the Driver
  ;----------------------------------------------------------------------------
  ResolutionValue DB -1 ;User wants to Change Resolution to this Value
  SamplingValue   DB -1 ;User wants to Change Sampling Rate to this Value
  ScalingValue    DB -1 ;User wants to Change Scaling to this Value

  ;----------------------------------------------------------------------------
  ;Extra Memory Segment (used to store compressed contents of STDIN)
  ;----------------------------------------------------------------------------
  ExtraMemSegment DW ?

  ;----------------------------------------------------------------------------
  ;Data needed to Parse the command line for Options
  ;----------------------------------------------------------------------------
  ParseTest  DB Yes ;Testing the command for errors?
  ParseError DB  No ;Error while Parsing Command Line?

  ;----------------------------------------------------------------------------
  ;Various Parsing-related messages we may need to print to the screen
  ;----------------------------------------------------------------------------
  ParseCmdMsg:
    DB 'Error in the command-line Options for USBMOUSE:',CR,LF,0
  ParseEnvMsg:
    DB 'Error in the Environment variable "USBMOUSE":',CR,LF,0
  ParseStdInMsg:
    DB 'Error in the redirected input file ("USBMOUSE < {FileName}"):',0
  ParseErrMsg:
    DB '^ Error',CR,LF,LF,0
  ParseEnvMsg2:
    DB 'Reset the Environment variable (type "SET USBMOUSE=") and then',CR,LF
  ParseErrMsg2:
    DB 'Type "USBMOUSE ?" for Help.',CR,LF,0
  StdInTooBigMsg:
    DB 'The redirected input file ("USBMOUSE < {FileName}") is too big!',CR,LF,0

  Copyright:
    DB "USBMOUSE 0.10, (C) 2007-2009, Bret E. Johnson.",CR,LF
    DB "DOS Driver for up to 8 Generic USB Mice.",CR,LF
    DB  LF,0
  EnvMsg:
    DB 'Environment: ',0
  InstallMsg1:
    DB 'USBMOUSE has been ',0
  InstallMsgAuto:
    DB 'automatically ',0
  InstallMsgHigh:
    DB 'installed into Upper Memory.',0
  InstallMsgHole:
    DB 'installed into a Low Memory "Hole".',0
  InstallMsgNorm:
    DB 'installed into Low Memory.',0
  InstallMsgLast:
    DB CR,LF
    DB 'Type "USBMOUSE U" to Uninstall USBMOUSE from memory.',CR,LF,0
  BadCPUMsg:
    DB 'This program requires at least an 80286 CPU.',0
  DOSVerMsg:
    DB 'You must be using DOS version 3.00 or later to use this program.',0
  NoHostMsg:
    DB 'There must be a compatible USB Host Driver installed in memory',CR,LF
    DB '  (something like USBUHCI.COM) before this program can be installed.',0
  HostInitErrMsg:
    DB 'There was an error while trying to initialize the USB Host.',0
  NoEnvironMsg:
