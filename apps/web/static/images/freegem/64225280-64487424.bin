;------------------------------------------------------------------------------
;UniCode Characters that Translate into a single ASCII Character
;  surrounded by Parentheses
;------------------------------------------------------------------------------
ParenCharTbl00:

  ;----------------------------------------------------------------------------
  ;Numbers
  ;----------------------------------------------------------------------------

  DW 024EAh ;Circled Digit Zero
  DW 024FFh ;Negative Circled Digit Zero
  DW    -1
  DB '0' ;(ParenCharTbl00)

  DW 02460h ;Circled Digit One
  DW 02474h ;Parenthesized Digit One
  DW 02776h ;Dingbat Negative Circled Digit One
  DW 02780h ;Dingbat Circled Sans-Serif Digit One
  DW 0278Ah ;Dingbat Negative Circled Sans-Serif Digit One
  DW    -1
  DB '1' ;(ParenCharTbl00)

  DW 02461h ;Circled Digit Two
  DW 02475h ;Parenthesized Digit Two
  DW 02777h ;Dingbat Negative Circled Digit Two
  DW 02781h ;Dingbat Circled Sans-Serif Digit Two
  DW 0278Bh ;Dingbat Negative Circled Sans-Serif Digit Two
  DW 03203h ;Parenthesized Hangul Rieul
  DW 03263h ;Circled Hangul Rieul
  DW    -1
  DB '2' ;(ParenCharTbl00)

  DW 02462h ;Circled Digit Three
  DW 02476h ;Parenthesized Digit Three
  DW 02778h ;Dingbat Negative Circled Digit Three
  DW 02782h ;Dingbat Circled Sans-Serif Digit Three
  DW 0278Ch ;Dingbat Negative Circled Sans-Serif Digit Three
  DW 0A2C1h ;Yi Syllable Cex
  DW 0A2C2h ;Yi Syllable Ce
  DW    -1
  DB '3' ;(ParenCharTbl00)

  DW 02463h ;Circled Digit Four
  DW 02477h ;Parenthesized Digit Four
  DW 02779h ;Dingbat Negative Circled Digit Four
  DW 02783h ;Dingbat Circled Sans-Serif Digit Four
  DW 0278Dh ;Dingbat Negative Circled Sans-Serif Digit Four
  DW    -1
  DB '4' ;(ParenCharTbl00)

  DW 02464h ;Circled Digit Five
  DW 02478h ;Parenthesized Digit Five
  DW 0277Ah ;Dingbat Negative Circled Digit Five
  DW 02784h ;Dingbat Circled Sans-Serif Digit Five
  DW 0278Eh ;Dingbat Negative Circled Sans-Serif Digit Five
  DW    -1
  DB '5' ;(ParenCharTbl00)

  DW 02465h ;Circled Digit Six
