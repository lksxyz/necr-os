    DB LF,0
  UninstallErrMsg:
    DB "Can't find USBKEYB in memory.",CR,LF
    DB 'You must install it before it can be Uninstalled.',0
  NoDeviceMsg:
    DB 'No USB Keyboard(s) are Currently Installed.',0
  UpdateMsg:
    DB 'Resident USBKEYB has been updated with new information.',0

