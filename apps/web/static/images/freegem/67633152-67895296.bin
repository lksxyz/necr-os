    DB 'Bad Device',0
  RawDataErrMsg:
    DB 'Raw Keyboard',0
  ReportErrMsg:
    DB 'Report '
  DescrErrMsg:
    DB 'Descriptor',0
  StatusErrMsg:
    DB 'Program Status',0
  DataErrMsg:
    DB ' Data is not available until after',CR,LF
    DB '  USBKEYB has been installed into memory.',0

