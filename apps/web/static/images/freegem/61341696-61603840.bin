diff -urN zlib-1.2.3\inflate.h zlib.123\inflate.h
--- zlib-1.2.3\inflate.h	Sat Nov 13 15:38:28 2004
+++ zlib.123\inflate.h	Fri Oct 14 12:14:38 2005
@@ -89,7 +89,7 @@
     unsigned wsize;             /* window size or zero if not using window */
