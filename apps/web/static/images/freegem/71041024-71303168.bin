;==============================================================================
;Various Status/Error Strings
;==============================================================================

  ParseCmdMsg:
    DB CR,LF
   #IF !LITE
    DB 'Error in the command-line Options for USBUHCI:',CR,LF,0
   #ELSE
    DB 'Error in the command-line Options for USBUHCIL:',CR,LF,0
   #ENDIF

  ParseEnvMsg:
    DB CR,LF
   #IF !LITE
    DB 'Error in the Environment variable "USBUHCI":',Cr,LF,0
   #ELSE
    DB 'Error in the Environment variable "USBUHCIL":',Cr,LF,0
   #ENDIF

  ParseStdInMsg:
    DB CR,LF
   #IF !LITE
    DB 'Error in the redirected input file ("USBUHCI < {FileName}"):',CR,LF,0
   #ELSE
    DB 'Error in the redirected input file ("USBUHCIL < {FileName}"):',CR,LF,0
   #ENDIF

  ParseErrMsg:
    DB '^ Error',CR,LF,LF,0

  ParseErrEnv:
   #IF !LITE
    DB 'Reset the Environment variable (type "SET USBUHCI=") and then',CR,LF,0
  ParseErrMsg2:
    DB 'Type "USBUHCI ?" for Help.',CR,LF,0
   #ELSE
    DB 'Reset the Environment variable (type "SET USBUHCIL=") and then',CR,LF,0
  ParseErrMsg2:
    DB 'Type "USBUHCIL ?" for Help.',CR,LF,0
   #ENDIF

  InitializingMsg1:
    DB 'Initializing Universal Host Controller #',0

  InitializingMsg2:
    DB '.  This may take several seconds...',CR,LF,LF,0

  EnvMsg:
    DB 'Environment: ',0

  InstallMsg1:
   #IF !LITE
    DB 'USBUHCI has been ',0
   #ELSE
    DB 'USBUHCIL has been ',0
   #ENDIF

  InstallMsgAuto:
    DB 'automatically ',0

  InstallMsgHigh:
    DB 'installed into Upper Memory.',0

  InstallMsgHole:
    DB 'installed into a Low Memory "Hole".',0

  InstallMsgNorm:
    DB 'installed into Low Memory.',0

  InstallMsgLast:
    DB CR,LF
   #IF !LITE
    DB 'Type "USBUHCI U" to Uninstall USBUHCI from memory.',CR,LF,0
   #ELSE
    DB 'Type "USBUHCIL U" to Uninstall USBUHCIL from memory.',CR,LF,0
   #ENDIF

  NotRealMsg:
    DB 'This program only works in Real DOS.',CR,LF
    DB LF
    DB 'The CPU must be running in Real Mode, or in Protected (V86) Mode with a',CR,LF
    DB '  VCPI-compliant Memory Manager (like EMM386).',CR,LF
    DB 'It will NOT run in a multi-tasking environment (like Windows).',0

  LegacyContMsg:
    DB CR,LF
    DB 'The USB Host Controller currently has "Legacy Support" enabled.',CR,LF
    DB 'This means that there is probably a USB Keyboard and/or a USB Mouse currently',CR,LF
    DB '  installed and enabled in the computer BIOS.',CR,LF
    DB LF
    DB 'If you continue installing this program, and do not also install the',CR,LF
    DB '  appropriate Keyboard and/or Mouse drivers, your computer may not function',CR,LF
    DB '  properly (if at all).',CR,LF
    DB LF
    DB 'Are you ABSOLUTELY SURE you want to continue installing this program (Y/N)? ',0

  AlreadyRunMsg:
    DB CR,LF
    DB 'Another program is currently controlling the USB Bus.',CR,LF
    DB 'If you continue with this installation, the other program will stop working.',CR,LF
    DB  LF
    DB 'Are you ABSOLUTELY SURE you want to continue with the installation (Y/N)? ',0

  TooManyHostsMsg:
    DB 'There are too many USB Host Drivers already installed in memory.',CR,LF
    DB 'You can only have a maximum of 16 USB Hosts running at the same time.',0

  NoEnvironMsg:
    DB 'There is no DOS Environment.',CR,LF
    DB 'There is something WIERD going on here!',0

  StdInMemoryMsg:
    DB 'There is not enough available memory to run this program!',0

  AssignIRQMsg:
    DB 'Assigned IRQ to USB Controller: ',0

  AssignIOMsg:
    DB 'Assigned Base I/O Address to USB Controller: ',0

  WrongVerMsg:
    DB 'An incompatible version of USB Driver was found in memory.',CR,LF
    DB 'Please UNINSTALL the other version before continuing.',0

  UninstallMsg:
   #IF !LITE
    DB 'USBUHCI has been Uninstalled from memory.',CR,LF
   #ELSE
    DB 'USBUHCIL has been Uninstalled from memory.',CR,LF
   #ENDIF
    DB LF
    DB 'If BIOS Legacy Support (for a USB Keyboard/Mouse) was turned on before',CR,LF
    DB '  you installed this program, and the Legacy Support includes',CR,LF
    DB '  "Plug-and-Play" operation, it should be working again now.',CR,LF
    DB 'You may need to unplug and reinsert the Keyboard/Mouse back into the',CR,LF
    DB '  USB Port to make sure it reinitializes properly, however.',0

  NoUninstallMsg:
   #IF !LITE
    DB 'Unable to Uninstall USBUHCI from memory, but the Host is Stopped.',CR,LF
   #ELSE
    DB 'Unable to Uninstall USBUHCIL from memory, but the Host is Stopped.',CR,LF
   #ENDIF
    DB "Remove any TSR's installed after this program and try again.",0

  NotFirstInstMsg:
   #IF !LITE
    DB 'There is currently more than one Instance of USBUHCI in Memory, and you are',CR,LF
    DB '  trying to Remove the First Instance.  The First Instance cannot be removed',CR,LF
    DB '  from Memory until all other Instances are removed.',CR,LF
    DB 'The Host is Stopped, but USBUHCI has NOT been removed from Memory.',CR,LF
    DB 'Remove any Instances of USBUHCI installed after this one and try again.',0
   #ELSE
    DB 'There is currently more than one Instance of USBUHCIL in Memory, and you are',CR,LF
    DB '  trying to Remove the First Instance.  The First Instance cannot be removed',CR,LF
    DB '  from Memory until all other Instances are removed.',CR,LF
    DB 'The Host is Stopped, but USBUHCIL has NOT been removed from Memory.',CR,LF
    DB 'Remove any Instances of USBUHCIL installed after this one and try again.',0
   #ENDIF

  SharedIRQMsg:
   #IF !LITE
    DB 'The IRQ being used by USBUHCI is being "shared" by another program',CR,LF,
    DB '  that was installed into memory after USBUHCI was.',CR,LF
   #ELSE
    DB 'The IRQ being used by USBUHCIL is being "shared" by another program',CR,LF,
    DB '  that was installed into memory after USBUHCIL was.',CR,LF
   #ENDIF
    DB 'Most likely, that other program is also a USB-related program.',CR,LF
    DB 'You will need to Uninstall the other program from memory first,',CR,LF
    DB '  and then come back and try to Uninstall this one again.',0

  Dvc0OwnerMsg:
   #IF !LITE
    DB 'There is currently at least one other USB-Related program installed in Memory',CR,LF
    DB '  that is Dependent on USBUHCI.  If you remove USBUHCI from Memory,',CR,LF
   #ELSE
    DB 'There is currently at least one other USB-Related program installed in Memory',CR,LF
    DB '  that is Dependent on USBUHCIL.  If you remove USBUHCIL from Memory,',CR,LF
   #ENDIF
    DB '  the other program may stop working correctly, or may even cause the',CR,LF
    DB '  computer to crash.',CR,LF
    DB 'Remove all other USB-related Programs from Memory and then try again.',0

  CantStopHostMsg:
    DB  LF
    DB 'Unable to Stop the Host Controller from running.',CR,LF
    DB 'Cannot continue with Uninstallation.',0

  UpdateMsg:
    DB  LF
   #IF !LITE
    DB 'Resident USBUHCI has been updated with new information.',0
   #ELSE
    DB 'Resident USBUHCIL has been updated with new information.',0
   #ENDIF

  NoStartMsg:
    DB 'The USB Host Controller failed to Initialize properly.',CR,LF
    DB 'Aborting Installation.',CR,LF
    DB 'This could be related to an invalid IRQ#.',0

  MoreLeftMsg:
    DB '<<-More}  ',0

  MoreRightMsg:
    DB '  {More->>',0

  ResetBadMsg:
    DB 'Resetting Bad Host-Device ',0

  NoBadsMsg:
    DB 'There are no Bad Devices to Reset on any of the Hosts!',0

  ErrorBadsMsg:
    DB '  ERROR!',0


