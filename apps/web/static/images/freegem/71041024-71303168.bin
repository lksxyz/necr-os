;NOTE: This program is written for and compiled with Eric Isaacson's A86
;      assembly language compiler, using Options +P0 -F (8086 CPU and
;      no FPU).
;==============================================================================

;==============================================================================
;NOTE: This is actually the source code for two different output files:
;        USBUHCI.OVL & USBUHCIL.OVL.
;      The various programs are compiled by using A86 invocation
;        variables on the command-line.
;      If the LITE invocation varliable is set, this will create USBUHCIL.OVL.
;      If LITE is not set, this will create USBUHCI.OVL.
;==============================================================================

;==============================================================================
;This is compiled into a Data File (USBUHCI{L}.OVL, which is
;  used by USBUHCI{L}.COM.  Those programs are getting too big
;  to fit into a single 64kB segment, so we are moving most of the strings
;  we write to this file.  Strings take up a LOT of room, so moving them
;  here will create more room for "real" code and data in the executable files.
;==============================================================================


  ORG 0 ;Compile as Binary File, not .COM Executable


;ﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂﬂ
;EQUATE/STRUCTURE/MACRO DEFINITIONS
;‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹‹

;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;EQUATES
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

  ;----------------------------------------------------------------------------
  ;Command Line Options with no single-character equivalents
  ;----------------------------------------------------------------------------
  OptionHostStatus    EQU  1 ;Host Status
  OptionFLStatus      EQU  2 ;Frame List Status
  OptionTDStatus      EQU  3 ;Transfer Descriptor Status
  OptionQHStatus      EQU  4 ;Queue Head Status
  OptionADStatus      EQU  5 ;Address Data Status
  OptionNDStatus      EQU  6 ;New Device Data Status
  OptionDescriptor    EQU  7 ;Show Descriptors from last Device
  OptionErrLvl        EQU  8 ;Write ErrorLevel Table

  OptionReset         EQU 10 ;Reset
  OptionSuspend       EQU 11 ;Suspend
  OptionResume        EQU 12 ;Resume
  OptionPwrOn         EQU 13 ;Power On
  OptionPwrOff        EQU 14 ;Power Off
  OptionPwrReset      EQU 15 ;Power Reset

  OptionResetBad      EQU 16 ;Reset all Bad Devices on All Hosts

  OptionDebug         EQU 17 ;Host Debug Mode
  OptionSingleStep    EQU 18 ;Host Single Step

  OptionTiming        EQU 20 ;Change Frame Timing

  OptionSetConfig     EQU 21 ;Set Device Configuration Value
  OPtionRmtWakeup     EQU 22 ;Change Remote Wakeup Setting
  OptionTestMode      EQU 23 ;Change Test Mode Setting

  OptionUserIO        EQU 25 ;User-assigned I/O Base Address
  OptionUserIRQ       EQU 26 ;User-assigned IRQ
  OptionDisableLegacy EQU 27 ;User OK'd us to Disable Legacy Support
  OptionDisableOther  EQU 28 ;User OK'd us to Disable Other Control Program
  OptionBeep          EQU 29 ;Beep Speaker when Bad Device is found
  OptionProgDebug     EQU 30 ;Display Program Debugging Strings

;  OptionTest          EQU 31


  ;----------------------------------------------------------------------------
  ;Transfer Descriptor Types
  ;----------------------------------------------------------------------------
  TDTypeAvailable      EQU  00h ;Available (Invalid/Empty TD)
  TDTypeReserved       EQU  01h ;Reserved, but not in use yet
  TDTypeIsoch          EQU  02h ;Isochronous
  TDTypeInterrupt1Time EQU  03h ;1-Time Interrupt
  TDTypeInterruptPer   EQU  04h ;Periodic Interrupt
  TDTypeControlSetup   EQU  05h ;Control Setup Packet
  TDTypeControlData    EQU  06h ;Control Data Packet
  TDTypeControlStatus  EQU  07h ;Control Status packet
  TDTypeBulk           EQU  08h ;Bulk

  ;----------------------------------------------------------------------------
  ;Transfer Descriptor Packet Type
  ;----------------------------------------------------------------------------
  TDPacketIn    EQU   69h ;Token for IN Packet
  TDPacketOut   EQU  0E1h ;Token for OUT Packet
  TDPacketSetup EQU   2Dh ;Token for SETUP Packet

  ;----------------------------------------------------------------------------
  ;Special ASCII Characters
  ;----------------------------------------------------------------------------
  LF  EQU 10 ;Line Feed
  CR  EQU 13 ;Carriage Return
  EOF EQU 26 ;End-of-File


;==============================================================================
;String Identifier Codes
;==============================================================================
  MinSID            EQU 0FF00h ;Minimum SID value Allowed
 ;---------------------
 ;Miscellaneous Strings
 ;---------------------
  SIDCrLf           EQU 0FF00h
  SIDYes2Msg        EQU 0FF01h
  SIDNo2Msg         EQU 0FF02h
  SIDSpace4         EQU 0FF03h
  SIDSpace3         EQU 0FF04h
  SIDSpace2         EQU 0FF05h
  SIDSpace          EQU 0FF06h
  SIDYesMsgY        EQU 0FF07h
  SIDNoMsgN         EQU 0FF08h
  SIDDblLine        EQU 0FF09h
  SIDNAMsg          EQU 0FF0Ah

  SIDPause          EQU 0FF10h
  SIDPauseN         EQU 0FF11h
  SIDPauseD         EQU 0FF12h
  SIDNoSuptFile     EQU 0FF13h
  SIDSyntax         EQU 0FF14h
  SIDFLHeader       EQU 0FF15h
  SIDEllipses       EQU 0FF16h
  SIDQHHeader       EQU 0FF17h
  SIDQHTypeCtl      EQU 0FF18h
  SIDQHTypeBulk     EQU 0FF19h
  SIDQHTypeInt      EQU 0FF1Ah

  SIDTDHeader0      EQU 0FF20h
  SIDTDHeader1      EQU 0FF21h
  SIDTDHeader2      EQU 0FF22h
  SIDTDTypeTbl      EQU 0FF23h
  SIDTDPktTypeTbl   EQU 0FF24h
  SIDTDPktTypeNA    EQU 0FF25h
  SIDOneTimeInt     EQU 0FF26h
  SIDPeriodicInt    EQU 0FF27h
  SIDBulk           EQU 0FF28h
  SIDIsoch          EQU 0FF29h
  SIDControl        EQU 0FF2Ah

  SIDSetupStage     EQU 0FF30h
  SIDDataStage      EQU 0FF31h
  SIDStatusStage    EQU 0FF32h
  SIDDvcNotYet      EQU 0FF33h
  SIDDvcAddr        EQU 0FF34h
  SIDDvcConfig      EQU 0FF35h
  SIDDvcNoMore      EQU 0FF36h
  SIDAliasHdr       EQU 0FF37h
  SIDParseCmd       EQU 0FF38h
  SIDParseEnv       EQU 0FF39h
  SIDParseStdIn     EQU 0FF3Ah

  SIDParseErr       EQU 0FF40h
  SIDParseErrEnv    EQU 0FF41h
  SIDParseErr2      EQU 0FF42h
  SIDInitializing1  EQU 0FF43h
  SIDInitializing2  EQU 0FF44h
  SIDEnvironment    EQU 0FF45h
  SIDInstall1       EQU 0FF46h
  SIDInstallAuto    EQU 0FF47h
  SIDInstallHigh    EQU 0FF48h
  SIDInstallHole    EQU 0FF49h
  SIDInstallNorm    EQU 0FF4Ah
  SIDInstallLast    EQU 0FF4Bh

  SIDDOSVer         EQU 0FF50h
  SIDNo386          EQU 0FF51h
  SIDNoPCI          EQU 0FF52h
  SIDNoUHCI         EQU 0FF53h
  SIDNotReal        EQU 0FF54h
  SIDLegacyCont     EQU 0FF55h
  SIDAlreadyRun     EQU 0FF56h
  SIDTooManyHosts   EQU 0FF57h
  SIDNoEnviron      EQU 0FF58h
  SIDStdInMemory    EQU 0FF59h
  SIDStdInTooBig    EQU 0FF5Ah

  SIDAssignIRQ      EQU 0FF60h
  SIDAssignIO       EQU 0FF61h
  SIDWrongVer       EQU 0FF62h
  SIDUninstall      EQU 0FF63h
  SIDNoUninstall    EQU 0FF64h
  SIDNotFirstInst   EQU 0FF65h
  SIDSharedIRQ      EQU 0FF66h
  SIDDvc0Owner      EQU 0FF67h
  SIDNotInMem       EQU 0FF68h
  SIDCantStopHost   EQU 0FF69h
  SIDUpdate         EQU 0FF6Ah
  SIDNoStart        EQU 0FF6Bh
  SIDInternalErr    EQU 0FF6Ch

  SIDMoreLeft       EQU 0FF70h
  SIDMoreRight      EQU 0FF71h
  SIDSwitchList     EQU 0FF72h
  SIDSwitchList2    EQU 0FF73h
  SIDSwitchListYN   EQU 0FF74h
  SIDErrLvlHdr      EQU 0FF75h
  SIDErrLvlTbl      EQU 0FF76h
 ;---------------
 ;Debugging Codes
 ;---------------
  SIDProgDebug      EQU 0FF80h
  SIDBusDevFunc     EQU 0FF81h
  SIDPCISearchIdx   EQU 0FF82h
  SIDIRQNumber      EQU 0FF83h
  SIDBaseIO         EQU 0FF84h
  SIDFrameListAddr  EQU 0FF85h
  SIDStopHost       EQU 0FF86h
  SIDEnBusMaster    EQU 0FF87h
  SIDDisSMIFlags    EQU 0FF88h
  SIDEnResumeDet    EQU 0FF89h
  SIDRedirGenInts   EQU 0FF8Ah
  SIDRedirUSBInt    EQU 0FF8Bh

  SIDResetHost      EQU 0FF90h
  SIDSetFLAddress   EQU 0FF91h
  SIDFrameTiming    EQU 0FF92h
  SIDStartFrame     EQU 0FF93h
  SIDEnIRQFlags     EQU 0FF94h
  SIDDisSMIGen      EQU 0FF95h
  SIDEnIRQGen       EQU 0FF96h
  SIDStartHost      EQU 0FF97h
  SIDVerifyHost     EQU 0FF98h
  SIDInitRootHub    EQU 0FF99h
  SIDVerifyIRQ      EQU 0FF9Ah
 ;-------------------------
 ;Uninstall Debugging Codes
 ;-------------------------
  SIDRestoreUSBInt  EQU 0FFA0h
  SIDRestorePort1   EQU 0FFA1h
  SIDRestorePort2   EQU 0FFA2h
  SIDEnSMIFlags     EQU 0FFA3h
  SIDEnSMIGen       EQU 0FFA4h
  SIDRestoreIRQ     EQU 0FFA5h
  SIDRestorePCI     EQU 0FFA6h
  SIDRestoreGenInts EQU 0FFA7h
 ;-----------------
 ;Reset Bad Devices
 ;-----------------
  SIDResetBad       EQU 0FFB0h
  SIDNoBads         EQU 0FFB1h
  SIDErrorBads      EQU 0FFB2h
 ;-------------------------
 ;Report Descriptor Strings
 ;-------------------------
  SIDRptNoDvc0      EQU 0FFC0h
  SIDRptNoDvc1      EQU 0FFC1h
  SIDRptNoDvc2      EQU 0FFC2h
  SIDRptNoData      EQU 0FFC3h
 ;----------------------
 ;Downloaded Descriptors
 ;----------------------
  SIDDescrNoDvc     EQU 0FFD0h
  SIDDescrNoData    EQU 0FFD1h


;==============================================================================
;Signature String & Version
;  MUST be at offset 0 in file!!
;==============================================================================
OvlSignature:
  DB 'USBUHCI'
 #IF LITE
  DB 'L'
 #ENDIF
  DB '.OVL'

OvlVerText:   ;Must be exactly 6 bytes long!
  DB ' 00.14'

StopTyping:
  DB EOF ;To stop the beeps and happy faces if the user TYPEs the file

Version:
  DW 000Eh ;Must match USBUHCI{L} version, NOT BCD
           ;Beginning w/ Version 0.12, when we started using AMIS,
           ;  this is no longer BCD.


;==============================================================================
;String & Table Offset Lookups
;MUST immediately follow Signature String & Version Number!!
;==============================================================================
LookupTbl:
 ;---------------------
 ;Miscellaneous Strings
 ;---------------------
  DB (SIDCrLf AND 00FFh)
    DW CrLfMsg
  DB (SIDYes2Msg AND 00FFh)
    DW Yes2Msg
  DB (SIDNo2Msg AND 00FFh)
    DW No2Msg
  DB (SIDSpace4 AND 00FFh)
    DW Space4Msg
  DB (SIDSpace3 AND 00FFh)
    DW Space3Msg
  DB (SIDSpace2 AND 00FFh)
    DW Space2Msg
  DB (SIDSpace AND 00FFh)
    DW SpaceMsg
  DB (SIDYesMsgY AND 00FFh)
    DW YesMsgY
  DB (SIDNoMsgN AND 00FFh)
    DW NoMsgN
  DB (SIDDblLine AND 00FFh)
    DW DblLineMsg
  DB (SIDNAMsg AND 00FFh)
    DW NAMsg
  DB (SIDPause AND 00FFh)
    DW PauseMsg
  DB (SIDPauseN AND 00FFh)
    DW PauseNMsg
  DB (SIDPauseD AND 00FFh)
    DW PauseDMsg
  DB (SIDNoSuptFile AND 00FFh)
    DW NoSuptFileMsg
  DB (SIDSyntax AND 00FFh)
    DW SyntaxMsg
  DB (SIDFLHeader AND 00FFh)
    DW FLHeaderMsg
  DB (SIDEllipses AND 00FFh)
    DW EllipsesMsg
  DB (SIDQHHeader AND 00FFh)
    DW QHHeaderMsg
  DB (SIDQHTypeCtl AND 00FFh)
    DW QHTypeControlMsg
  DB (SIDQHTypeBulk AND 00FFh)
    DW QHTypeBulkMsg
  DB (SIDQHTypeInt AND 00FFh)
    DW QHTypeIntMsg
  DB (SIDTDHeader0 AND 00FFh)
    DW TDHeaderMsg0
  DB (SIDTDHeader1 AND 00FFh)
    DW TDHeaderMsg1
  DB (SIDTDHeader2 AND 00FFh)
    DW TDHeaderMsg2
  DB (SIDTDTypeTbl AND 00FFh)
    DW TDTypeMsgTbl
  DB (SIDTDPktTypeTbl AND 00FFh)
    DW TDPktTypeMsgTbl
  DB (SIDTDPktTypeNA AND 00FFh)
    DW TDPktTypeNAMsg
  DB (SIDOneTimeInt AND 00FFh)
    DW OneTimeIntMsg
  DB (SIDPeriodicInt AND 00FFh)
    DW PeriodicIntMsg
  DB (SIDBulk AND 00FFh)
    DW BulkMsg
  DB (SIDIsoch AND 00FFh)
    DW IsochMsg
  DB (SIDControl AND 00FFh)
    DW ControlMsg
  DB (SIDSetupStage AND 00FFh)
    DW SetupStageMsg
  DB (SIDDataStage AND 00FFh)
    DW DataStageMsg
  DB (SIDStatusStage AND 00FFh)
    DW StatusStageMsg
  DB (SIDDvcNotYet AND 00FFh)
    DW DvcNotYetMsg
  DB (SIDDvcAddr AND 00FFh)
    DW DvcAddrMsg
  DB (SIDDvcConfig AND 00FFh)
    DW DvcConfigMsg
  DB (SIDDvcNoMore AND 00FFh)
    DW DvcNoMoreMsg
  DB (SIDAliasHdr AND 00FFh)
    DW AliasHdrMsg
  DB (SIDParseCmd AND 00FFh)
    DW ParseCmdMsg
  DB (SIDParseEnv AND 00FFh)
    DW ParseEnvMsg
  DB (SIDParseStdIn AND 00FFh)
    DW ParseStdInMsg
  DB (SIDParseErr AND 00FFh)
    DW ParseErrMsg
  DB (SIDParseErrEnv AND 00FFh)
    DW ParseErrEnv
  DB (SIDParseErr2 AND 00FFh)
    DW ParseErrMsg2
  DB (SIDInitializing1 AND 00FFh)
    DW InitializingMsg1
  DB (SIDInitializing2 AND 00FFh)
    DW InitializingMsg2
  DB (SIDEnvironment AND 00FFh)
    DW EnvMsg
  DB (SIDInstall1 AND 00FFh)
    DW InstallMsg1
  DB (SIDInstallAuto AND 00FFh)
    DW InstallMsgAuto
  DB (SIDInstallHigh AND 00FFh)
    DW InstallMsgHigh
  DB (SIDInstallHole AND 00FFh)
    DW InstallMsgHole
  DB (SIDInstallNorm AND 00FFh)
    DW InstallMsgNorm
  DB (SIDInstallLast AND 00FFh)
    DW InstallMsgLast
  DB (SIDDOSVer AND 00FFh)
    DW DOSVerMsg
  DB (SIDNo386 AND 00FFh)
    DW No386Msg
  DB (SIDNoPCI AND 00FFh)
    DW NoPCIMsg
  DB (SIDNoUHCI AND 00FFh)
    DW NoUHCIMsg
  DB (SIDNotReal AND 00FFh)
    DW NotRealMsg
  DB (SIDLegacyCont AND 00FFh)
    DW LegacyContMsg
  DB (SIDAlreadyRun AND 00FFh)
    DW AlreadyRunMsg
  DB (SIDTooManyHosts AND 00FFh)
    DW TooManyHostsMsg
  DB (SIDNoEnviron AND 00FFh)
    DW NoEnvironMsg
  DB (SIDStdInMemory AND 00FFh)
    DW StdInMemoryMsg
  DB (SIDStdInTooBig AND 00FFh)
    DW StdInTooBigMsg
  DB (SIDAssignIRQ AND 00FFh)
    DW AssignIRQMsg
  DB (SIDAssignIO AND 00FFh)
    DW AssignIOMsg
  DB (SIDWrongVer AND 00FFh)
    DW WrongVerMsg
  DB (SIDUninstall AND 00FFh)
    DW UninstallMsg
  DB (SIDNoUninstall AND 00FFh)
    DW NoUninstallMsg
  DB (SIDNotFirstInst AND 00FFh)
    DW NotFirstInstMsg
  DB (SIDSharedIRQ AND 00FFh)
    DW SharedIRQMsg
  DB (SIDDvc0Owner AND 00FFh)
    DW Dvc0OwnerMsg
  DB (SIDNotInMem AND 00FFh)
    DW NotInMemMsg
  DB (SIDCantStopHost AND 00FFh)
    DW CantStopHostMsg
  DB (SIDUpdate AND 00FFh)
    DW UpdateMsg
  DB (SIDNoStart AND 00FFh)
    DW NoStartMsg
  DB (SIDInternalErr AND 00FFh)
    DW InternalErrMsg
  DB (SIDMoreLeft AND 00FFh)
    DW MoreLeftMsg
  DB (SIDMoreRight AND 00FFh)
    DW MoreRightMsg
  DB (SIDSwitchList AND 00FFh)
    DW SwitchList
  DB (SIDSwitchList2 AND 00FFh)
    DW SwitchList2
  DB (SIDSwitchListYN AND 00FFh)
    DW SwitchListYesNo
  DB (SIDErrLvlHdr AND 00FFh)
    DW ErrLvlHdr
  DB (SIDErrLvlTbl AND 00FFh)
    DW ErrLvlTbl
 ;-----------------
 ;Debugging Strings
 ;-----------------
  DB (SIDProgDebug AND 00FFh)
    DW ProgDebugMsg
  DB (SIDBusDevFunc AND 00FFh)
    DW BusDevFuncMsg
  DB (SIDPCISearchIdx AND 00FFh)
    DW PCISearchIdxMsg
  DB (SIDIRQNumber AND 00FFh)
    DW IRQNumberMsg
  DB (SIDBaseIO AND 00FFh)
    DW BaseIOMsg
  DB (SIDFrameListAddr AND 00FFh)
    DW FrameListAddrMsg
  DB (SIDStopHost AND 00FFh)
    DW StopHostMsg
  DB (SIDEnBusMaster AND 00FFh)
    DW EnBusMasterMsg
  DB (SIDDisSMIFlags AND 00FFh)
    DW DisSMIFlagsMsg
  DB (SIDEnResumeDet AND 00FFh)
    DW EnResumeDetMsg
  DB (SIDRedirGenInts AND 00FFh)
    DW RedirGenIntsMsg
  DB (SIDRedirUSBInt AND 00FFh)
    DW RedirUSBIntMsg
  DB (SIDResetHost AND 00FFh)
    DW ResetHostMsg
  DB (SIDSetFLAddress AND 00FFh)
    DW SetFLAddressMsg
  DB (SIDFrameTiming AND 00FFh)
    DW FrameTimingMsg
  DB (SIDStartFrame AND 00FFh)
    DW StartFrameMsg
  DB (SIDEnIRQFlags AND 00FFh)
    DW EnIRQFlagsMsg
  DB (SIDDisSMIFlags AND 00FFh)
    DW DisSMIFlagsMsg
  DB (SIDDisSMIGen AND 00FFh)
    DW DisSMIGenMsg
  DB (SIDEnIRQGen AND 00FFh)
    DW EnIRQGenMsg
  DB (SIDStartHost AND 00FFh)
    DW StartHostMsg
  DB (SIDVerifyHost AND 00FFh)
    DW VerifyHostMsg
  DB (SIDInitRootHub AND 00FFh)
    DW InitRootHubMsg
  DB (SIDVerifyIRQ AND 00FFh)
    DW VerifyIRQMsg
 ;---------------------------
 ;Uninstall Debugging Strings
 ;---------------------------
  DB (SIDRestoreUSBInt AND 00FFh)
   DW RestoreUSBIntMsg
  DB (SIDRestorePort1 AND 00FFh)
   DW RestorePort1Msg
  DB (SIDRestorePort2 AND 00FFh)
   DW RestorePort2Msg
  DB (SIDEnSMIFlags AND 00FFh)
   DW EnSMIFlagsMsg
  DB (SIDEnSMIGen AND 00FFh)
   DW EnSMIGenMsg
  DB (SIDRestoreIRQ AND 00FFh)
   DW RestoreIRQMsg
  DB (SIDRestorePCI AND 00FFh)
   DW RestorePCIMsg
  DB (SIDRestoreGenInts AND 00FFh)
   DW RestoreGenIntsMsg
 ;-----------------
 ;Reset Bad Devices
 ;-----------------
  DB (SIDResetBad AND 00FFh)
   DW ResetBadMsg
  DB (SIDNoBads AND 00FFh)
   DW NoBadsMsg
  DB (SIDErrorBads AND 00FFh)
   DW ErrorBadsMsg
 ;-----------------
 ;Report Descriptor
 ;-----------------
  DB (SIDRptNoDvc0 AND 00FFh)
   DW RptNoDvcMsg0
  DB (SIDRptNoDvc1 AND 00FFh)
   DW RptNoDvcMsg1
  DB (SIDRptNoDvc2 AND 00FFh)
   DW RptNoDvcMsg2
  DB (SIDRptNoData AND 00FFh)
   DW RptNoDataMsg
 ;----------------------
 ;Downloaded Descriptors
 ;----------------------
  DB (SIDDescrNoDvc AND 00FFh)
   DW DescrNoDvc
  DB (SIDDescrNoData AND 00FFh)
   DW DescrNoData

  DB -1
    DW -1 ;End of Table


;==============================================================================
;Various Strings we need to write
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Miscellaneous strings needed to print numbers and such to the screen
  ;----------------------------------------------------------------------------
  CrLfMsg:    DB CR,LF,0
  Yes2Msg:    DB 'Y ',0
  No2Msg:     DB '. ',0
  Space4Msg:  DB ' '
  Space3Msg:  DB ' '
  Space2Msg:  DB ' '
  SpaceMsg:   DB ' ',0
  YesMsgY:    DB 'Yes',0
  NoMsgN:     DB ' No',0
  DblLineMsg: DB 'Õ',0
  NAMsg:      DB "n/a",0

  ;----------------------------------------------------------------------------
  ;Strings needed to Pause the screen
  ;----------------------------------------------------------------------------
  PauseMsg:
    DB CR,LF
    DB ' MORE   (Esc stops Pausing, Ctrl-C stops Completely, any other Continues)',CR,0
  PauseNMsg:
    DB ' MORE                                                                    ',CR,LF,0
  PauseDMsg:
    DB '                                                                               ',CR,0

  ;----------------------------------------------------------------------------
  ;Error Message for when the Support File is not found
  ;----------------------------------------------------------------------------
  NoSuptFileMsg:
    DB 'Error! Need Support File ',0


;==============================================================================
;Syntax Help Screens
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Syntax Help Strings (if user asks for, or otherwise needs, Help)
  ;----------------------------------------------------------------------------
  SyntaxMsg:
    DB  CR,'SYNTAX: '

  #IF !LITE
    DB 'USBUHCI '
  #ELSE
    DB 'USBUHCIL '
  #ENDIF

   DB '[Options]',CR,LF
   DB  LF
   DB '  /?      Õ Show this HELP screen',CR,LF
   DB '  /A      Õ Show all ALIASES for these command line Options',CR,LF
   DB '  /ErrLvl Õ Show all ErrorLevels (DOS Return Codes)',CR,LF
   DB '  /U      Õ UNINSTALL from memory',CR,LF
   DB '  /L:Y|N  Õ Force installation into LOW memory (default = No)',CR,LF
   DB  LF
   DB '  /Index #       Õ Use UHCI Host with PCI INDEX # (default = 0)',CR,LF
   DB '  /IOAddr #      Õ Use I/O base ADDR # (100h-FFE0h, divisible by 32)',CR,LF
   DB '  /IRQ #         Õ Use IRQ # (3-15, default = 9)',CR,LF
   DB '  /DisableLegacy Õ Disable Legacy Keyboard/Mouse support',CR,LF
   DB '  /DisableOther  Õ Disable Other Control program',CR,LF
   DB '  /P:#           Õ Pause # deciSeconds before finding Root Devices (0-255)',CR,LF
   DB '  /Beep:Y|N      Õ BEEP Speaker when bad Device is found (default = Yes)',CR,LF
   DB '  /PD[:#]        Õ Display Program Debug messages during install and uninstall',CR,LF
   DB '                      # = Milliseconds to delay each step (0-2000, default = 0)',CR,LF
   DB  LF
   DB '  /Run #     Õ Run (Resume/Enable) Device Address # ø',CR,LF
 #IF !LITE
   DB '  /Stop #    Õ Stop (Disable) Device Address #      ¥  0-1   = Host/Root Hub',CR,LF
   DB '  /Reset #   Õ Reset Device Address #               ¥  2-127 = Attached Dvc',CR,LF
   DB '  /Suspend # Õ Suspend Device Address #             ¥128-255 = All Hosts',CR,LF
 #ELSE
   DB '  /Stop #    Õ Stop (Disable) Device Address #      ¥ 0-1 =  Host/Root Hub',CR,LF
   DB '  /Reset #   Õ Reset Device Address #               ¥ 2-17  = Attached Dvc',CR,LF
   DB '  /Suspend # Õ Suspend Device Address #             ¥18-255 = All Hosts',CR,LF
 #ENDIF
   DB '  /Resume #  Õ Resume (not Enable) Device Address # Ÿ',CR,LF
   DB  LF
   DB '  /PowerOn #    Õ Power On Device Address #    ø',CR,LF
 #IF !LITE
   DB '  /PowerOff #   Õ Power Off Device Address #   ¥ 2-127',CR,LF
 #ELSE
   DB '  /PowerOff #   Õ Power Off Device Address #   ¥ 2-17',CR,LF
 #ENDIF
   DB '  /PowerReset # Õ Power Reset Device Address # Ÿ',CR,LF
   DB  LF
 #IF !LITE
   DB '  /SC:D# C# Õ Set Configuration of Device D# (2-127) to value C# (0-255)',CR,LF
   DB '  /RW:# Y|N Õ Enable/disable Remote Wakeup on Device # (2-127)',CR,LF
   DB '  /TM:# Y|N Õ Enable/disable Test Mode on Device # (2-127)',CR,LF
 #ELSE
   DB '  /SC D# C# Õ Set Configuration of Device D# (2-17) to value C# (0-255)',CR,LF
   DB '  /RW:# Y|N Õ Enable/disable Remote Wakeup on Device # (2-17)',CR,LF
   DB '  /TM:# Y|N Õ Enable/disable Test Mode on Device # (2-17)',CR,LF
 #ENDIF
   DB  LF
   DB '  /Timing #    Õ Set Timing to # Bits/Frame (11936-12063, default = 12000)',CR,LF
   DB '  /Debug, /SST Õ Debug/SingleStep the Host',CR,LF
   DB  LF
   DB '  /Host       Õ Show Status of Host (PCI/USB/Root Hub)',CR,LF
   DB '  /FL         Õ Show Status of Frame List',CR,LF
   DB '  /QH         Õ Show Status of Queue Heads',CR,LF
 #IF !LITE
   DB '  /TD [#]     Õ Show Status of Transfer Descriptor(s), optional Idx # (0-255)',CR,LF
 #ELSE
   DB '  /TD [#]     Õ Show Status of Transfer Descriptor(s), optional Idx # (0-79)',CR,LF
 #ENDIF
   DB '  /AD         Õ Show Status of Addressed Devices',CR,LF
   DB '  /ND         Õ Show Status of New Device Notification Entries',CR,LF
 #IF !LITE
   DB '  /Descr [:#] Õ Show Descriptors for Device Address # (2-127)',CR,LF
 #ELSE
   DB '  /Descr [:#] Õ Show Descriptors for Device Address # (2-17)',CR,LF
 #ENDIF
   DB '                   If no Address is provided, shows Last Enumerated Device',CR,LF
 #IF !LITE
   DB '  /R A# I#    Õ Show HID Report Descr for Dvc Addr A# (2-127), Intf I# (0-255)',CR,LF
 #ELSE
   DB '  /R A# I#    Õ Show HID Report Descr for Dvc Addr A# (2-17), Intf I# (0-255)',CR,LF
 #ENDIF
   DB  LF
   DB '  /RB Õ Reset all Bad Devices on all Hosts'
   DB 0


