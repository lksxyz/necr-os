  DW 00800h, 008FFh
  DW 018B0h, 018FFh
  DW 01A20h, 01AFFh
  DW 01B80h, 01CFFh
  DW 02DE0h, 02DFFh
  DW 02FE0h, 02FEFh
  DW 09FC0h, 09FFFh
  DW 0A4D0h, 0A6FFh
  DW 0A830h, 0A83Fh
  DW 0A880h, 0ABFFh
  DW 0D7B0h, 0D7FFh
  DW -1 ;End of Table

UnknownRangeTbl01:
  DW 00190h, 002FFh
  DW 00350h, 0037Fh
  DW 003E0h, 003FFh
  DW 004B0h, 007FFh
  DW 00840h, 008FFh
  DW 00920h, 009FFh
  DW 00A60h, 01FFFh
  DW 02480h, 0CFFFh
  DW 0D250h, 0D2FFh
  DW 0D380h, 0D3FFh
  DW 0D800h, 0FF7Fh
  DW -1 ;End of Table

UnknownRangeTbl02:
  DW 0A6E0h, 0F7FFh
  DW 0FA20h, 0FF7Fh
  DW -1 ;End of Table

UnknownRangeTbl0E:
  DW 00080h, 000FFh
  DW 001F0h, 0FF7Fh
  DW -1 ;End of Table



