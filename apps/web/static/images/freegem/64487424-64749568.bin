;------------------------------------------------------------------------------
;DO THE PROGRAM THING!
;Inputs:
;Outputs: Lots of Stuff
;Changes: Everything
;------------------------------------------------------------------------------
Main:
  CLD                    ;Go forward with string functions
  MOV  SP,LastProgByte   ;Reset Stack Pointer
  CALL ResizeMemory      ;Resize our Memory Allocation
  CALL CopyNameToMCB     ;Copy our Program name to the MCB
  CALL SetupPauseNoHdr   ;Set up the Pause
  CALL GetCodePage       ;Get teh current DOS Code Page
  CALL TestParentShell   ;See if our Parent is a DOS Command Shell
  JNZ >M10               ;If not, don't write the Copyright
  MOV  DX,Copyright      ;If so, write the
  CALL WriteZPause       ;  Copyright message
M10:                     ;Copyright written, if appropriate
  CALL TestCompatibility ;Test for compatibility, quit if Error
  XOR  BP,BP             ;Make sure high word is 0
  CALL ParseCmdLine      ;Do what the user wants, quit if Error
  XOR  AL,AL             ;ErrorLevel = 0
  MOV  DX,NoMsg          ;Write Nothing afterwards
;  JMP  Exit              ;QUIT

;------------------------------------------------------------------------------
;PRINT MESSAGE IN DX AND QUIT WITH ERRORLEVEL IN AL
;Inputs:  AL = Errorlevel to exit program with
;         DS:[DX] = Message to Print (to ERR)
;Outputs:
;Changes: Quits program
;------------------------------------------------------------------------------
Exit:
  OR   AL,AL       ;Was there an Error?
  JZ  >X80         ;If not, jump to handle a normal termination
  CALL BeepErr     ;If error, Beep Once
  CALL WriteZErr   ;Write message to ERR
  MOV  DX,CrLfMsg  ;Write a
  CALL WriteZErr   ;  new line
  JMP >X90         ;Jump to quit
X80:               ;No Error - Write to CON
  CALL WriteZPause ;Write the message to CON
X90:               ;We're done!!
  MOV  AH,4Ch      ;Service 4Ch (terminate program)
  INT  21h         ;Do it

;------------------------------------------------------------------------------
;MAKE SURE THE MCB (MEMORY CONTROL BLOCK) CONTAINS OUR PROGRAM NAME
;Inputs:  DS = Local Data Area
;         DS:RealName = ASCIIZ Real Name of our program
;         CLD Already Issued
;Outputs:
;Changes: Data in MCB
;NOTES:   This makes sure that the MCB (Memory Control Block) for our
;           program contains our program name.  DOS 4+ does this
;           automatically, but DOS versions 1-3 do not.  This code
;           does not verify whihc DOS version is in use, but simply
;           fills in the MCB no matter what.
;         Our program name is needed inthe MCB to make sure other programs
;           can identify that we are installed in memory.  This code should
;           be added to all TSR's, so that memory-mapping programs
;           (like MAPMEM or ISLOADED) can tell which TSR's are installed
;           in memory.  It should also be added to all programs that
;           EXEC other programs, so that the EXEC'd program can figure out
;           who called it.
;         Programs that are not TSR's and do not EXEC other programs
;           do not need this code.
;------------------------------------------------------------------------------
CopyNameToMCB:
  PUSH CX,DI,SI,ES              ;Save used registers
  MOV  CX,DS                    ;Point ES:[DI]
  DEC  CX                       ;  at the Owners Name
  MOV  ES,CX                    ;  in the MCB
  MOV  DI,(OFFSET MCBOwnerName) ;  of our program
  MOV  SI,RealName              ;Point DS:[SI] at our Program Name
  MOV  CX,4                     ;Copy 4 words (8 bytes)
  REP  MOVSW                    ;Copy our program name to the MCB
  POP  ES,SI,DI,CX              ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO DETERMINE THE CURRENT DOS CODE PAGE
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;GET THE CURRENT DOS SCREEN CODE PAGE
;Inputs:
;Outputs: CodePage
;Changes:
;------------------------------------------------------------------------------
GetCodePage:
  PUSH AX,BX,DX    ;Save used registers
  MOV  AX,0AD00h   ;Function AD80h (DISPLAY.SYS installed?)
  INT  2Fh         ;Do it
  OR   AL,AL       ;Is it installed?
  JZ  >P20         ;If not, try to get the Code Page some other way
P10:               ;DISPLAY.SYS installed
  MOV  AX,0AD02h   ;If so, function AD02h (Get Active Code Page)
  INT  2Fh         ;Do it
  JC  >P20         ;If none available, get the Code Page some other way
  MOV  CodePage,BX ;If we got it, store it
  JMP >P90         ;And we're done
P20:               ;DISPLAY.SYS not installed
  MOV  AX,6601h    ;Function 6601h (Get Code Page Information)
  STC              ;Preset the error flag (in case of bad DOS version)
  INT  21h         ;Do it (returns BX=Active Code Page, DX=System Code Page)
  JC  >P90         ;If there was an error, quit
  MOV  CodePage,BX ;If OK, store the Code Page
P90:               ;Done
  POP  DX,BX,AX    ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO DETERMINE WHO OUR PARENT PROGRAM IS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;COPY THE CAPITALIZED NAME OF OUR PARENT PROGRAM TO A LOCAL STRING (PARENTNAME)
;Inputs:  ParentIsShell = No
;Outputs: ParentIsShell = Yes if Parent Program has a Shell Name
;                         ZF = Set
;                       = No if Parent Program does not have a Shell Name
;                         ZF = Clear
;Changes:
;------------------------------------------------------------------------------
TestParentShell:
  PUSH AX,BX,DI,SI       ;Save used registers
  CALL GetParentNameCaps ;Get our Parents Capitalized Name
  JZ  >S80               ;If invalid, assume we're at a command-line
  MOV  SI,DOSShellTbl    ;Point at our table of Shell Names
S10:                     ;Loop to here for each table entry
  MOV  DI,ParentName     ;Point DI at our Parents Name
  MOV  BX,SI             ;Save the current table pointer
  CMP  B [BX],0          ;End of the Table?
  JE  >S90               ;If so, it's not a Command Shell
S20:                     ;Loop to here for each character in the string
  MOV  AL,[BX]           ;Get the next table character
  OR   AL,AL             ;End of the table string?
  JZ  >S40               ;If so, handle it
S30:                     ;Not end of table string
  CMP  AL,[DI]           ;Does the character match?
  JNE >S60               ;If not, try the next table entry
  INC  BX                ;If so, increment
  INC  DI                ;  our Pointers
  JMP  S20               ;and keep testing
S40:                     ;End of our table string
  CMP  B [DI],0          ;End of the Parents Name string?
  JE  >S80               ;If so, it's a match
S60:                     ;Not a match
  CALL SkipOverStringSI  ;Point at the next table entry
  JMP  S10               ;Keep going until we're done
S80:                     ;Is a Command Shell
  MOV  ParentIsShell,Yes ;Store the result for later
S90:                     ;Done
  CMP  ParentIsShell,Yes ;Set the return flag
  POP  SI,DI,BX,AX       ;Restore used registers
  RET

;------------------------------------------------------------------------------
;COPY THE CAPITALIZED NAME OF OUR PARENT PROGRAM TO A LOCAL STRING (PARENTNAME)
;Inputs:  ES = Local Data Area
;         CLD already issued
;Outputs: ParentName
;         ZF = Clear if ParentName is valid (greater than 0 length)
;            = Set if Invalid (0-length, such as under the DOSBox program)
;Changes:
;------------------------------------------------------------------------------
GetParentNameCaps:
  PUSH AX,CX,DI,SI,DS         ;Save used registers
  MOV  AX,[PSPParentPSP]      ;Point DS at
  DEC  AX                     ;  the MCB of our
  MOV  DS,AX                  ;  Parents PSP
  MOV  SI,OFFSET MCBOwnerName ;Point DS:[SI] at the Owners name
  MOV  DI,ParentName          ;Point ES:[DI] at our storage area
  MOV  CX,8                   ;Copy 8 bytes
P10:                          ;Loop to here for each character
  LODSB                       ;Get the next byte
  CALL Capitalize             ;Capitalize it
  STOSB                       ;Store it
  LOOP P10                    ;Keep going until we're done
  CMP  ES:B ParentName[0],0   ;Set return flag
  POP  DS,SI,DI,CX,AX         ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO PARSE THE COMMAND LINE FOR SWITCHES AND OPTIONS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;PARSE THE COMMAND LINE FOR A SWITCH
;Inputs:
;Outputs:
;Changes:
;------------------------------------------------------------------------------
ParseCmdLine:
  PUSH AX,BX,SI,ES      ;Save used registers
  MOV  SI,81h           ;Point at command line tail
P10:                    ;Look for the next switch
  CALL IsSpaceOrEOL     ;Look for a valid character
  JZ  >P70              ;If none, user needs help
  CALL GetSegmentOffset ;If not, see if it's a Data Pointer (ES:[BX])
  JC  >P70              ;If not, user needs help
  CALL GetCallBackAddr  ;If so, look for a Call-Back Address
;  JC  >P70              ;If Error, just do Help Message
  CMP  ParseError,Yes   ;Was there an error?
  JE  >P70              ;If so, write help message
  CALL ProcessString    ;If OK, process the String
  JMP >P90              ;Done
P70:                    ;Error
  MOV  DX,HelpMsg       ;Write the
  CALL WriteItDX        ;  Help Message
  MOV  DX,NoMsg         ;Write nothing
  XOR  AL,AL            ;ErrorLevel 0
  JMP  Exit             ;Print error message and quit
P90:                    ;We're done
  POP  ES,SI,BX,AX      ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO GET A NUMBER FROM A STRING (HEX OR DECIMAL)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;GET A NUMBER FROM A STRING (CAN BE DECIMAL OR HEX)
;Inputs:  [SI] = String Pointer
;Outputs: CF = Clear if we got a valid number
;              AX = Number
;            = Set if Error (no number found)
;              AX = 0
;Changes: SI points at next byte after the number
;NOTES: A Hex String must start with '0x' and/or end in 'H'!
;------------------------------------------------------------------------------
GetNumber:
  PUSH BX           ;Save used registers
  MOV  BX,AX        ;Save original AX
  CALL IsSpaceOrEOL ;Skip past spaces
  JZ  >N70          ;If End-of-Line, Error
  CALL TestForHex   ;Is it a Hex Number?
  JC  >N20          ;If not, try a decimal
  CALL Test0xPrefix ;Skip over the 0x (C-style) prefix, if there
  CALL GetHex       ;If so, get it
  JNC >N80          ;If OK, we're done
  JMP >N70          ;If not, Error
N20:                ;Not Hex
  CALL GetDecimal   ;Try a Decimal
  JNC >N80          ;If OK, we're done
N70:                ;Error
  MOV  AX,BX        ;Restore original AX
  STC               ;Set Error Flag
  JMP >N90          ;Done
N80:                ;OK
  CLC               ;Set OK Flag
N90:                ;Done
  POP  BX           ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST AN ASCII STRING TO SEE IF IT IS A HEX STRING (ENDS IN H)
;Inputs:  [SI] = String to test
;Outputs: CF = Clear if it is a Hex String
;            = Set if Error (not a Hex String)
;Changes:
;NOTES: A valid Hex String will contain numerals 0-9, A-F, and Underscores,
;         and will end in an H.  It cannot contain spaces.
;------------------------------------------------------------------------------
TestForHex:
  PUSH AX,SI        ;Save used registers
  CALL Test0xPrefix ;Test for the 0x (C-style) prefix (changes SI)
  JNC >H80          ;If so, it's Hex
  MOV  AL,[SI]      ;Get the first character
  CALL IsHexNumber  ;A valid Hex Number?
  JC  >H70          ;If not, Error
H40:                ;Loop to here for each character
  LODSB             ;Get the next character
  CALL IsHexNumber  ;A valid Hex Number?
  JNC  H40          ;If so, keep looking
  CMP  AL,'_'       ;An Underscore?
  JE   H40          ;If so, keep looking
  CALL IsHexEnd     ;End of the Hex Number?
  JZ  >H80          ;If so, we're done
H70:                ;Not Hex
  STC               ;Set error Flag
  JMP >H90          ;Done
H80:                ;Is Hex
  CLC               ;Set OK Flag
H90:                ;Done
  POP  SI,AX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST FOR A 0x (C-STYLE) HEX PREFIX
;Inputs:  [SI] = String to test
;Outputs: CF = Set if not a 0x Prefix
;              SI unchanged
;            = Clear if not a 0x Prefix
;              [SI] = Character after the 0x
;Changes:
;------------------------------------------------------------------------------
Test0xPrefix:
  PUSH AX,BX       ;Save used registers
  MOV  BX,SI       ;Save original Pointer
  LODSB            ;Get the next character
  CMP  AL,'0'      ;Is it a 0?
  JNE >X70         ;If not, it's not a Prefix
X20:               ;Loop to here to skip over all zeroes
  LODSB            ;Get the next charcter
  CMP  AL,'0'      ;Is it another 0?
  JE   X20         ;If so, keep skipping the zeroes
  CALL Capitalize  ;If not, capitalize it
  CMP  AL,'X'      ;Is it an X?
  JNE >X70         ;If not, it's not a 0x Prefix
  LODSB            ;Get the next charcter
  CALL IsHexNumber ;Is it a Hex Number?
  JNC >X80         ;If so, it's a 0x Prefix
X70:               ;Not a 0x Prefix
  MOV  SI,BX       ;Restore original pointer
  STC              ;Set return flag
  JMP >X90         ;Done
X80:               ;Is a 0x Prefix
  DEC  SI          ;Point back at the first hex number
  CLC              ;Set return flag
X90:               ;Done
  POP  BX,AX       ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE NEXT SERIES OF HEX CHARACTERS, AND CONVERT THEM TO A NUMBER
;Inputs:  [SI] = Command Line Pointer
;Outputs: CF = Clear if OK
;              AX = Character string converted to a number, ?? if not
;            = Set if Error
;              AX = Unchanged
;Changes:
;NOTES: The string can either have an H at the end or not, and this code
;         will work.
;------------------------------------------------------------------------------
GetHex:
  PUSH BX,CX,DX    ;Save used registers
  MOV  DX,AX       ;Save original AX
  XOR  BX,BX       ;Start with zero
  MOV  CX,4        ;CL = bits to shift by, CH = Character Counter
  XOR  AH,AH       ;Set High byte to 0
D10:               ;Loop to here for each character
  LODSB            ;Get the next character
  CALL IsHexNumber ;A valid Hex Number?
  JNC >D20         ;If so, continue
  CMP  AL,'_'      ;If not, is it an Underscore?
  JE  >D45         ;If so, keep looking
  JMP >D50         ;If not, we're done
D20:               ;Valid Hex Number
  INC  CH          ;Increment the character counter
  SHL  BX,CL       ;Make room for the New Nibble
  JNC >D40         ;If we're not too big yet, keep going
  DEC  SI          ;If too big, Point back at bad character
  JMP >D70         ;Error
D40:               ;OK to add in new Nibble
  ADD  BX,AX       ;Add in the new Nibble
D45:               ;Done with this character
  JMP  D10         ;Jump to get next character
D50:               ;Done getting string
  DEC  SI          ;Point back at the bad character
  OR   CH,CH       ;Any valid characters at all?
  JZ  >D70         ;If not, error
  LODSB            ;Is the next character
  CALL IsHexEnd    ;  an H?
  JZ  >D80         ;If so, we're done
  DEC  SI          ;If not, point back at the non-H
  JMP >D80         ;Done
D70:               ;There was an error
  MOV  AX,DX       ;Restore original AX
  STC              ;Mark the error flag
  JMP >D90         ;And quit
D80:               ;We have a good number
  MOV  AX,BX       ;Put the value where it belongs
  CLC              ;Mark the OK flag
D90:               ;We're done
  POP  DX,CX,BX    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE NEXT SERIES OF NUMERIC CHARACTERS, AND CONVERT THEM TO A NUMBER
;Inputs:  [SI] = Command Line Pointer
;Outputs: AX = decimal character string converted to a number, ?? if not
;         CF = Clear if AX is OK
;            = Set if no decimal found
;Changes: SI points at character after the number
;------------------------------------------------------------------------------
GetDecimal:
  PUSH BX,CX,DX     ;Save used registers
  XOR  AX,AX        ;Start with zero
  XOR  BX,BX        ;  "    "    "   - accumulator
  MOV  CX,10        ;CX = multiplier & digit limit comparer
  CALL IsSpaceOrEOX ;Skip over the spaces
  JZ  >D70          ;If EOL, Error
  SUB  AL,'0'       ;If not, convert it to a number
  CMP  AL,9         ;Is it really a number?
  JA  >D70          ;If not, there's an error
  DEC  SI           ;If so, step back to the number
D10:                ;Loop to here for each character
  LODSB             ;Get the next character
  SUB  AL,'0'       ;Change it to 0-9 range
  XOR  AH,AH        ;Extend byte to word
  CMP  AX,CX        ;Is it a digit?
  JAE >D80          ;If not, we're done
  CMP  BX,6553      ;Is our number getting too big?
  JB  >D20          ;If not, jump to store it
  CMP  AL,5         ;If so, will this number make it too big?
  JA  >D70          ;If so, there's an error
D20:                ;Add the digit to our number
  XCHG AX,BX        ;Swap accumulation into AX, new digit into BX
  MUL  CX           ;Multiply the previous accumulation by 10
  ADD  BX,AX        ;Add in the new digit
  JMP  D10          ;Jump to get next character
D70:                ;There was an error
  STC               ;Mark the error flag
  JMP >D90          ;And quit
D80:                ;We have a good number
  DEC  SI           ;Point back at the non-number
  MOV  AX,BX        ;Put the value where it belongs
  CLC               ;Mark the OK flag
D90:                ;We're done
  POP  DX,CX,BX     ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST AN ASCII CHARACTER TO SEE IF IT IS A HEX NUMERAL (BETWEEN 0 AND F)
;Inputs:  AL = ASCII Character to Test
;Outputs: CF = Clear if it is a Number
;              AL = ASCII Code converted to a real Number
;            = Set if Error (not a Number)
;              AL = Unchanged
;Changes:
;------------------------------------------------------------------------------
IsHexNumber:
  PUSH BX          ;Save used registers
  MOV  BL,AL       ;Save the character in case we need to restore it
  CALL IsNumber    ;A Decimal Number?
  JNC >H85         ;If so, we're done
  CALL Capitalize  ;If not, Capitalize it
  CMP  AL,'A'      ;A Hex Number?
  JB  >H70         ;If not, Error
  CMP  AL,'F'      ;A Hex Number?
  JBE >H80         ;If so, handle it
H70:               ;Not a Number
  MOV  AL,BL       ;Restore original character
  STC              ;Set Error Flag
  JMP >H90         ;Done
H80:               ;A Number > 9
  SUB  AL,('A'-10) ;Convert it to a real number
  JMP >H90         ;Done
H85:               ;OK (is a Number)
  CLC              ;Set OK Flag
H90:               ;Done
  POP  BX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST AN ASCII CHARACTER TO SEE IF IT IS A NUMERAL (BETWEEN 0 AND 9)
;Inputs:  AL = ASCII Character to Test
;Outputs: CF = Clear if it is a Number
;              AL = ASCII Code converted to a real Number
;            = Set if Error (not a Number)
;              AL = Unchanged
;Changes:
;------------------------------------------------------------------------------
IsNumber:
  CMP  AL,'0' ;A Number?
  JB  >N70    ;If not, Error
  CMP  AL,'9' ;A Number?
  JBE >N80    ;If so, handle it
N70:          ;Not a Number
  STC         ;Set Error Flag
  JMP >N90    ;Done
N80:          ;A number
  SUB  AL,'0' ;Convert it to a real number
  CLC         ;Set OK Flag
N90:          ;Done
  RET

;------------------------------------------------------------------------------
;TEST AN ASCII CHARACTER TO SEE IF IT IS A PARTICULAR CHARACTER
;Inputs:  AL = ASCII Character to Test
;Outputs: ZF = Set if it is the appropriate character
;            = Clear if not
;Changes:
;------------------------------------------------------------------------------
IsHexEnd:
  PUSH AX         ;Save used registers
  CALL Capitalize ;Capitalize the Character
  CMP  AL,'H'     ;See if it matches
  POP  AX         ;Restore used registers
  RET

;------------------------------------------------------------------------------
;SKIP OVER SPACES TO FIND THE NEXT LEGITIMATE CHARACTER, TESTING FOR EOL
;Inputs:  DS:[SI] = Command Line Pointer
;Outputs: ZF = Set if EOL
;               AL  = Unchanged
;              [SI] = End-of-Line Character
;            = Clear if not EOL
;               AL  = First non-space character
;              [SI] = Character AFTER the next non-space character
;Changes:
;------------------------------------------------------------------------------
IsSpaceOrEOX:
  CALL IsSpaceOrEOL ;Skip over the spaces
  JZ  >X90          ;If end-of-line, we're done
  LODSB             ;If not, get the next character
  OR   AL,AL        ;Set return flag
X90:                ;Done
  RET

;------------------------------------------------------------------------------
;SKIP OVER SPACES TO FIND LEGITIMATE CHARACTERS, AND TEST FOR EOL
;Inputs:  DS:[SI] = Command Line Pointer
;Outputs: ZF = Set if EOL
;            = Clear if legitimate character
;              [SI] = The Next non-Space Character
;Changes:
;------------------------------------------------------------------------------
IsSpaceOrEOL:
  PUSH AX     ;Save used registers
L10:          ;Loop to here to skip over spaces
  LODSB       ;Get the next character
  CMP  AL,' ' ;Is it a space?
  JE   L10    ;If so, get the next character
  CMP  AL,Tab ;Is it a Tab?
  JE   L10    ;If so, get the next character
  DEC  SI     ;If not, point back at the character
  CMP  AL,CR  ;Set EOL flag
  POP  AX     ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CONVERT A CODE WORD FROM THE COMMAND LINE TO A WORD FROM THE LOOKUP TABLE
;Inputs:  DS:[SI] = Command Line Pointer
;         DS:[BX] = List to Test
;Outputs: CF = Clear if a match was found
;              AL = Entry from Table
;              [SI] = Next character after the Code Match
;         CF = Set if no match found (error)
;              AL = Unchanged
;              SI = Unchanged
;Changes: SI if valid match found
;------------------------------------------------------------------------------
GetCode:
  PUSH BX,DX         ;Save used registers
  MOV  DX,AX         ;Save AX in case there's no match
C10:                 ;Loop to here for each list of words
  CMP  B [BX],0      ;Are we at the end of our table?
  JE  >C80           ;If so, we couldn't find a match
  XOR  AH,AH         ;Assume it's a match
  PUSH SI            ;Save our command line pointer for a second
C20:                 ;Loop to here for each character in a word
  LODSB              ;Get the next character
  CALL Capitalize    ;Capitalize it
  CALL CmpALBXNoCase ;Is it a match?
  JZ  >C30           ;If so, handle it
  INC  AH            ;If not, mark us as no match
C30:                 ;The character is tested
  INC  BX            ;Point at the next character in our test word
  CMP  B [BX],0      ;Are we at the end of the word?
  JNE  C20           ;If not, keep going until we're done
  INC  BX            ;Point at the next word or code list
  OR   AH,AH         ;Was it a match?
  JZ  >C50           ;If so, jump to handle it
  POP  SI            ;If not, restore our command line pointer
  CMP  B [BX],0      ;Is this the end of our word list?
  JNE  C10           ;If not, just test the next word
  INC  BX,2          ;If so, skip over the codes
  JMP  C10           ;Keep going until we're done with our list
C50:                 ;We've found a match!
  POP  AX            ;Lose our original command line pointer
  DEC  BX            ;Point back at the end-of-word marker
C60:                 ;Loop to here to find the end-of-list
  MOV  AX,[BX]       ;Get the next two characters in our list
  INC  BX            ;Point at the next character for next time
  OR   AX,AX         ;Is this the start of our code list?
  JNE  C60           ;If not, keep looking
  INC  BX            ;If so, point at the character we're looking for
  MOV  DL,[BX]       ;Get the character from the Table
  CLC                ;Mark our OK flag
  JMP >C90           ;And we're done
C80:                 ;No match found
  STC                ;Mark us as no match
C90:                 ;We're done
  MOV  AX,DX         ;Set AX to the correct value
  POP  DX,BX         ;Restore used registers
  RET

CmpALBXNoCase:
  PUSH AX         ;Save used registers
  CALL Capitalize ;Capitalize AL
  MOV  AH,AL      ;Store it in AH
  MOV  AL,[BX]    ;Get [BX]
  CALL Capitalize ;Capitalize it
  CMP  AL,AH      ;Compare AL & [BX]
  POP  AX         ;Restore used registers
  RET

;------------------------------------------------------------------------------
;BEEP THE SPEAKER
;Inputs:
;Outputs: Beeps the speaker
;Changes:
;------------------------------------------------------------------------------
BeepErr:
  PUSH AX,BX    ;Save used registers
  XOR  BX,BX    ;BH = Video page = 0
  MOV  AX,0E07h ;AH = 0Eh = Function = Write TTY
                ;AL = 07h = Character to write = BEL
  INT  10h      ;Do it
  POP  BX,AX    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CAPITALIZE A CHARACTER (Byte)
;Inputs:  AL = character to be capitalized
;Outputs: AL = capitalized character
;Changes:
;------------------------------------------------------------------------------
Capitalize:
  CMP  AL,'a'     ;Is it less than 'a'?
  JB  >C90        ;If so, quit
  CMP  AL,'z'     ;Is it more than 'z'?
  JA  >C90        ;If so, quit
  SUB  AL,'a'-'A' ;If between 'a' and 'z', capitalize it
C90:
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO GET "SPECIAL" VALUES FROM THE COMMAND-LINE (INDENTS, ADDRESSES, ETC.)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;GET THE CALL BACK ADDRESS FROM THE COMMAND-LINE, IF THERE
;Inputs:  [SI] = Command-Line Pointer
;         CallBackAddr = -1
;         ParentIsShell
;Outputs: CF = Clear if OK (got a valid Address)
;                CallBackAddr = Address (converted to a number) if
;                                 ParentShell = No
;            = Set if Error (invalid address format)
;                CallBackAddr = -1 in Offset if none or invalid address,
;                                 or ParentIsShell = Yes,
;                                 or anything follows the address
;Changes: SI
;------------------------------------------------------------------------------
GetCallBackAddr:
  PUSH AX,BX,CX,ES          ;Save used registers
  MOV  CX,SI                ;Save original command-line pointer
  CMP  ParentIsShell,Yes    ;Are we being run from the command-line?
  JE  >C75                  ;If so, don't bother looking for a call-back addr
  CALL IsSpaceOrEOL         ;Skip over the spaces
  JZ  >C75                  ;If end-of-line, no Call-Back Address provided
  CALL GetSegmentOffset     ;Look for a Segment:Offset (returns CF, ES:BX)
  JC  >C75                  ;If none found, no call-back address provided
  CALL IsSpaceOrEOL         ;If valid, is there anything else following it?
  JNZ >C70                  ;If so, error
  MOV  W CallBackAddr[0],BX ;If everything's OK, store the Offset
  MOV  W CallBackAddr[2],ES ;Store the Segment
  JMP >C80                  ;Done
C70:                        ;Error
  MOV  ParseError,Yes       ;Mark as an Error
C75:                        ;No Address/Invalid format
  MOV  SI,CX                ;Restore original command-line pointer
  STC                       ;Set error flag
  JMP >C90                  ;Done
C80:                        ;OK
  CLC                       ;Set OK flag
C90:                        ;Done
  POP  ES,CX,BX,AX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE NEXT SERIES OF CHARACTERS, AND CONVERT THEM TO A SEGMENT:OFFSET
;Inputs:  [SI] = Command Line Pointer
;Outputs: CF = Clear if OK
;              ES:BX = Segment:Offset string converted to numbers
;            = Set if Error
;              ES:BX Unchanged
;Changes:
;------------------------------------------------------------------------------
GetSegmentOffset:
  PUSH AX,CX,DX     ;Save used registers
  MOV  CX,ES        ;Save original ES
  MOV  DX,BX        ;Save original BX
  CALL IsSpaceOrEOL ;Skip past the spaces
  JZ  >O70          ;If End of Line, Error
  CALL GetHex       ;Get the Segment
  JC  >O70          ;If error, quit
  MOV  ES,AX        ;If OK, store the Segment
  CALL IsSpaceOrEOX ;Skip over spaces
  JZ  >O70          ;If End of Line, Error
  CMP  AL,':'       ;Is it a Colon?
  JNZ >O70          ;If not, error
  CALL IsSpaceOrEOL ;Skip past the spaces
  JZ  >O70          ;If End of Line, Error
  CALL GetHex       ;Get the Offset
  JC  >O70          ;If error, quit
  MOV  BX,AX        ;If OK, store the Offset
  JMP >O80          ;Done
O70:                ;Error
  MOV  ES,CX        ;Restore original ES
  MOV  BX,DX        ;Restore original BX
  STC               ;Set error flag
  JMP >O90          ;Done
O80:                ;OK
  CLC               ;Set OK flag
O90:                ;Done
  POP  DX,CX,AX     ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO TRANSLATE A UNICODE STRING TO AN ASCII STRING
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;CONVERT A UNICODE STRING (16-bit Words) TO AN ASCII STRING, AND WRITE IT
;Inputs:  DS = Local Data Area
;         ES:[BX] = UniCode String
;Outputs: To String
;Changes:
;------------------------------------------------------------------------------
ProcessString:
  PUSH AX,BX,BP            ;Save used registers
  CALL TestEndian          ;Test Endian-ness (may change BX)
T10:                       ;Loop to here for each character
  CALL GetUTF16            ;Get the next character
;JC
  OR   BP,BP               ;Plane 0?
  JNZ >T20                 ;If not, continue
  OR   AX,AX               ;NUL (End of String)?
  JZ  >T90                 ;If so, we're done

;  MOV  AX,ES:[BX]          ;Get the next character from the UniCode String
;  INC  BX,2                ;Update the Pointer
;  OR   AX,AX               ;End-of-String?
;  JZ  >T90                 ;If so, we're done
;  TEST ProgFlags,BigEndian ;If valid character, are the characters Big-Endian?
;  JZ  >T20                 ;If not, continue
;  XCHG AL,AH               ;If so, make it Little-Endian
;T20:                       ;Endian-Ness Handled
T20:                       ;BP:AX = Character
  CALL ConvertChar         ;Convert and write the character
  JMP  T10                 ;Keep going until we're done
T90:                       ;Done
  POP  BP,BX,AX            ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST A UNICODE STRING FOR ENDIAN-NESS
;Inputs:  DS = Local Data Area
;         ES:[BX] = UniCode String (first Character)
;Outputs: ProgFlags.BigEndian
;           = Set if String is Big Endian
;               [BX] = Second Character of the String
;             Clear if Little Endian, or unknown (string not marked)
;Changes:
;NOTES: Some UniCode strings (but not all) use the first character as
;         and Endian-ness flag.  UniCode character FEFFh is a Zero-Width,
;         Non-Break Space (basically a legitimate UniCode character that
;         does nothing).  FFFEh (the bytes swapped) is guaranteed to never
;         be a legitimate UniCode character.  Therefore, if the first
;         character is FFFEh, we know it is in Big Endian format.
;       Testing for Endian-ness is probably not necessary in a DOS program,
;         but we'll do it anyway.
;------------------------------------------------------------------------------
TestEndian:
  CMP  W ES:[BX],0FEFFh    ;Little Endian Flag?
  JE  >E80                 ;If so, skip over it and quit
  CMP  W ES:[BX],0FFFEh    ;Big Endian Flag?
  JNE >E90                 ;If not, quit
  OR   ProgFlags,BigEndian ;If so, mark it as Big Endian
E80:                       ;Done, increment Pointer
  INC  BX,2                ;Skip over the first UniCode Character
E90:                       ;Done
  RET

;------------------------------------------------------------------------------
;CONVERT A UTF-32 ENCODED VALUE INTO A UNICODE CHARACTER VALUE
;Inputs:  DS = Local Data Area
;         ES:[BX] = UniCode String Pointer
;Outputs: CF = Clear if OK
;              BP:AX = UniCode Value
;            = Set if Error (Number too Big)
;              BP:AX = Undefined
;Changes: BX Updated Appropriately
;------------------------------------------------------------------------------
GetUTF32:
  MOV  AX,ES:[BX]          ;Get the first Word
  MOV  BP,ES:[BX+2]        ;Get the second word
  ADD  BX,4                ;Update Pointer
  TEST ProgFlags,BigEndian ;Big Endian?
  JZ  >W20                 ;If not, continue
  XCHG AL,AH               ;If so,
  XCHG AX,BP               ;  convert it
  XCHG AL,AH               ;  to Little Endian
W20:                       ;Endian-ness handled
  CMP  BP,0010h            ;Number too big?
  JBE >W80                 ;If not, it's OK
W70:                       ;Error (Number too Big)
  STC                      ;Set return flag
  JMP >W90                 ;Done
W80:                       ;OK
  CLC                      ;Set Return Flag
W90:                       ;Done
  RET

;------------------------------------------------------------------------------
;CONVERT A UTF-16 ENCODED VALUE INTO A UNICODE CHARACTER VALUE
;Inputs:  DS = Local Data Area
;         ES:[BX] = UniCode String Pointer
;Outputs: CF = Clear if OK
;              BP:AX = UniCode Value
;            = Set if Error (Illegal Surrogate Combination)
;              BP:AX = Undefined
;Changes: BX Updated Appropriately
;------------------------------------------------------------------------------
GetUTF16:
  PUSH CX,DX               ;Save used registers
  XOR  BP,BP               ;Start with BP = 0
  MOV  AX,ES:[BX]          ;Get the next Word
  INC  BX,2                ;Update Pointer
  TEST ProgFlags,BigEndian ;Big Endian?
  JZ  >X05                 ;If not, continue
  XCHG AL,AH               ;If so, convert the ends
X05:                       ;Endian-ness handled
  CMP  AX,0D800h           ;Surrogate?
  JB  >X80                 ;If not, we're done
  CMP  AX,0DFFFh           ;Surrogate?
  JA  >X80                 ;If not, we're done
X10:                       ;First Word is a Surrogate
  CMP  AX,0DBFFh           ;High Surrogate?
  JA  >X70                 ;If not, error
  MOV  CX,ES:[BX]          ;If so, get the Low Surrogate
  INC  BX,2                ;Update Pointer
  TEST ProgFlags,BigEndian ;Big Endian?
  JZ  >X15                 ;If not, continue
  XCHG CL,CH               ;If so, convert the ends
X15:                       ;Endian-ness handled
  CMP  CX,0DC00h           ;Low Surrogate?
  JB  >X70                 ;If not, error
  CMP  CX,0DFFFh           ;Low Surrogate?
  JA  >X70                 ;If not, error
X20:                       ;AX = Valid High Surrogate, CX = Valid Low Surrogate
  SUB  AX,0D800h           ;Get rid of
  SUB  CX,0DC00h           ;  Surrogate Base Offsets
  MOV  DX,400h             ;Multiply High Surrogate
  MUL  DX                  ;  by 400h
  ADD  AX,CX               ;Add the Low Surrogate
  ADC  DX,1                ;  and 10000h
  MOV  BP,DX               ;Put the High Word in BP
  JMP >X80                 ;Done
X70:                       ;Error (Illegal Surrogate Combination)
  STC                      ;Set return flag
  JMP >X90                 ;Done
X80:                       ;OK
  CLC                      ;Set Return Flag
X90:                       ;Done
  POP  DX,CX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CONVERT A UTF-8 ENCODED VALUE INTO A UNICODE CHARACTER VALUE
;Inputs:  DS = Local Data Area
;         ES:[BX] = UniCode String Pointer
;         CLD already issued
;Outputs: CF = Clear if OK
;              BP:AX = UniCode Value
;            = Set if Error
;              BP:AX = Undefined
;Changes: BX Updated Appropriately
;------------------------------------------------------------------------------
GetUTF08:
  PUSH BX,CX,SI,DS     ;Save used registers
  MOV  DS,ES           ;Point DS:[SI]
  MOV  SI,BX           ;  at the string
  XOR  BP,BP           ;Initialize Accumulator (BP:BX)
  XOR  BX,BX           ;  to 0
  LODSB                ;Get the next character
  MOV  BL,AL           ;Put it into the accumulator
  SHL  AL,1            ;Is it Pure ASCII or a Sequence Byte?
  JNC >E80             ;If Pure ASCII, we're done
  SHL  AL,1            ;Is it a Sequence-Initial or Non-Initial Byte?
  JNC >E60             ;If Non-Initial, Error (skip all Non-Initial Bytes)
  MOV  CH,1            ;Mark as needing at least one Non-Initial Byte
  MOV  CL,4            ;Allow a maximum of 4 more bits to be 1
E10:                   ;Is a Sequence-Initial Byte
  SHL  AL,1            ;Is the next bit a 1?
  JNC >E20             ;If not, we're done counting bits
  INC  CH              ;If so, increment the Non-Initial Byte Counter
  DEC  CL              ;Decrement the Loop Counter
  JNZ  E10             ;If not zero yet, keep checking
E15:                   ;Non-Initial Bytes = 5
  SHL  AL,1            ;Is the next bit a 0 (it should be)?
  JC  >E60             ;If not, Error
E20:                   ;CH = Non-Initial Byte Counter
  MOV  CL,CH           ;Put Non-Initial Byte Counter in CL
  ADD  CL,2            ;Convert to a Shift Count
  SHL  BL,CL           ;Get rid of the
  SHR  BL,CL           ;  bits we don't need
  CALL TestNonInitials ;Test remaining Sequence Bytes for validity
  JC  >E60             ;If invalid, error (skip over invalid bytes)
  CALL GetNonInitials  ;Add the Non-Initial Bytes to the Accumulator
  CALL TestSurrogate   ;Is it a Surrogate?
  JNC >E80             ;If not, it's OK
  JMP >E70             ;If so, error
E60:                   ;Error - Get rid of all Non-Initial Sequence bytes
  CALL SkipNonInitials ;SKip over all Non-Initial Bytes
E70:                   ;Error
  STC                  ;Set return flag
  JMP >E90             ;Done
E80:                   ;OK
  MOV  AX,BX           ;Put Low Word into AX
  CLC                  ;Set Return Flag
E90:                   ;Done
  MOV  BX,SI           ;Set return pointer
  POP  DS,SI,CX,BX     ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET RID OF ALL TRAILING NON-INITIAL SEQUENCE BYTES IN A UTF-8 SEQUENCE
;Inputs:  DS:[SI] = String Pointer to start at
;Outputs: [SI] = Pointer to next byte after the Non-Initial Sequence Bytes
;Changes:
;------------------------------------------------------------------------------
SkipNonInitials:
K10:
  TEST B [SI],80h ;Pure ASCII?
  JZ  >K90        ;If so, we're done
  TEST B [SI],40h ;Sequence-Initial byte?
  JNZ >K90        ;If so, we're done
  INC  SI         ;If not, skip over it
  JMP  K10        ;Keep looking
K90:              ;Done
  RET

;------------------------------------------------------------------------------
;TEST NON-INITIAL SEQUENCE BYTES FOR VALIDITY IN A UTF-8 SEQUENCE
;Inputs:  DS:[SI] = First Non-Initial Byte
;         CH = Number of Bytes to test
;         CLD already issued
;Outputs: CF = Clear if OK (All bytes are Non-Initial Sequence Bytes)
;            = Set if Error (at least one Byte is not Non-Initial Sequence
;Changes:
;------------------------------------------------------------------------------
TestNonInitials:
  PUSH AX,CX,SI ;Save used registers
T10:            ;Loop to here for each character
  LODSB         ;Get the next character
  AND  AL,0C0h  ;Get rid of lower 6 bits
  CMP  AL,80h   ;Is it a Non-Initial Byte?
  JNE >T70      ;If not, error
  DEC  CH       ;If OK, decrement the Loop Counter
  JNZ  T10      ;If not done yet, keep testing
  JMP >T80      ;If done, quit
T70:            ;Error
  STC           ;Set return flag
  JMP >T90      ;Done
T80:            ;OK
  CLC           ;Set return flag
T90:            ;Byte Sequence is valid
  POP  SI,CX,AX ;Restore used registers
  RET

;------------------------------------------------------------------------------
;ADD THE NON-INITIAL BYTE VALUES TO THE ACCUMULATOR TOTAL
;Inputs:  DS:[SI] = First Non-Initial Byte
;         CH = Nuumber of Bytes to Get
;         BP:BX = Initialized Accumulator
;         CLD already issued
;Outputs: BP:BX = New Total
;         [SI] updated (points at next byte after the Sequence)
;Changes:
;------------------------------------------------------------------------------
GetNonInitials:
  PUSH AX,CX  ;Save used registers
G10:          ;Loop to here for each character
  LODSB       ;Get the next character
  AND  AL,3Fh ;Get rid of flag bytes
  MOV  CL,6   ;Need to process 6 bits
  SHL  AL,1   ;Move the bits over
  SHL  AL,1   ;  so we can use them
G20:          ;Loop to here for each bit
  SHL  BP,1   ;Shift the high word
  SHL  BX,1   ;Shift the Low Word
  JNC >G30    ;If no carry bit, leave high word alone
  INC  BP     ;If carry bit, increment the high word
G30:          ;Low bit of high word handled
  SHL  AL,1   ;Need to increment the low word?
  JNC >G40    ;If not, continue
  INC  BX     ;If so, increment it
G40:          ;Low bit of low word handled
  DEC  CL     ;Decrement Bit (Inner Loop) Counter
  JNZ  G20    ;If not 0 yet, keep Accumulating Bits
  DEC  CH     ;Decrement Byte (Outer Loop) Counter
  JNZ  G10    ;If not 0 yet, keep Accumulating Bytes
  POP  CX,AX  ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST A UNICODE CHARACTER TO SEE IF IT'S A SURROGATE OR NOT
;Inputs:  BP:BX = UNICODE CHARACTER
;Outputs: CF = Set if it is a Surrogate
;            = Clear if not a Surrogate
;         [SI] updated (points at next byte after the Sequence)
;Changes:
;------------------------------------------------------------------------------
TestSurrogate:
  OR   BP,BP     ;Plane 0?
  JNZ >S80       ;If so, we're done
  CMP  BX,0B800h ;Surrogate?
  JB  >S80       ;If not, we're done
  CMP  BX,0BFFFh ;Surrogate?
  JA  >S80       ;If not, we're done
S70:             ;Error
  STC            ;Set return flag
  JMP >S90       ;Done
S80:             ;OK
  CLC            ;Set return flag
S90:             ;Done
  RET



;------------------------------------------------------------------------------
;CONVERT A UNICODE CHARACTER (WORD) TO ASCII AND WRITE IT TO THE SCREEN
;Inputs:  DS = Local Data Area
;         BP:AX = Character to Convert & Write
;                  (already Endian-handled, if required)
;Outputs: To Screen
;Changes:
;NOTES: Some UniCode characters are written as multiple ASCII characters.
;       UniCode characters that cannot be translated properly are written
;         as the Hex Code surrounded by curly brackets.
;------------------------------------------------------------------------------
ConvertChar:
  PUSH BX,DX                ;Save used registers
  CALL HandleASCII          ;Handle Standard ASCII Characters
  JNC >C901                 ;If so, we're done
  CALL HandleControl        ;Handle Control Characters
  JNC >C901                 ;If so, we're done
  CALL HandleIllegal        ;Handle Illegal Characters
  JNC >C901                 ;If so, we're done
  CALL HandleSpecial        ;Handle Unknown/Unused/Reserved/Private/Surrogate
  JNC >C901                 ;If so, we're done
  CALL HandleCodePage       ;Handle Code Page-specific Characters
  JNC >C901                 ;If so, we're done
  CALL HandleStandard       ;Handle "Standard" Characters (Xlate to ASCII 0-7Fh)
  JNC >C901                 ;If so, we're done
  CALL HandleVariation      ;Handle Variation Selectors
  JNC >C901                 ;If so, we're done
  CALL HandleTag            ;Handle Tags
  JNC >C901                 ;If so, we're done
  CALL HandleString         ;Handle Strings
  JNC >C901                 ;If so, we're done
C20:                        ;Test for Characters that Xlate to "Special" Strings
  OR   BP,BP                ;Plane 0?
  JNZ >C60                  ;If not, just write the number
  MOV  BX,ParenCharTbl00    ;Test for
  CALL SearchWord2ByteTbl   ;  a Parenthesized Character
  JC  >C25                  ;If not, try the next possibility
  CALL WriteParenLeft       ;If so, write a Left Parentheses
  CALL WriteCharBX          ;Write the Character
  CALL WriteParenRight      ;Write a Right Parentheses
  JMP >C90                  ;Done
C25:                        ;Not a Parenthesized Character
  MOV  BX,ParenStringTbl00  ;Test for
  CALL SearchWord2StringTbl ;  a Parenthesized Character
  JC  >C30                  ;If not, try the next possibility
  CALL WriteParenLeft       ;If so, write a Left Parentheses
  CALL WriteItBX            ;Write the String
  CALL WriteParenRight      ;Write a Right Parentheses
C901:                       ;To avoid JMP >128
  JMP >C90                  ;Done
C30:                        ;Not a Parenthesized String
  MOV  BX,DblParenCharTbl00 ;Test for
  CALL SearchWord2ByteTbl   ;  a Double Parenthesized Character
  JC  >C35                  ;If not, try the next possibility
  CALL WriteParenLeft       ;If so, write two
  CALL WriteParenLeft       ;  Left Parentheses
  CALL WriteCharBX          ;Write the Character
  CALL WriteParenRight      ;Write two
  CALL WriteParenRight      ;  Right Parentheses
  JMP >C90                  ;Done
C35:                        ;Not a Double Parenthesized Character
  MOV  BX,DotCharTbl00      ;Test for
  CALL SearchWord2ByteTbl   ;  a Periodized Charactrer
  JC  >C40                  ;If not, try the next possibility
  CALL WriteCharBX          ;If so, write the Character
  CALL WriteDot             ;Write a Dot
  JMP >C90                  ;Done
C40:                        ;Not a Periodized Character
  MOV  BX,DotStringTbl00    ;Test for
  CALL SearchWord2StringTbl ;  a Periodized String
  JC  >C60                  ;If not, try the next possibility
  CALL WriteItBX            ;If so, write the String
  CALL WriteDot             ;Write a Dot
  JMP >C90                  ;Done
C60:                        ;Not a Directly Translatable Character
  CALL WriteUniChar         ;Write the UniCode Character Prefix
;  CALL WriteWordHex         ;Write the UniCode Number
  CALL WriteDWordMinHex     ;Write the UniCode Number
  CALL WriteCurlyRight      ;Write a Right Curly Bracket
C90:                        ;Done
  POP  DX,BX                ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SUPPORT CODE TO SEARCH THROUGH AND/OR PRINT ONE OF THE LOOKUP TABLES
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;TEST AND HANDLE A UNICODE CHARACTER IF IT'S STANDARD ASCII
;Inputs:  DS = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Set if Character is Standard ASCII
;              Writes Character
;            = Clear if Character is not Standard ASCII
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleASCII:
  OR   BP,BP   ;Plane 0?
  JNZ >A70     ;If not, it can't be Standard ASCII
  OR   AH,AH   ;Anything in the high byte?
  JNZ >A70     ;If so, it can't be Standard ASCII
  CMP  AL,20h  ;Standard ASCII?
  JB  >A70     ;If not, we're done
  CMP  AL,7Eh  ;Standard ASCII?
  JBE >A80     ;If so, handle it
A70:           ;Error (not Standard ASCII)
  STC          ;Set return flag
  JMP >A90     ;Done
A80:           ;OK (is Standard ASCII)
  CALL WriteAL ;Write it
  CLC          ;Set return flag
A90:           ;Done
  RET

;------------------------------------------------------------------------------
;TEST AND HANDLE A UNICODE CHARACTER IF IT'S A CONTROL CHARACTER
;Inputs:  DS = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Set if Character is a Control Character
;              Writes Correct Description String
;            = Clear if Character is not a Control Character
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleControl:
  PUSH BX,DX                ;Save used registers
  OR   BP,BP                ;Plane 0?
  JNZ >C70                  ;If not, we're done
  MOV  BX,ControlTbl00      ;Test for
  CALL SearchWord2StringTbl ;  a Control Character
  JC  >C70                  ;If not, we're done
C10:                        ;Is a Control Character
  MOV  DX,BX                ;If so, point [DX] at the description
  CMP  AX,2400h             ;Is it an Actual Control Char or just a Descr?
  JB  >C30                  ;If an actual Control Char, jump to handle it
  CMP  AX,2421h             ;Is it an Actual Control Char or just a Descr?
  JA  >C30                  ;If an actual Control Char, jump to handle it
C20:                        ;Is just a Control Characer Description
  CALL WriteItDX            ;Write the Description with no Brackets
  JMP >C90                  ;Done
C30:                        ;Is an Actual Control Char
  CALL WriteCurlyString     ;Write it
  JMP >C80                  ;Done
C70:                        ;Error (not a Control Character)
  STC                       ;Set return flag
  JMP >C90                  ;Done
C80:                        ;OK (is a Control Character)
  CLC                       ;Set return flag
C90:                        ;Done
  POP  BX,DX                ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST AND HANDLE A UNICODE CHARACTER IF IT'S ILLEGAL (NOT A CHARACTER)
;Inputs:  DS = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Set if Character is Illegal
;              Writes Correct Description String
;            = Clear if Character is not Illegal
;              Writes Nothing
;Changes:
;NOTES: We don't need to build lookup tables for this, since there are only
;         a limited number of illegal characters and they follow a
;         distinct, easy-to-program pattern.
;------------------------------------------------------------------------------
HandleIllegal:
  PUSH DX               ;Save used registers
  CMP  AX,0FFFEh        ;Is it a "Universal" Illegal Character?
  JAE >I80              ;If so, handle it
  CMP  BP,10h           ;Is the high word too big to be legal?
  JA  >I80              ;If so, it's Illegal
  OR   BP,BP            ;If not, is the high DWord 0?
  JNZ >I70              ;If not, it's not Illegal
  CMP  AX,0FDD0h        ;Is it a Plane 0 Illegal Character?
  JB  >I70              ;If not, it's not Illegal
  CMP  AX,0FDEFh        ;Is it a Plane 0 Illegal Character?
  JBE >I80              ;If so, handle it
I70:                    ;Error (not an Illegal Character)
  STC                   ;Set return flag
  JMP >I90              ;Done
I80:                    ;OK (is an Illegal Character)
  MOV  DX,IllegalMsg    ;Point at the Illegal Description Message
  CALL WriteCurlyString ;Write the Number and Description
  CLC                   ;Set return flag
I90:                    ;Done
  POP  DX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PROCESS A UNICODE CHARACTER IF IT'S UNUSED/PRIVATE/RESERVED/ETC.
;Inputs:  DS    = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Clear if OK (Conversion was performed)
;              Character is written to the screen
;            = Set if error (Character not Converted)
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleSpecial:
  PUSH BX,DX                  ;Save used registers
  MOV  DX,UnusedMsg           ;Assume Unused
  CALL TestUnused             ;Is it Unused?
  JNC >P80                    ;If so, handle it
  MOV  DX,ReservedMsg         ;Assume Reserved
  CALL TestReserved           ;Is it Reserved?
  JNC >P80                    ;If so, handle it
  MOV  DX,UnknownMsg          ;Assume Unknown
  CALL TestUnknown            ;Is it Unknown?
  JNC >P80                    ;If so, handle it
P10:                          ;Test Private
  MOV  DX,PrivateMsg          ;Assume Private
  OR   BP,BP                  ;Plane 0?
  JNE >P20                    ;If not, try other possibilities
  CMP  AX,0E000h              ;Private?
  JB  >P50                    ;If not, it's not Private
  CMP  AX,0F8FFh              ;Private?
  JBE >P80                    ;If so, handle it
P20:                          ;Test Private Plane 0Fh
  CMP  BP,0000Fh              ;Plane 0Fh?
  JE  >P30                    ;If so, handle it
  CMP  BP,00010h              ;Plane 10h?
  JNE >P50                    ;If not, try other possibilities
P30:                          ;Plane 0Fh or 10h
  CMP  AX,0FFFDh              ;Private?
  JBE >P80                    ;If so, handle it
P50:                          ;Test Surrogate
  OR   BP,BP                  ;Plane 0?
  JNZ >P70                    ;If not, it can't be a Surrogate
  MOV  DX,SurrogateMsg        ;Assume Surrogate
  MOV  BX,SurrogateRangeTbl00 ;Is it
  CALL SearchWordRangeTbl     ;  Surrogate?
  JNC >P80                    ;If so, handle it
P70:                          ;Error (no match)
  STC                         ;Set return flag
  JMP >P90                    ;Done
P80:                          ;OK (found a match)
  CALL WriteCurlyString       ;Write it
  CLC                         ;Set return flag
P90:                          ;Done
  POP  DX,BX                  ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PROCESS A UNICODE CHARACTER IF IT'S "STANDARD"
;Inputs:  DS    = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Clear if OK (Conversion was performed)
;              Character is written to the screen
;            = Set if error (Character not Converted)
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleStandard:
  PUSH BX                 ;Save used registers
  CMP  BP,1               ;Which Plane?
  JB  >S00                ;If Plane 0, jump to handle it
  JE  >S10                ;If Plane 1, jump to handle it
  CMP  BP,2               ;Is it Plane 2?
  JE  >S20                ;If so, jump to handle it
  JMP >S70                ;If none of these, Error
S00:                      ;Plane 0
  MOV  BX,StandardTbl00   ;Test for
  CALL SearchWord2ByteTbl ;  a "Standard" Character
  JNC >S80                ;If so, we're done
  JMP >S70                ;If not, it's not Standard
S10:                      ;Plane 1
  MOV  BX,StandardTbl01   ;Test for
  CALL SearchWord2ByteTbl ;  a "Standard" Character
  JNC >S80                ;If so, we're done
  JMP >S70                ;If not, it's not Standard
S20:                      ;Plane 2
  MOV  BX,StandardTbl02   ;Test for
  CALL SearchWord2ByteTbl ;  a "Standard" Character
  JNC >S80                ;If so, we're done
S70:                      ;Error (not a "Standard" Character)
  STC                     ;Set return flag
  JMP >S90                ;Done
S80:                      ;OK (is a "Standard" Character)
  CALL WriteCharBX        ;Write the Character
  CLC                     ;Set return flag
S90:                      ;Done
  POP  BX                 ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PROCESS A UNICODE CHARACTER IF IT'S A VARIATION SELECTOR
;Inputs:  DS    = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Clear if Character is a Variation Selector
;              Character is written to the screen
;            = Set if Character is not a Variation Selector
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleVariation:
  PUSH AX,DX           ;Save used registers
  CMP  BP,0000Eh       ;Plane E?
  JE  >V30             ;If so, jump to handle it
  OR   BP,BP           ;Plane 0?
  JNE >V70             ;If not, we're done
V10:                   ;Plane 0
  CMP  AH,0FEh         ;Variation Selector?
  JB  >V70             ;If not, we're done
  CMP  AL,00Fh         ;Variation Selector?
  JA  >V70             ;If not, we're done
V15:                   ;Is a Plane 0 Variation Selector
  SUB  AX,(0FE00h-1)   ;Convert AX to a Selector Number
  JMP >V50             ;COntinue
V30:                   ;Plane E
  CMP  AH,01h          ;Variation Selector?
  JNE >V70             ;If not, we're done
  CMP  AL,0EFh         ;Variation Selector?
  JA  >V70             ;If not, we're done
V35:                   ;Is a Plane E Variation Selector
  SUB  AX,(100h-17)    ;Convert AX to a Selector Number
V50:                   ;AX = Selector Number
  MOV  DX,VariationMsg ;Write the
  CALL WriteItDX       ;  Header
  CALL WriteWordMin    ;Write the Selector Number
  CALL WriteCurlyRight ;Write the Footer
  JMP >V80             ;Done
V70:                   ;Error (not a Variatioon Selector)
  STC                  ;Set return flag
  JMP >V90             ;Done
V80:                   ;OK (is a Variation Selector)
  CLC                  ;Set return flag
V90:                   ;Done
  POP  DX,AX           ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PROCESS A UNICODE CHARACTER IF IT'S A TAG
;Inputs:  DS    = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Clear if Character is a Tag
;              Character is written to the screen
;            = Set if Character is not a Tag
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleTag:
  PUSH AX,BX,DX        ;Save used registers
  CMP  BP,0000Eh       ;Plane E?
  JNE >T70             ;If not, we're done
  OR   AH,AH           ;Tag?
  JNZ >T70             ;If not, we're done
  MOV  DX,TagMsg       ;Point at the Header
  MOV  BX,LanguageMsg  ;Assume Language Tag
  CMP  AL,1            ;Language Tag?
  JE  >T20             ;If so, handle it
  MOV  BX,SpaceWMsg    ;Assume Space Tag
  CMP  AL,20h          ;Space Tag?
  JB  >T70             ;If not, we're done
  JE  >T20             ;If so, handle it
  MOV  BX,CancelMsg    ;Assume Cancel Tag
  CMP  AL,07Fh         ;Cancel Tag?
  JA  >T70             ;If not, we're done
  JB  >T30             ;If not, continue
T20:                   ;Tag requires a written descriptor
  CALL WriteItDX       ;Write the Header
  CALL WriteItBX       ;Write the Description
  JMP >T80             ;Done
T30:                   ;Tag uses a single character
  CALL WriteItDX       ;Write the Header
  CALL WriteAL         ;Write the Character
  JMP >T80             ;Done
T70:                   ;Error (not a Variation Selector)
  STC                  ;Set return flag
  JMP >T90             ;Done
T80:                   ;OK (is a Variation Selector)
  CALL WriteCurlyRight ;Write the Footer
  CLC                  ;Set return flag
T90:                   ;Done
  POP  DX,BX,AX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PROCESS A UNICODE CHARACTER IF IT'S A STRING
;Inputs:  DS    = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Clear if Character is a Tag
;              Character is written to the screen
;            = Set if Character is not a Tag
;              Writes Nothing
;Changes:
;------------------------------------------------------------------------------
HandleString:
  PUSH BX                   ;Save used registers
  MOV  BX,StringTbl00       ;Assume Plane 0
  CMP  BP,1                 ;Which Plane is it?
  JB  >S30                  ;If Plane 0, continue
  MOV  BX,StringTbl01       ;Assume Plane 1
  JE  >S30                  ;If Plane 1, continue
  MOV  BX,StringTbl02       ;Assume Plane 2
  CMP  BP,2                 ;Is it Plane 2?
  JA  >S70                  ;If none of these, Error
S30:                        ;[BX] = String Table to Search
  CALL SearchWord2StringTbl ;Search the Table
  JNC  >S80                 ;If so, write it
S70:                        ;Error (not a Variatioon Selector)
  STC                       ;Set return flag
  JMP >S90                  ;Done
S80:                        ;OK (is a Variation Selector)
  CALL WriteItBX            ;Write the String
  CLC                       ;Set return flag
S90:                        ;Done
  POP  BX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST A UNICODE CHARACTER TO SEE IF IT'S UNUSED
;Inputs:  DS = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Set if Character is Unused
;            = Clear if Character is not Illegal
;Changes:
;------------------------------------------------------------------------------
TestUnused:
  PUSH BX                   ;Save used registers
  OR   BP,BP                ;Plane 0?
  JNZ >U10                  ;If not, handle other possibilities
U00:                        ;Plane 0
  MOV  BX,UnusedSingleTbl00 ;Is it
  CALL SearchWordTbl        ;  Unused?
  JNC >U80                  ;If so, handle it
  MOV  BX,UnusedRangeTbl00  ;Is it
  CALL SearchWordRangeTbl   ;  Unused?
  JNC >U80                  ;If so, handle it
  JMP >U70                  ;If not, we're done
U10:                        ;Not Plane 0
  CMP  BP,1                 ;Plane 1?
  JNE >U20                  ;If not, handle other possibilities
  MOV  BX,UnusedSingleTbl01 ;Is it
  CALL SearchWordTbl        ;  Unused?
  JNC >U80                  ;If so, handle it
  MOV  BX,UnusedRangeTbl01  ;Is it
  CALL SearchWordRangeTbl   ;  Unused?
  JNC >U80                  ;If so, handle it
  JMP >U70                  ;If not, we're done
U20:                        ;Not Plane 1
  CMP  BP,2                 ;Plane 2?
  JNE >U30                  ;If not, handle other possibilities
  MOV  BX,UnusedRangeTbl02  ;Is it
  CALL SearchWordRangeTbl   ;  Unused?
  JNC >U80                  ;If so, handle it
  JMP >U70                  ;If not, we're done
U30:                        ;Not Plane 2
  CMP  BP,0000Eh            ;Plane 0Eh?
  JNE >U40                  ;If not, handle other possibilities
  MOV  BX,UnusedRangeTbl0E  ;Is it
  CALL SearchWordRangeTbl   ;  Unused?
  JNC >U80                  ;If so, handle it
  JMP >U70                  ;If not, we're done
U40:                        ;Not Plane 0Eh
  CMP  BP,0Fh               ;Is it Plane 0Fh or 10h?
  JAE >U70                  ;If so, there are no unused characters
U50:                        ;Not a "Special" Plane
  CMP  AX,0FF80h            ;Too small to be Unused?
  JB  >U70                  ;If so, it's not Unused
  CMP  AX,0FFFDh            ;Too big to be Unused?
  JBE >U80                  ;If not, it's Unused
U70:                        ;Error (not an Unused Character)
  STC                       ;Set return flag
  JMP >U90                  ;Done
U80:                        ;OK (is an Unused Character)
  CLC                       ;Set return flag
U90:                        ;Done
  POP  BX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST A UNICODE CHARACTER TO SEE IF IT'S RESERVED
;Inputs:  DS = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Set if Character is Reserved
;            = Clear if Character is not Reserved
;Changes:
;------------------------------------------------------------------------------
TestReserved:
  PUSH BX                     ;Save used registers
  OR   BP,BP                  ;Plane 0?
  JNZ >V10                    ;If not, handle other possibilities
V00:                          ;Plane 0
  MOV  BX,ReservedSingleTbl00 ;Is it
  CALL SearchWordTbl          ;  Reserved?
  JNC >V80                    ;If so, handle it
  MOV  BX,ReservedRangeTbl00  ;Is it
  CALL SearchWordRangeTbl     ;  Reserved?
  JNC >V80                    ;If so, handle it
  JMP >V70                    ;If not, we're done
V10:                          ;Not Plane 0
  CMP  BP,1                   ;Plane 1?
  JNE >V70                    ;If not, we're done
  MOV  BX,ReservedSingleTbl01 ;Is it
  CALL SearchWordTbl          ;  Reserved?
  JNC >V80                    ;If so, handle it
  MOV  BX,ReservedRangeTbl01  ;Is it
  CALL SearchWordRangeTbl     ;  Reserved?
  JNC >V80                    ;If so, handle it
V70:                          ;Error (not a Reserved Character)
  STC                         ;Set return flag
  JMP >V90                    ;Done
V80:                          ;OK (is a Reserved Character)
  CLC                         ;Set return flag
V90:                          ;Done
  POP  BX                     ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST A UNICODE CHARACTER TO SEE IF IT'S UNKNOWN
;Inputs:  DS = Local Data Area
;         BP:AX = UniCode Character to Test
;Outputs: CF = Set if Character is Unknown
;            = Clear if Character is not Unknownd
;Changes:
;------------------------------------------------------------------------------
TestUnknown:
  PUSH BX                   ;Save used registers
  OR   BP,BP                ;Plane 0?
  JNZ >K10                  ;If not, handle other possibilities
K00:                        ;Plane 0
  MOV  BX,UnknownRangeTbl00 ;Is it
  CALL SearchWordRangeTbl   ;  Unkown?
  JNC >K80                  ;If so, handle it
  JMP >K70                  ;If not, we're done
K10:                        ;Not Plane 0
  CMP  BP,1                 ;Plane 1?
  JNE >K20                  ;If not, handle other possibilities
  MOV  BX,UnknownRangeTbl01 ;Is it
  CALL SearchWordRangeTbl   ;  Unknown?
  JNC >K80                  ;If so, handle it
  JMP >K70                  ;If not, we're done
K20:                        ;Not Plane 1
  CMP  BP,2                 ;Plane 2?
  JNE >K30                  ;If not, handle other possibilities
  MOV  BX,UnknownRangeTbl02 ;Is it
  CALL SearchWordRangeTbl   ;  Unknown?
  JNC >K80                  ;If so, handle it
  JMP >K70                  ;If not, we're done
K30:
  CMP  BP,0Eh               ;Plane E?
  JNE >K40                  ;If not, handle other possibilities
  MOV  BX,UnknownRangeTbl0E ;Is it
  CALL SearchWordRangeTbl   ;  Unknown?
  JNC >K80                  ;If so, handle it
  JMP >K70                  ;If not, we're done
K40:
  CMP  BP,0Fh               ;Plane 0Fh or 10h?
  JAE >K70                  ;If so, there are no unknown characters
K50:                        ;Not a "Special" Plane
  MOV  BX,0FF7Fh            ;Assume Planes 3h-Dh
  CMP  BP,0Dh               ;Planes 3h-Dh?
  JBE >K55                  ;If so, continue
  MOV  BX,0FFFDh            ;All other Planes
K55:                        ;BX contains Generic Unknown High Range
  CMP  AX,BX                ;Is it Unknown?
  JBE >K80                  ;If so, handle it
K70:                        ;Error (not an Unknown Character)
  STC                       ;Set return flag
  JMP >K90                  ;Done
K80:                        ;OK (is an Unknown Character)
  CLC                       ;Set return flag
K90:                        ;Done
  POP  BX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PROCESS A UNICODE CHARACTER LOOKING FOR A CODE PAGE-SPECIFIC CONVERSION
;Inputs:  AX = UniCode Character
;         DS = Local Data Area
;         CodePage already filled in (current DOS Code Page)
;Outputs: CF = Clear if OK (Conversion was performed)
;              Character is written to the screen
;            = Set if error (Character not Converted)
;Changes:
;------------------------------------------------------------------------------
HandleCodePage:
  PUSH AX,BX,SI           ;Save used registers
  MOV  SI,CodePageTbl00   ;Assume Plane 0
  CMP  BP,1               ;Which Plane is it?
  JB  >P10                ;If Plane 0, jump to handle it
  MOV  SI,CodePageTbl01   ;Assume Plane 1
  JE  >P10                ;If Plane 1, jump to handle it
  MOV  SI,CodePageTbl02   ;Assume Plane 2
  CMP  BP,2               ;Is it Plane 2?
  JNE >P70                ;If not, Error
P10:                      ;[SI] = Code Page Table
  MOV  BX,CodePage        ;BX = Current DOS Code Page
P20:                      ;Loop to here for each Table Entry
  CMP  W [SI],-1          ;End of the Table?
  JE  >P70                ;If so, error
  CMP  BX,[SI]            ;Is it the Code Page we're looking for?
  JE  >P30                ;If so, handle it
  ADD  SI,4               ;If not, point at the next table entry
  JMP  P20                ;Keep looking
P30:                      ;Found a Code Page match
  MOV  BX,[SI+2]          ;Point [BX] at the Code Page conversion Table
  CALL SearchWord2ByteTbl ;Look for the Unicode character in the Table
  JNC >P80                ;If it's there, jump to handle it
P70:                      ;Error (Character not found)
  STC                     ;Set return flag
  JMP >P90                ;Done
P80:                      ;OK (Character found)
  CALL WriteCharBX        ;Write the Translated Character
  CLC                     ;Set return flag

;  call WriteSpace
;  call WriteSpace
;  stc

P90:                      ;Done
  POP  SI,BX,AX           ;Restore used registers
  RET

;------------------------------------------------------------------------------
;WRITE A CHARACTER AND DESCRIPTION STRING SURROUNDED BY CURLY BRACKETS
;Inputs:   DS    = Local Data Area
;          BP:AX = Unicode Character to Write
;         [DX]   = Description String to Write
;Outputs: To Screen
;CHanges:
;------------------------------------------------------------------------------
WriteCurlyString:
  CALL WriteCurlyLeft   ;Write the Left Curly Bracket
  CALL WriteDWordMinHex ;Write the Number (Minimum Length)
  CALL WriteEquals      ;Write an Equals
  CALL WriteItDX        ;Write the Description
  CALL WriteCurlyRight  ;Write the Right Curly Bracket
  RET

;------------------------------------------------------------------------------
;SEARCH THROUGH A WORD-TO-BYTE OR WORD-TO-STRING TABLE FOR A MATCH
;Inputs:  CS = Local Data Area
;         AX = Word to find in the Table
;         CS:[BX] = Table to Search
;         CLD already issued
;Outputs: CF = Clear if OK (Found in the Table)
;             [BX] = Pointer to Character or String
;            = Set if Error (Not Found in the Table)
;              BX = Unchanged
;Changes:
;------------------------------------------------------------------------------
SearchWord2ByteTbl:
  PUSH CX        ;Save used registers
  XOR  CL,CL     ;Mark as a Byte Search
  JMP >Y00       ;Do it
SearchWord2StringTbl:
  PUSH CX        ;Save used registers
  MOV  CL,-1     ;Mark as a String Search
;  JMP >Y00       ;Do it
Y00:
  PUSH AX,DX,SI  ;Save used registers
  PUSH DS        ;Save used registers
  MOV  DX,AX     ;Save original AX
  MOV  DS,CS     ;Point DS:[SI]
  MOV  SI,BX     ;  at the Table
Y10:             ;Loop to here for each Table Entry
  CMP  W [SI],-1 ;End of the Table?
  JE  >Y70       ;If so, we're done
Y20:             ;Loop to here for each Wword in the Table Entry
  LODSW          ;Get the next Word from the Table
  CMP  AX,-1     ;Is it the end of the Table Entry?
  JZ  >Y30       ;If so, handle it
  CMP  AX,DX     ;Is it the one we're looking for?
  JE  >Y40       ;If so, handle it
  JMP  Y20       ;If not, keep looking
Y30:             ;Not in this entry
  LODSB          ;Get the first byte (of the string)
  OR  CL,CL      ;Are we doing a Byte or a String?
  JZ  Y10        ;If a Byte, we're done with this entry
  OR  AL,AL      ;If a String, is it the end of the string?
  JNZ Y30        ;If not, keep looking
  JMP  Y10       ;Keep looking
Y40:             ;It's a match!
  LODSW          ;Find the
  CMP  AX,-1     ;  last word of
  JNE  Y40       ;  the Table Entry
  MOV  BX,SI     ;Point [BX] at the Byte or String
  JMP >Y80       ;Done
Y70:             ;Error (not found)
  STC            ;Set return flag
  JMP >Y90       ;Done
Y80:             ;OK
  CLC            ;Set return flag
Y90:             ;Done
  POP  DS        ;Restore used registers
  POP  SI,DX,AX  ;Restore used registers
  POP  CX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;SEARCH THROUGH A WORD OR WORD-RANGE TABLE FOR A MATCH
;Inputs:   AX = Word to find in the Table
;         [BX] = Table to Search
;          CLD already issued
;Outputs: CF = Clear if OK (Found in the Table)
;            = Set if Error (Not Found in the Table)
;Changes:
;------------------------------------------------------------------------------
SearchWordRangeTbl:
  PUSH CX        ;Save used registers
  MOV  CL,-1     ;Mark as Ranges
  JMP >G00       ;Do it
SearchWordTbl:
  PUSH CX        ;Save used registers
  XOR  CL,CL     ;Mark as single entries
;  JMP >G00       ;Do it
G00:
  PUSH SI        ;Save used registers
  MOV  SI,BX     ;  at the Table
G10:             ;Loop to here for each Table Entry
  CMP  W [SI],-1 ;End of the Table?
  JE  >G70       ;If so, no match
  OR   CL,CL     ;Doing Ranges or Single Values?
  JNZ >G30       ;If Ranges, jump to handle it
G20:             ;Doing Single Values
  CMP  AX,[SI]   ;Is it a match?
  JNE >G40       ;If not, continue
  JMP >G80       ;If so, it's a match
G30:             ;Doing Ranges
  INC  SI,2      ;Point at the upper word of the range
  CMP  AX,[SI-2] ;Is it below our range?
  JB  >G40       ;If so, no match
  CMP  AX,[SI]   ;Is it within our range?
  JBE >G80       ;If so, it's a match
G40:             ;Done with this Table Entry
  INC  SI,2      ;Point at the next Table Entry
  JMP  G10       ;Keep searching
G70:             ;Error (not in Table)
  STC            ;Set return flag
  JMP >G90       ;Done
G80:             ;OK (in Table)
  CLC            ;Set return flag
G90:             ;Done
  POP  SI        ;Restore used registers
  POP  CX        ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO TEST THE COMPUTER FOR MINIMUM COMPATIBILITY (DOS VERSION, ETC)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;TEST THE COMPUTER TO SEE IF IT'S COMPATIBLE (CPU, DOS VERSION, WHATEVER)
;Inputs:  InMemory
;Outputs: Quits the program if Computer is Incompatible
;         Returns if Computer is OK
;         Stores all kinds of values in memory variables
;Changes:
;------------------------------------------------------------------------------
TestCompatibility:
  PUSH AX,DX          ;Save used registers
  MOV  AL,ErLvlDOSVer ;Assume incorrect
  MOV  DX,DOSVerMsg   ;  DOS Version
  CALL TestDOSVer     ;  new enough?
  JNC >C90            ;If not, quit
C70:                  ;The computer is incompatible for some reason
  JMP  Exit           ;Quit!
C90:                  ;The computer is compatible!
  POP  DX,AX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;TEST THE CURRENT DOS VERSION
;Inputs:  MinDOSVer (EQUate)
;Outputs: CF = Clear if DOS version >= MinDOSVer
;         CF = Set if DOS version < MinDOSVer
;Changes:
;------------------------------------------------------------------------------
TestDOSVer:
  PUSH AX,BX,CX     ;Save used registers
  MOV  AX,3000h     ;Service 30h (get DOS version number)
                    ;  DOS 5.0 requires AL = 00h, may change BX and CX
  INT  21h          ;Do it (Returns AL= Major, AH = Minor)
  XCHG AL,AH        ;Swap Major and Minor versions for testing
  CMP  AX,MinDOSVer ;Is the version new enough?
  JAE >D80          ;If so, it's OK
D70:                ;DOS is older than the minimum
  STC               ;Set the "too old" flag
  JMP >D90          ;We're done
D80:                ;DOS is >= the minimum
  CLC               ;Set the OK flag
D90:                ;We're done
  POP  CX,BX,AX     ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO WRITE STRINGS AND NUMBERS TO THE SCREEN
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;WRITE THE CONTENTS OF A WORD OR DWORD IN THE MINIMUM SPACE POSSIBLE (AS HEX)
;Inputs:  AL/AX/BP:AX = Byte/Word/DWord to Write
;Outputs: Writes to Screen
;Changes:
;NOTES: This writes a Byte, Word, or DWord, whichever is appropriate
;------------------------------------------------------------------------------
WriteDWordMinHex:
  OR   BP,BP           ;More than a Word can handle?
  JZ  >M30             ;If not, just handle it as a word
  TEST BP,0FF00h       ;Anything in the high byte?
  JNZ >M20             ;If so, write the whole DWord
M10:                   ;Need three bytes
  CALL WriteTriByteHex ;Write three Bytes
  JMP >M90             ;Done
M20:                   ;Need to whole DWord
  CALL WriteDWordHex   ;Write the DWord
  JMP >M90             ;Done

WriteWordMinHex:
M30:                   ;Need two bytes or less
  CMP  AX,0FFh         ;More than a Byte can handle?
  JA  >M40             ;If so, jump to write a Word
M35:                   ;Only needs a Byte
  CALL WriteByteHex    ;Write a Byte
  JMP >M90             ;Done
M40:                   ;Needs a Word
  CALL WriteWordHex    ;Write a Word
M90:                   ;Done
;  CALL WriteHexEnd     ;Write the 'h'
  RET

;;------------------------------------------------------------------------------
;;WRITE A DWORD IN SEGMENT:OFFSET FORMAT
;;Inputs:  EAX = DWord to be written
;;         CLD must be set already!
;;Outputs: To Screen
;;Changes:
;;------------------------------------------------------------------------------
;WriteSegmentOffset:
;  PUSH EAX          ;Save used registers
;  ROR  EAX,16       ;Write the
;  CALL WriteWordHex ;  High Word (Segment)
;  CALL WriteColon   ;Write a Colon
;  POP  EAX          ;Restore used registers
;  CALL WriteWordHex ;Write the Low Word (Offset)
;  RET

;------------------------------------------------------------------------------
;CONVERT BYTE, WORD, OR DWORD TO HEX CHARACTER STRING, AND WRITE IT
;Inputs:  AL/AX/BP:AX = Nibble/Byte/Word/DWord to be written
;         CLD must be set already!
;Outputs: Writes to the Screen
;Changes: HexString
;------------------------------------------------------------------------------
WriteNibbleHex:
  PUSH BX             ;Save used registers
  MOV  BX,8           ;Need to start of offset 8 in string
  JMP >H00            ;Jump to do it
WriteByteHex:
  PUSH BX             ;Save used registers
  MOV  BX,7           ;Need to start of offset 7 in string
  JMP >H00            ;Jump to do it
WriteWordHex:
  PUSH BX             ;Save used registers
  MOV  BX,5           ;Need to start of offset 5 in string
  JMP >H00            ;Jump to do it
WriteTriByteHex:
  PUSH BX             ;Save used registers
  MOV  BX,2           ;Need to start of offset 5 in string
  JMP >H00            ;Jump to do it
WriteDWordHex:
  PUSH BX             ;Save used registers
  XOR  BX,BX          ;Need to start of offset 0 in string
;  JMP >H00            ;Jump to do it
H00:                  ;Start converting the strings
  PUSH DX,DI          ;Save used registers
  MOV  DI,HexString   ;Point DS:[DI] at HexString
  MOV  DX,DI          ;Point DS:[DX] at HexString
;  ROR  EAX,16         ;Convert the High Word
  XCHG AX,BP          ;Convert the High Word
  CALL Word2HexString ;  to a String
  INC  DI             ;Skip over the Underscore
;  ROR  EAX,16         ;Convert the Low Word
  XCHG AX,BP          ;Convert the Low Word
  CALL Word2HexString ;  to a String
  ADD  DX,BX          ;Point DX at the beginning of where we write
  CALL WriteItDX      ;Write it
  POP  DI,DX          ;Restore used registers
  POP  BX             ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CONVERT A BYTE OR WORD TO A HEXADECIMAL STRING (2 OR 4 CHARACTERS)
;Inputs:  AX = Word to Convert to a Hex String
;         DS = Local Data Area
;         CLD already issued
;Outputs: DS:[DI]
;Changes: DI
;------------------------------------------------------------------------------
Word2HexString:
  PUSH AX,BX,ES         ;Save used registers
  MOV  BX,AX            ;Save original Word
  MOV  ES,DS            ;Point ES:[DI] at
  CALL Word2HexString00 ;Convert it
  POP  ES,BX,AX         ;Restore used registers
  RET

Word2HexString00:
  MOV  AL,BH            ;Convert High Byte
  CALL Word2HexString10 ;  to ASCII
  MOV  AL,BL            ;Work with Low Byte
Word2HexString10:       ;Convert Byte to ASCII
  AAM  10h              ;Separate Low & High Nibbles
  XCHG AH,AL            ;Put High Nibble in AL
  CALL Word2HexString20 ;Convert High Nibble to ASCII
  XCHG AH,AL            ;Work with Low Nibble
Word2HexString20:       ;Convert Nibble to ASCII
  ADD  AL,90h           ;Convert BCD
  DAA                   ;  to Decimal
  ADC  AL,40h           ;Convert Decimal
  DAA                   ;  to ASCII
  STOSB                 ;Store the Nibble
  RET

;Byte2HexString:
;  PUSH AX,ES            ;Save used registers
;  MOV  ES,DS            ;Point ES:[DI] at the String
;  CALL Word2HexString10 ;Convert it
;  POP  ES,AX            ;Restore used registers
;  RET

;------------------------------------------------------------------------------
;WRITE A BYTE OR WORD TO THE SCREEN AS A DECIMAL (EXTRA SPACES INCLUDED)
;Inputs:  AL/AX = Byte/Word to Write
;Outputs:
;Changes:
;------------------------------------------------------------------------------
WriteByteMin:
  PUSH AX,BX          ;Save used registers
  XOR  AH,AH          ;Make sure high byte is 0
  MOV  BH,(WriteBWMin+WriteBWByte) ;Set Flags
  JMP >W00            ;Do it
WriteWordMin:
  PUSH AX,BX          ;Save used registers
  MOV  BH,(WriteBWMin+WriteBWWord) ;Set Flags
  JMP >W00            ;Do it
ByteToString:
  PUSH AX,BX          ;Save the original word & BP
  XOR  AH,AH          ;Make sure high byte is 0
  MOV  BH,(WriteBWNoMin+WriteBWByte) ;Set Flags
  JMP >W00            ;Jump to start the loop
WordToString:
  PUSH AX,BX          ;Save the original word
  MOV  BH,(WriteBWNoMin+WriteBWWord) ;Set Flags
;  JMP >W00            ;Jump to start the loop
;WordToString3:
;  PUSH AX,BX          ;Save the original word
;  MOV  BH,(WriteBWNoMin+WriteBWByte) ;Set Flags
;  JMP >W00            ;Jump to start the loop
W00:                  ;Do a word or a byte
  PUSH CX,DX,SI       ;Save used registers
  MOV  SI,SingleMsg   ;Point at the single character message
  XOR  BL,BL          ;Test for first non-zero character is false
  MOV  CX,10000       ;First divisor is 10,000
W20:                  ;Loop to here for each character
  XOR  DX,DX          ;High word of Dividend = 0
  DIV  CX             ;Divide DX:AX by current divisor
  OR   AX,AX          ;Is this a non-zero character?
  JNZ >W30            ;If so, we need to write it
  OR   BL,BL          ;Has there already been a non-zero character?
  JNZ >W30            ;If so, we need to write it
  CMP  CX,1           ;Is this the last character?
  JE  >W30            ;If so, we need to write it
  TEST BH,WriteBWMin  ;Are we doing a minimum?
  JNZ >W40            ;If not, don't write anything
  MOV  AL,' '         ;Assume a space
  TEST BH,WriteBWWord ;Doing a word?
  JNZ >W35            ;If so, write the space
  CMP  CX,100         ;If not, doing the hundreds character?
  JBE >W35            ;If so, write the space
  JMP >W40            ;If not, don't write anything
W30:                  ;We need to write this character
  INC  BL             ;Test for first non-zero character is true
  ADD  AL,'0'         ;Convert the Number to ASCII
W35:                  ;Write the character
  MOV  [SI],AL        ;Write the
  CALL WriteItSI      ;  character
W40:                  ;Skip this character - just make it a space
  CMP  CX,1           ;Was this the last division to do?
  JE  >W90            ;If so, we're done
  MOV  AX,DX          ;If not, start next loop with remainder of division
  PUSH AX             ;Save register for a second
  XOR  DX,DX          ;So dividend won't be messed up
  MOV  AX,CX          ;Want to divide divisor in CX
  MOV  CX,10          ;Want to divide by 10
  DIV  CX             ;Divide it
  MOV  CX,AX          ;Store it back in CX
  POP  AX             ;Restore register
  JMP  W20            ;And do it again
W90:                  ;We're done
  POP  SI,DX,CX       ;Restore used registers
  POP  BX,AX          ;Restore original word & BP
  RET

;------------------------------------------------------------------------------
;WRITE SOME SPACES TO THE SCREEN
;Inputs:  CL = Number of spaces to write
;         SpaceMsg
;Outputs: To the screen
;Changes:
;------------------------------------------------------------------------------
WriteSpaces:
  PUSH CX,DX       ;Save used registers
  OR   CL,CL       ;Should we write 0 spaces?
  JZ  >S90         ;If so, we're done
  XOR  CH,CH       ;If OK, change it to a word
  MOV  DX,SpaceMsg ;Point at the message
S10:               ;Loop to here for each space
  CALL WriteItDX   ;Write the space
  LOOP S10         ;Keep going until we're done
S90:               ;We're done
  POP  DX,CX       ;Restore used registers
  RET

;------------------------------------------------------------------------------
;WRITE A SPECIFIC CHARACTER OR SET OF CHARACTERS TO THE SCREEN
;Inputs:
;Outputs: To screen
;Changes:
;------------------------------------------------------------------------------
WriteAL:
  PUSH DX                ;Save used registers
  MOV  DL,AL             ;Write what's in AL
  JMP >C00               ;Do it
WriteAngleLeft:
  PUSH DX                ;Save used registers
  MOV  DL,'<'            ;Write a Left Angle Bracket
  JMP >C00               ;Do it
WriteAngleRight:
  PUSH DX                ;Save used registers
  MOV  DL,'>'            ;Write a Right Angle Bracket
  JMP >C00               ;Do it
WriteBlock:
  PUSH DX                ;Save used registers
  MOV  DL,'±'            ;Write a Block Character
  JMP >C00               ;Do it
WriteBracketLeft:
  PUSH DX                ;Save used registers
  MOV  DL,'['            ;Write a Left Square Bracket
  JMP >C00               ;Do it
WriteBracketRight:
  PUSH DX                ;Save used registers
  MOV  DL,']'            ;Write a Right Square Bracket
  JMP >C00               ;Do it
WriteCharBX:
  PUSH DX                ;Save used registers
  MOV  DL,[BX]           ;Write the character at [BX]
  JMP >C00               ;Do it
WriteColon:
  PUSH DX                ;Save used registers
  MOV  DL,':'            ;Write a Colon
  JMP >C00               ;Do it
WriteCrLf:
  PUSH DX                ;Save used registers
  MOV  DX,CrLfMsg        ;Point at Message
  JMP >C10               ;Do it
WriteCurlyLeft:
  PUSH DX                ;Save used registers
  MOV  DL,'{'            ;Write a Left Curly Bracket
  JMP >C00               ;Do it
WriteCurlyRight:
  PUSH DX                ;Save used registers
  MOV  DL,'}'            ;Write a Right Curly Bracket
  JMP >C00               ;Do it
WriteDot:
  PUSH DX                ;Save used registers
  MOV  DL,'.'            ;Write a Dot
  JMP >C00               ;Do it
WriteEquals:
  PUSH DX                ;Save used registers
  MOV  DL,'='            ;Write an Equals
  JMP >C00               ;Do it
WriteHexEnd:
  PUSH DX                ;Save used registers
  MOV  DL,'h'            ;Write an h
  JMP >C00               ;Do it
WriteMinus:
  PUSH DX                ;Save used registers
  MOV  DL,'-'            ;Write a Minus
  JMP >C00               ;Do it
WriteParenLeft:
  PUSH DX                ;Save used registers
  MOV  DL,'('            ;Write a Left Parentheses
  JMP >C00               ;Do it
WriteParenRight:
  PUSH DX                ;Save used registers
  MOV  DL,')'            ;Write a Right Parentheses
  JMP >C00               ;Do it
WritePlus:
  PUSH DX                ;Save used registers
  MOV  DL,'+'            ;Write a Plus
  JMP >C00               ;Do it
WriteQuestion:
  PUSH DX                ;Save used registers
  MOV  DL,'?'            ;Write a ?
  JMP >C00               ;Do it
WriteDoubleQuote:
  PUSH DX                ;Save used registers
  MOV  DL,'"'            ;Write a ?
  JMP >C00               ;Do it
WriteSpace:
  PUSH DX                ;Save used registers
  MOV  DX,SpaceMsg       ;Point at Message
  JMP >C10               ;Do it
WriteUnderscore:
  PUSH DX                ;Save used registers
  MOV  DL,'_'            ;Write an Underscore
  JMP >C00               ;Do it
WriteUniChar:
  PUSH DX                ;Save used registers
  MOV  DX,UniCharMsg     ;Point at Message
  JMP >C10               ;Do it
C00:
  MOV  SingleMsg[0],DL   ;Put the character in the Single Character String
  MOV  DX,SingleMsg      ;Point at Single Character String
C10:                     ;DX is pointed at String
  CALL WriteItDX         ;Write the String
  POP  DX                ;Restore used registers
  RET

;------------------------------------------------------------------------------
;WRITE ASCIIZ STRING TO CON OR TO ERR
;Inputs:  DS:[DX] = Pointer to string
;         CS = Local Data Area
;Outputs: Writes the string to CON or ERR
;Changes:
;------------------------------------------------------------------------------
WriteZCon:                  ;Write to CON
  CMP  CS:PauseHeaderPtr,-1 ;Should we write anything?
  JE  >Z90                  ;If not, just quit
  PUSH BX                   ;Save used register
  MOV  BX,StdOutHandle      ;Write to STDOUT
  JMP >Z00                  ;Jump to do it
WriteZErr:                  ;Write to ERR
  PUSH BX                   ;Save used register
  MOV  BX,StdErrHandle      ;Write to STDERR
Z00:
  PUSH AX,CX                ;Save used registers
  CALL CalcStrSizeDX        ;Calculate the size of the string (returns CX)
  JZ  >Z80                  ;If nothing to write, just quit
  MOV  AH,40h               ;Function 40h (Write to Device)
  INT  21h                  ;Do it
Z80:                        ;We're done
  POP  CX,AX                ;Restore used registers
  POP  BX                   ;Restore used register
Z90:                        ;We're done
  RET

;------------------------------------------------------------------------------
;CALCULATE THE LENGTH OF AN ASCIIZ STRING
;Inputs:  DS:[SI] = ASCIIZ String to wrok with
;Outputs: CX = Length of String
;         ZF = Set if string is 0 length
;            = Clear if not
;Changes:
;------------------------------------------------------------------------------
CalcStrSizeSI:
  PUSH DX            ;Save used registers
  MOV  DX,SI         ;Calculate the
  CALL CalcStrSizeDX ;  length of the string
  POP  DX            ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE THE LENGTH OF AN ASCIIZ STRING
;Inputs:  DS:[DX] = Pointer to the string
;Outputs: CX = Length of the string
;         ZF = Set if string is 0 length
;            = Clear if not
;Changes:
;------------------------------------------------------------------------------
CalcStrSizeDX:
  PUSH AX,DI  ;Save used registers
  PUSH ES     ;Save used registers
  MOV  ES,DS  ;Point ES:[DI]
  MOV  DI,DX  ; at the string
  XOR  AL,AL  ;Look for a 0
  MOV  CX,-1  ;Start with max count for REPNE
  REPNE SCASB ;Find the end of the string
  NOT  CX     ;Calculate the size
  DEC  CX     ;  of the string (sets ZF)
  POP  ES     ;Restore used registers
  POP  DI,AX  ;Restore used registers
  RET

;------------------------------------------------------------------------------
;SKIP TO THE END OF AN ASCIIZ STRING
;Inputs:  DS:[SI] = ASCIIZ String to Skip Over
;Outputs: [SI]    = Next Byte After String
;Changes:
;------------------------------------------------------------------------------
SkipOverStringSI:
  PUSH CX,DX         ;Save used registers
  MOV  DX,SI         ;Calculate the size
  CALL CalcStrSizeDX ;  of the string (CX, does not include the Zero)
  INC  CX            ;Compensate for the Zero
  ADD  SI,CX         ;Add it to the Pointer
  POP  DX,CX         ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO WRITE OUR OUTPUT, EITHER TO PAUSE OR TO THE USER-PROVIDED ADDRESS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;WRITE AN ASCIIZ STRING POINTED AT BY DS:[SI], THEN SKIP OVER THE STRING
;Inputs:  DS:[SI] = ASCIIZ String to Write
;Outputs: To Pause or to user-provided Code Address
;         [SI] points to next character after the string
;Changes:
;------------------------------------------------------------------------------
WriteItSISkip:
  CALL WriteItSI        ;Write the string
  CALL SkipOverStringSI ;Skip over the string
  RET

;------------------------------------------------------------------------------
;WRITE AN ASCIIZ STRING, POINTED AT BY [BX], TO PAUSE OR TO PROVIDED CALL-BACK
;Inputs:  DS:[BX] = ASCIIZ String to Write
;Outputs: To Pause or to user-provided Code Address
;Changes:
;------------------------------------------------------------------------------
WriteItBX:
  PUSH DX        ;Save used registers
  MOV  DX,BX     ;Write the
  CALL WriteItDX ;  string
  POP  DX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;WRITE AN ASCIIZ STRING, POINTED AT BY [SI], TO PAUSE OR TO PROVIDED CALL-BACK
;Inputs:  DS:[SI] = ASCIIZ String to Write
;Outputs: To Pause or to user-provided Code Address
;Changes:
;------------------------------------------------------------------------------
WriteItSI:
  PUSH DX        ;Save used registers
  MOV  DX,SI     ;Write the
  CALL WriteItDX ;  string
  POP  DX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;WRITE OUR OUTPUT TO PAUSE, OR TO THE PROVIDED CALL-BACK ADDRESS
;Inputs:  DS:[DX] = ASCIIZ String to Write
;         CalloBackAddr (-1 in Offset if invalid)
;Outputs: Either to Pause, or to the call-back address
;Changes:
;------------------------------------------------------------------------------
WriteItDX:
  CMP  W CallBackAddr[0],-1 ;Is there a valid call-back address?
  JE  >W50                  ;If not, write to Pause
  CMP  ParentIsShell,Yes    ;Double-check whether we are at a command-line
                            ;  (we shouldn't need to do this, but will anyway)
  JE  >W50                  ;If so, write to Pause
  PUSH AX,BX,CX,DX,DI,SI    ;Save
  PUSH BP,DS,ES             ;  all registers
  CALL D CallBackAddr       ;If not, call the provided code address
  POP  ES,DS,BP             ;Restore
  POp  SI,DI,DX,CX,BX,AX    ;  all registers
  JMP >W90                  ;Done
W50:                        ;Write to Pause
  CALL WriteZPause          ;Write to Pause
W90:                        ;Done
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE NEEDED TO SET UP AND DO SCREEN PAUSES
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;SETUP PARAMETERS FOR DOING A SCREEN PAUSE (FOR PRINTING A LARGE TABLE)
;Inputs:  DS = Local Data Area
;         DS:[DX] = ASCIIZ Header to Print at top of each screen
;                   Last character of the Header MUST be an LF
;                   If SetupPauseNoHdr, we "inject" NoMsg as the Header
;Outputs: Pauses the screen with a MORE message every time it gets full
;NOTES:   If a Screen Header is really large (almost taking up the whole
;           screen itself, with little room for data), this procedure
;           may not work correctly.  This procedure does not validate
;           the size of the Header -- it simply assumes that it is a
;           "reasonable" size compared to the size of the screen.  Most
;           anything that needs a Screen Header (a long data table) will
;           only have a few lines of Header, so this should be OK as a
;  