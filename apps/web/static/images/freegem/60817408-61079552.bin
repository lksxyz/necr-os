        les   di, dta
        cld
        rep   movsb
        .if  ah > 1
           dec  ah
           inc  al
           add  dta_off, 2048
        .endif
      .endif
      .if al == 6h
        mov   si, offset Sector0
        mov   cx, 2048
        les   di, dta
        cld
        rep   movsb
        .if  ah > 1
           dec  ah
           inc  al
           add  dta_off, 2048
        .endif
      .endif
      .if al == 7h
        mov   si, offset Sector0
        mov   cx, 2048
        les   di, dta
        cld
        rep   movsb
        .if  ah > 1
           dec  ah
           inc  al
           add  dta_off, 2048
        .endif
      .endif
      .if al == 8h
