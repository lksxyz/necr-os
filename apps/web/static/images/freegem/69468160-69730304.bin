  ;----------------------------------------------------------------------------
  ;Dialects
  ;----------------------------------------------------------------------------
  Language0Tbl:
    DB TblFlagByte
    DB 00h, 'Language Neutral',0
    DB 01h, 'Processor/User Default Language',0
    DB 02h, 'System Default Language',0
    DB  0 , -1 ;End of Table

  NoDialectTbl:
    DB TblFlagByte
    DB 01h, 'No Dialects Defined',0
    DB  0 , -1 ;End of Table

  LocaleInvariantTbl:
    DB TblFlagByte
    DB 00h, 'No Dialects Allowed',0
    DB  0 , -1 ;End of Table

  ArabicTbl:
    DB TblFlagByte
    DB 01h, 'Saudi Arabia',0
    DB 02h, 'Iraq',0
    DB 03h, 'Egypt',0
