;  INT  10h           ;Do it
;  MOV  CursorSize,CX ;Put cursor info in BX where we want it
;;  XOR  CX,CX         ;Hide Cursor
;  MOV  CX,0F0Fh      ;Hide Cursor
;  MOV  AH,1          ;Function 1 (Set Cursor Size)
;  INT  10h           ;Do it
;  POP  DX,CX,BX,AX   ;Restore used register
;  RET
