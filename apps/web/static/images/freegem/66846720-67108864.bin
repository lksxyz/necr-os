  RET

;------------------------------------------------------------------------------
;Display list of Bad Devices
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchB:
