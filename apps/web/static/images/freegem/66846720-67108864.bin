DoSwitchC:
  OR   B [DI+2],Descriptors ;Set the appropriate flag
  RET

;------------------------------------------------------------------------------
;Beep Speaker when "Bad" Devices are discovered
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchBeep:
  PUSH AX                   ;Save used registers
  MOV  AL,NoBeep            ;Bit mask to use
  CALL DoSwitchWithYNTsrRvs ;Do it
  POP  AX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;Use 15-button Protocol
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchF:
  PUSH AX                   ;Save used registers
  MOV  AL,Buttons15         ;Bit mask to use
  CALL DoSwitchWithYNTsrFwd ;Do it
  POP  AX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;Use ThrustMaster Protocol
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchT:
  PUSH AX                   ;Save used registers
  MOV  AL,ThrustMaster      ;Bit mask to use
  CALL DoSwitchWithYNTsrFwd ;Do it
  POP  AX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;Display Single Joystick Status
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchJ:
  PUSH AX                ;Save used registers
  CALL SkipColonEquals   ;Skip over the Colon or Equals, if there
  CALL GetNumber         ;Get the Joystick Index
  JC  >J70               ;If none, error
  CMP  AX,MaxDevices     ;Is it too big?
  JAE >J70               ;If so, Error
  MOV  JoyStatusIndex,AL ;If not, store it
  JMP >J90               ;Done
J70:                     ;Error
  MOV  ParseError,Yes    ;Mark as an Error
J90:                     ;Done
  POP  AX                ;Restore used registers
  RET

;------------------------------------------------------------------------------
;Set I/O Port for Virtualization
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchI:
  PUSH AX                   ;Save used registers
  CALL SkipColonEquals      ;Skip over the Colon or Equals, if there
  CALL GetNumber            ;Get the Port Number
  JC  >I70                  ;If none, Error
  CMP  AX,MinPort           ;Is it a valid Port number?
  JB  >I70                  ;If not, Error
  CMP  AX,MaxPort           ;Is it a valid Port number?
  JA  >I70                  ;If not, Error
  CMP  ParseTest,Yes        ;Just the test run?
  JE  >I90                  ;If so, we're done
  CMP  AX,ES:VirtIOTable[0] ;If not, is the Port Number changing?
  JE  >I90                  ;If not, we're done
  CALL StopVIO              ;If so, Uninstall original VIO
  MOV  ES:VirtIOTable[0],AX ;Store the New Port Number
  CALL StartVIO             ;Reinstall VIO
  JMP >I90                  ;Done
I70:                        ;Error
  MOV  ParseError,Yes       ;Mark as an Error
I90:                        ;Done
  POP  AX                   ;Restore used registers
  RET

;------------------------------------------------------------------------------
;Set BIOS Center Coordinate
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchCenter:
  PUSH AX                 ;Save used registers
  CALL SkipColonEquals    ;Skip over the Colon or Equals, if there
  CALL GetNumber          ;Get the Center Value
  JC  >C70                ;If none, error
  CMP  AX,MinCenter       ;Is it a valid number?
  JB  >C70                ;If not, Error
  CMP  AX,MaxCenter       ;Is it a valid number?
  JA  >C70                ;If not, Error
  CMP  ParseTest,Yes      ;Just the test run?
  JE  >C90                ;If so, we're done
  SHL  AX,1               ;Multiply by 2 (convert from Center to maximum)
  MOV  ES:NormalizeMax,AX ;Store it
  JMP >C90                ;Done
C70:                      ;Error
  MOV  ParseError,Yes     ;Mark as an Error
C90:                      ;Done
  POP  AX                 ;Restore used registers
  RET

;------------------------------------------------------------------------------
;Set Movement Percent
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchP:
  PUSH AX                ;Save used registers
  CALL SkipColonEquals   ;Skip over the Colon or Equals, if there
  CALL GetNumber         ;Get the Center Value
  JC  >P70               ;If none, error
  CMP  AX,MinPercent     ;Is it a valid number?
  JB  >P70               ;If not, Error
  CMP  AX,MaxPercent     ;Is it a valid number?
  JA  >P70               ;If not, Error
  CMP  ParseTest,Yes     ;Just the test run?
  JE  >P90               ;If so, we're done
  MOV  ES:MovePercent,AX ;Store it
  JMP >P90               ;Done
P70:                     ;Error
  MOV  ParseError,Yes    ;Mark as an Error
P90:                     ;Done
  POP  AX                ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SWITCH AND SUPPORT ROUTINES FOR HANDLING MAPPING FUNCTIONS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;Process Mapping Functions
;Inputs:   DS    = Local Data Area
;          ES    = TSR Data Area
;         [DI]   = ProgFlags
;         [DI+1] = ProgFlags2
;         [DI+2] = StatusFlags
;         [SI]   = Command Line Pointer
;         [BP]   = TSRFlags
;          AH    = ParseTest, ZF Set if ParseTest = No
;------------------------------------------------------------------------------
DoSwitchM:
  PUSH AX,BX,CX,DX,DI          ;Save used registers
  CALL SkipColonEquals         ;Skip Colon/Equals (if there)
  MOV  BX,SwitchListDIIndex    ;Look for a
  CALL GetCode                 ;  Joystick Descriptor
  JNC >M10                     ;If there, continue
  CALL GetNextChar             ;If not, get the next character
  CALL Capitalize              ;Capitalize it
  CMP  AL,'J'                  ;Is it J?
  JE  >M10                     ;If so, continue
  CMP  AL,'G'                  ;Is it G?
  JE  >M10                     ;If so, continue
  DEC  SI                      ;If not, point back at the character
M10:                           ;Handled the Joystick Descriptor
  CALL IsSpaceOrEOX            ;Get the next character
  JZ  >M70                     ;If EOL, error
  CALL Capitalize              ;Capitalize it
  CMP  AL,'A'                  ;Joystick A?
  JE  >M20                     ;If so, continue
  CMP  AL,'B'                  ;Joystick B?
  JNE >M70                     ;If not, error
M20:                           ;DL = Joystick ID ('A' or 'B')
  CALL GetXlatEntity           ;Get the Translation Entity & SubEntity Type (DX)
  JC  >M70                     ;If error, quit
  CALL GetXlatPtr              ;If OK, get the Translation table pointer ([DI])
  CALL SkipColonEquals         ;Skip Colon/Equals (if there)
  MOV  BX,SwitchListFrom       ;Look for a
  CALL GetCode                 ;  Separator Code (don't actually need it)
  CALL GetControlInfo          ;Get the Map From Control Info (CX, DX)
  JC  >M70                     ;If error, quit
  CMP  ParseTest,Yes           ;Is this just the Test Run?
  JE  >M90                     ;If so, we're done
  MOV  W ES:[DI].XlatJIndex,DX ;If real, store Joystick Index & Control Type
  MOV  W ES:[DI].XlatCIndex,CX ;Store the Control Indices
  JMP >M90                     ;Done
M70:                           ;Error
  MOV  ParseError,Yes          ;Mark as an Error
M90:                           ;Done
  POP  DI,DX,CX,BX,AX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE ENTITY TYPE WE SHOULD CHANGE FROM THE COMMAND-LINE
;Inputs:   AL = 'A' or 'B' (Analog Joystick ID)
;         [SI] = Command-line Pointer
;Outputs: CF = Clear if OK
;              DL = Entity Type ('A' = Axis, 'B' = Button)
;              DH = SubEntity Type ('X'-'Z' for Axes, 1-15 for Button)
;            = Set if Error
;              DX = Undefined
;Changes: SI
;------------------------------------------------------------------------------
GetXlatEntity:
  PUSH AX,BX,CX               ;Save used registers
  MOV  CL,AL                  ;Save Joystick ID ('A' or 'B')
  XOR  DX,DX                  ;Default Entity & SubEntity Descriptor = Nada
  CALL SkipComma              ;Skip over the Comma, if there
  CALL IsSpaceOrEOL           ;Skip spaces
  JZ  >Y701                   ;If EOL, Error
  MOV  BX,SwitchListEntity    ;Look for an
  CALL GetCode                ;  Entity Descriptor
  JNC >Y10                    ;If found, continue
  CALL GetNextChar            ;If not found, get the character
  CALL Capitalize             ;Capitalize it
  CMP  AL,'A'                 ;Axis?
  JE  >Y10                    ;If so, continue
  CMP  AL,'B'                 ;Button?
  JE  >Y10                    ;If so, continue
  DEC  SI                     ;If not, point back at the character
  JMP >Y15                    ;Look for the SubEntity
Y10:                          ;Have Entity Code
  MOV  DL,AL                  ;Store Entity Descriptor ({A}xis or {B}utton)
Y15:                          ;Entity Descriptor stored
  CALL IsSpaceOrEOL           ;Skip spaces
  JZ  >Y70                    ;If EOL, Error
  MOV  BX,SwitchListSubEntity ;Look for a
  CALL GetCode                ;  SubEntity Descriptor
  JNC >Y30                    ;If we got one,
  CALL GetNextChar            ;If not found, get the character
  CALL Capitalize             ;Capitalize it
  CMP  AL,'X'                 ;Axis?
  JB  >Y20                    ;If not, handle it
  CMP  AL,'Z'                 ;Button?
  JBE >Y25                    ;If so, continue
Y20:                          ;Not 'X'-'Z'
  DEC  SI                     ;Point back at the character
  CALL GetDecimal             ;Look for a Number
  JC  >Y70                    ;If none, Error
  OR   AX,AX                  ;Is it too small?
  JZ  >Y70                    ;If so, Error
  CMP  AX,15                  ;Is it too big?
  JA  >Y70                    ;If so, Error
Y25:                          ;Have SubEntity Code
  MOV  DH,AL                  ;Store SubEntity Code ('X'-'Z', 1-15)
  OR   DL,DL                  ;Did we get an Entity Descriptor?
  JNZ >Y30                    ;If so, continue
  MOV  DL,'A'                 ;Assume an Axis
  CMP  DH,'X'                 ;Is it an Axis?
  JAE >Y30                    ;If so, continue
  INC  DL                     ;If not, it's a Button
Y30:                          ;Entity Descriptor filled in
  CMP  DL,'A'                 ;Entity = Axis?
  JNE >Y35                    ;If not, handle Buttons
  CMP  DH,'X'                 ;If so, is it an Axis SubEntity?
  JB  >Y70                    ;If not, Error
  CMP  CL,'A'                 ;Joystick A?
  JE  >Y80                    ;If so, we're done
  CMP  DH,'Z'                 ;If not, is it SubEntity Z?
  JNE >Y80                    ;If not, we're done
Y701:                         ;To avoid JMP > 128
  JMP >Y70                    ;If so, Error
Y35:                          ;Entity = Button
  CMP  DH,15                  ;Is it a Button SubEntity?
  JA  >Y70                    ;If not, Error
  CMP  CL,'A'                 ;Joystick A?
  JE  >Y80                    ;If so, we're done
  CMP  DH,2                   ;If so, is it Button 1 or 2?
  JBE >Y80                    ;If so, it's OK
Y70:                          ;Error
  STC                         ;Set return flag
  JMP >Y90                    ;Done
Y80:                          ;OK
  CLC                         ;Set return flag
Y90:                          ;Done
  POP  CX,BX,AX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE POINTER TO THE TRANSLATION TABLE ENTRY WE SHOULD CHANGE
;Inputs:   AL = 'A' or 'B' (Analog Joystick ID)
;          DL = Entity Type, {A}xis or {B}utton
;          DH = SubEntity Type, 'X'-'Z' if Axis, 1-15 if Button
;          All inputs already tested for validity
;Outputs: [DI] = Translation Table Entry associated with Inputs
;Changes:
;------------------------------------------------------------------------------
GetXlatPtr:
  PUSH DX               ;Save used registers
  CMP  AL,'A'           ;Joystick A?
  JNE >P30              ;If not, handle Joystick B
P10:                    ;Joystick A
  CMP  DL,'A'           ;Is it an Axis?
  JNE >P20              ;If not, handle Buttons
  MOV  DI,AXXlat        ;Assume Axis AX
  CMP  DH,'X'           ;Is it Direction X?
  JE  >P90              ;If so, we're done
  CMP  DH,'Y'           ;Is it Direction Y?
  JE  >P80              ;If so, we're done
  MOV  DI,AZXlat        ;If not, it's Axiz AZ
  JMP >P90              ;Done
P20:                    ;Joystick A, Buttons
  MOV  DI,A01Xlat       ;Point at the first button
P25:                    ;Loop to here to find the correct Table entry
  DEC  DH               ;Decrement the Loop Counter
  JZ  >P90              ;If 0, we're done
  ADD  DI,XlatStrucSize ;If not, point at the next Table entry
  JMP  P25              ;Keep going until we're done
P30:                    ;Joystick B
  CMP  DL,'A'           ;Is it an Axis?
  JNE >P40              ;If not, handle Buttons
  MOV  DI,BXXlat        ;Assume Axis BX
  CMP  DH,'X'           ;Is it Direction X?
  JE  >P90              ;If so, we're done
  JMP >P80              ;If not, it's Axis BY
P40:                    ;Joystick B, Buttons
  MOV  DI,A03Xlat       ;Assume Button B01 (A03)
  CMP  DH,1             ;Is it Button 1?
  JE  >P90              ;If so, we're done
P80:                    ;Point at the next Table Entry
  ADD  DI,XlatStrucSize ;Point at the next Translation table entry
P90:                    ;Done
  POP  DX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;OBTAIN A CONTROL INDEX FROM THE COMMAND LINE
;Inputs:   [SI] = Command Line Pointer
;          [DI] = Translation table Entry we will be Stroing things in
;Outputs:  CF = Clear if OK
;               DL = Joystick Index
;               DH = Control Type
;               CL = Control Index 1
;               CH = Control Index 2 (-1 if N/A)
;             = Set if Error
;               CX, DX = Undefined
;Changes:
;NOTES: This will let the user enter Control Indices in either forward or
;         reverse order (if he user gives a range)
;------------------------------------------------------------------------------
GetControlInfo:
  PUSH AX,BX                  ;Save used registers
  MOV  CX,-1                  ;Start all Indices
  MOV  DX,CX                  ;  at -1
  CALL SkipColonEquals        ;Skip Colon/Equals (if there)
  MOV  BX,SwitchListDIIndex   ;Point at list of code words
  CALL GetCode                ;See if it's a match
  JNC >L05                    ;If so, continue
  CALL GetNextChar            ;If not, get the next character
  CALL Capitalize             ;Capitalize it
  CMP  AL,'G'                 ;Is it G?
  JE  >L05                    ;If so, continue
  CMP  AL,'J'                 ;Is it J?
  JE  >L05                    ;If so, continue
  DEC  SI                     ;If not, point back at the character
L05:                          ;Joystick Descriptor handled
  CALL GetDecimal             ;Get the DI Index
  JC  >L701                   ;If no number, Error
  CMP  AX,(MaxDevices-1)      ;Is it valid?
  JA  >L701                   ;If not, Error
  MOV  DL,AL                  ;If OK, store DI Index
  CALL SkipComma              ;Skip over the Comma if it's there
  MOV  BX,SwitchListCtrlType  ;Point at list of Code Words
  CALL GetCode                ;See if it's a match
  JC  >L701                   ;If no match, Error
  MOV  DH,AL                  ;Store Control Type
  CMP  DI,A01Xlat             ;Are we getting a Button?
  JB  >L10                    ;If not, any type of Control is OK
  CMP  DH,CTButton            ;If so, is it a Button Control?
  JNE >L701                   ;If not, Error
L10:                          ;Control Type is valid for Entity
  CALL SkipComma              ;Skip over the comma if it's there
  CALL GetDecimal             ;Get Control Index 1
  JC  >L70                    ;If no number, Error
  CMP  AX,MaxXlatIndex        ;Is it too big?
  JA  >L70                    ;If so, Error
  MOV  CL,AL                  ;If OK, store it
  CMP  DI,A01Xlat             ;Are we getting a Button?
  JAE >L80                    ;If so, we're done
  CMP  DH,CTDPad              ;If not, is Control Type a Slider/Throttle/Axis?
  JA  >L80                    ;If so, we're done
  JE  >L30                    ;If a DPad, jump to handle it
L20:                          ;Mapping Button to Axis
  CALL SkipComma              ;Skip over the Comma if it's there
  CALL GetDecimal             ;Get Button Index 2
  JC  >L70                    ;If none, Error
  CMP  AX,MaxXlatIndex        ;Is it too big?
  JA  >L70                    ;If so, Error
  MOV  CH,AL                  ;If OK, store it
  JMP >L80                    ;Done
L701:                         ;To avoid JMP > 128
  JMP >L70                    ;Error
L30:                          ;Mapping DPad to Axis
  CALL SkipComma              ;Skip over the comma if it's there
  MOV  BX,SwitchListSubEntity ;Get a DPad
  CALL GetCode                ;  Axis Direction
  JNC >L40                    ;If found, continue
  CALL GetNextChar            ;If not found, get a single character
  CALL Capitalize             ;Capitaize it
L40:                          ;AL = DPad Axis Code
  XOR  CH,CH                  ;Assume Axis X
  CMP  AL,'X'                 ;Direction X?
  JE  >L80                    ;If so, we're done
  INC  CH                     ;Assume Axis Y
  CMP  AL,'Y'                 ;Direction Y?
  JE  >L80                    ;If so, we're done
L70:                          ;Error
  STC                         ;Set Error Flag
  JMP >L90                    ;Done
L80:                          ;OK, Go back one space (EOL)
  CLC                         ;Set OK Flag
L90:                          ;Done
  POP  BX,AX                  ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SUPPORT ROUTINES FOR PROCESSING SWITCHES
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;GET A YES/NO OPTION FOR A COMMAND-LINE SWITCH
;Inputs:  [SI] = Command Line Pointer
;Outputs: CF = Clear if OK
;              ZF = Set if No
;                   AL = 0 (No)
;                 = Clear if Yes
;                   AL = -1 (Yes)
;            = Set if Error
;              AL = 0
;Changes:
;------------------------------------------------------------------------------
GetYesNo4Switch:
  PUSH BX,CX              ;Save used registers
  MOV  CH,AH              ;Save original AH
  CALL SkipColonEquals    ;Skip Colon/Equals (if there)
  MOV  BX,SwitchListYesNo ;Point at the list of code words
  CALL GetCode            ;See if its a match
  JNC >Y20                ;If so, jump to test it
  CALL GetNextChar        ;If not, get a single character
  JZ  >Y70                ;If end-of-line, error
  CALL Capitalize         ;Capitalize it
Y20:                      ;Got a character
  CMP  AL,'Y'             ;Is it Yes?
  JE  >Y40                ;If so, handle it
  CMP  AL,'N'             ;Is it No?
  JNE >Y70                ;If not, error
Y30:                      ;No
  XOR  AL,AL              ;If so, make it No
  JMP >Y80                ;Done
Y40:                      ;Yes
  MOV  AL,Yes             ;Mark it as a Yes
  JMP >Y80                ;Done
Y70:                      ;Error
  XOR  AL,AL              ;Set AL to 0
  STC                     ;Set Error Flag
  JMP >Y90                ;Done
Y80:                      ;OK
  OR   AL,AL              ;Set Zero Flag for Return
  CLC                     ;Set OK Flag
Y90:                      ;Done
  MOV  AH,CH              ;Restore original AH
  POP  CX,BX              ;Restore used registers
  RET

;------------------------------------------------------------------------------
;HANDLE A SWITCH WITH A YES/NO OPTION
;Inputs:  [SI] = Command Line Pointer
;         ES = TSR Data Area
;         DS = Local Data Area
;         AL = Bit mask to Set/Unset
;         AH = ParseTest status
;Outputs: Sets/Unsets bit in ES:TSRFlags or DS:ProgFlags as appropriate
;Changes:
;NOTES: If we are changing the resident (TSR) part of the program
;         (ES:TSRFlags), we do not actually change anything unless
;         ParseTest is set to No.  If we are changing the transient
;         part of the program (DS:ProgFlags), we change it no matter
;         what ParseTest is set to.
;       Forward and Reverse refer to Forward and Reverse Logic.  With
;         Forward Logic, if the user says Yes, we set the particular bit
;         to 1.  With Reverse Logic, when the user says Yes, we set
;         to bit to 0.
;------------------------------------------------------------------------------
DoSwitchWithYNTsrRvs:
  PUSH CX                  ;Save used registers
  MOV  CL,-1               ;Mark as Reverse Logic
  JMP >Y000                ;Jump to do ES:TSRFlags
DoSwitchWithYNTsrFwd:
  PUSH CX                  ;Save used registers
  XOR  CL,CL               ;Mark as Forward Logic
  JMP >Y000                ;Jump to do ES:TSRFlags
;DoSwitchWithYNPrgRvs:
;  PUSH CX                  ;Save used registers
;  MOV  CL,-1               ;Mark as Reverse Logic
;  JMP >Y001                ;Jump to do DS:ProgFlags
DoSwitchWithYNPrgFwd:
  PUSH CX                  ;Save used registers
  XOR  CL,CL               ;Mark as Forward Logic
  JMP >Y001                ;Jump to do DS:ProgFlags
Y000:                      ;ES:TSRFlags
  PUSH BX                  ;Save used registers
  MOV  BX,OFFSET TSRFlags  ;Point at TSR Flags
  JMP >Y00                 ;Do it
Y001:                      ;DS:ProgFlags
  PUSH BX                  ;Save used registers
  MOV  BX,OFFSET ProgFlags ;Point at TSR Flags
;  JMP >Y00                 ;Do it
Y00:
  PUSH AX                  ;Save used registers
  MOV  CH,AL               ;Save Bit Mask to set
  CALL GetYesNo4Switch     ;Get the Yes/No parameter (AL)
  JC  >Y70                 ;If error, handle it
  OR   AL,AL               ;Is it Yes?
  JNZ >Y20                 ;If so, jump to handle it
Y10:                       ;No
  OR   CL,CL               ;Is it Forward Logic?
  JZ  >Y40                 ;If so, jump to handle it
  JMP >Y50                 ;If not, jump to handle Reverse Logic
Y20:                       ;Yes
  OR   CL,CL               ;Is it Forward Logic?
  JZ  >Y50                 ;If so, jump to handle it
Y40:                       ;Unset the Bi