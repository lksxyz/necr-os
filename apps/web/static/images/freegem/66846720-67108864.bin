e found, Error
  MOV  NewDeviceStage,213           ;Update Stage
  MOV  [SI].I14RRequestType,I14RRTDoInterruptPer ;Periodic Interrupt
  MOV  [SI].I14RFlags,I14RFlagIn    ;Direction = In
  XOR  AH,AH                        ;Get the
  MOV  AL,[DI].EDPollInterval       ;  Poll Interval
  CMP  AL,10                        ;Is it OK?
  JAE >I25                          ;If so, continue
  MOV  AL,10                        ;If not, make it OK
I25:                                ;AX contains Periodicity
  MOV  [SI].I14RPeriodicity,AX      ;Store the Periodicity
  MOV  NewDeviceStage,214           ;Update Stage
  MOV  AX,[DI].EDMaxPktSize         ;Get Data Size
  CMP  AX,MaxJDataSize              ;Is it OK?
  JA  >I701                         ;If not, Error
  MOV  [SI].I14RDataSize,AX         ;If OK, store it
  MOV  AL,[DI].EDEndPointNumber     ;Get EP Address & Direction
  TEST AL,EDDirectionIn             ;Is it In (it better be!)
  JNZ >I30                          ;If so, continue
I701:                               ;To avoid JMP > 128
  JMP >I70                          ;Error
I30:
;  MOV  NewDeviceStage,214           ;Update Stage
  MOV  NewDeviceStage,215           ;Update Stage
  AND  AL,EDNumberMask              ;Store the
  MOV  [SI].I14REndPoint,AL         ;  EndPoint
  MOV  [BX].DIEndPoint,AL           ;  Number
  LEA  AX,[BX].DIRawData            ;Where to
  MOV  W [SI].I14RDataAddress[0],AX ;  put data
  CMP  [BX].DIReportID,0            ;Is there a Report ID?
  JE  >I40                          ;If not, Data Address is OK
  DEC  W [SI].I14RDataAddress[0]    ;If so, Data will include ID
I40:                                ;Data Address is OK
  MOV  W [SI].I14RCallBackAddr[0],DeviceChangeCode ;Code to call
  MOV  NewDeviceStage,73            ;Update Stage
  CALL DoInt14CallAXCXSI            ;Do it
  JC  >I70                          ;If error, quit
  MOV  [BX].DIIntHandle,CX          ;Save the Interrupt Handle
  MOV  LastDeviceFound,BX           ;Mark this as the Last Device
  MOV  [SI].I14RRequestType,I14RRTRegIntfOwner ;Register as Owner
  MOV  W [SI].I14RCallBackAddr[0],DvcOwnerFarCall ;Owner Address
  CALL DoInt14CallAXCXSI            ;Do it
  MOV  [BX].DIRegHandle,CX          ;Store the Registry Handle
  JNC >I80                          ;If it worked, we're done
  MOV  NewDeviceStage,75            ;Update Stage
  MOV  AX,[BX].DIIntHandle          ;If not,
  MOV  [SI].I14RRequestHandle,AX    ;  we need
  MOV  [SI].I14RRequestType,I14RRTCloseHandle  ;  to stop the
  CALL DoInt14CallAXSI              ;  Periodic Interrupt
I70:                                ;Error (DX contains orig BX)
  CALL FinishUpBadDevice            ;Mark it as Bad
  JMP >I90                          ;Done
I80:                                ;Device is OK
  MOV  [SI].I14RRequestType,I14RRTConfigIntfDone ;Request = Done Configuring
  CALL DoInt14CallSaveAllSI         ;Do it
  CMP  Int08Counter,0               ;Disabled?
  JE  >I85                          ;If so, quit
  MOV  Int08Counter,2               ;Look for another Device soon
I85:                                ;Done for now
  AND  TSRFlags,(NOT Int14ReqInUse) ;Mark the request as available
I90:                                ;Done
  RETF


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SUPPORT FUNCTIONS NEEDED BY LOOKFORNEWDEVICE PROCESS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;FINISH UP A BAD DEVICE ENTRY
;Inputs:  BX = Info Table Offset
;         (Info Table Entry contains Device Data)
;         DS = ES = TSR Data Area
;         Int14Request (contains Host/Address/Interface Data)
;Outputs: Resets DeviceInfoTable Entry
;         Marks Int14Request as available (not in use any more)
;         Updates NewDeviceStage & NewDeviceError
;         Puts Device info in BadDevice Table
;         Issues Request to Beep the Speaker
;Changes: DI,SI
;------------------------------------------------------------------------------
FinishUpBadDevice:
  MOV  SI,Int14Request               ;Point at Int14 Request Struc
  MOV  NewDeviceError,AX             ;Store Error Code
  CALL ResetDvcEntryBX               ;Reset the Dvc Info Entry that we Reserved
  MOV  [SI].I14RRequestType,I14RRTGetDvcStatus ;Request = Get Dvc Status
                                               ;(Make sure Device is still
                                               ;  plugged in)
  CALL DoInt14CallSaveAllSI          ;Issue the Request
  JC  >B10                           ;If error (no Device), don't add to Bad Tbl
  CALL AddBadDevice                  ;Add it to Bad Table
B10:                                 ;Bad Device added to table, if appropriate
  TEST TSRFlags,(NoBeep+NoBeep1Time) ;Are we allowed to Beep the Speaker
  JNZ >B20                           ;If not, skip down
  MOV  [SI].I14RRequestType,I14RRTBeepSpeaker ;Want to beep the Speaker
  MOV  [SI].I14RHostIndex,-1         ;Any Host
  MOV  B [SI].I14RTimeout,3          ;Beep length = 3 DeciSeconds
  MOV  W [SI].I14RBeepFrequency,300  ;Frequency = 300Hz
  CALL DoInt14CallSaveAllSI          ;Do it
  MOV  B [SI].I14RTimeOut,0          ;Reset Timeout Value
B20:                                 ;Done handling Beep
  AND  TSRFlags,(NOT NoBeep1Time)    ;Mark as OK to Beep next time
  MOV  [SI].I14RRequestType,I14RRTConfigIntfDone ;Request = Done Configuring
  CALL DoInt14CallSaveAllSI          ;Do it
  CMP  Int08Counter,0                ;Disabled?
  JE  >B90                           ;If so, Done
  MOV  Int08Counter,2                ;Look for another Device soon
B90:                                 ;Done
  AND  TSRFlags,(NOT Int14ReqInUse)  ;Mark the request as available
  RET

;------------------------------------------------------------------------------
;CLEAR OUT THE OLD DATA FROM THE DESCRIPTOR DATA BUFFER
;Inputs:  ES = TSR Data Area
;         CLD already issued
;Outputs:
;Changes: DescriptorData becomes all zeroes
;------------------------------------------------------------------------------
ClearDescriptorData:
  PUSH AX,CX,DI                 ;Save used registers
  MOV  DI,DescriptorData        ;Point at buffer
  MOV  CX,(MaxDescriptorSize/2) ;Number of words to write
  XOR  AX,AX                    ;Write zeroes
  REP  STOSW                    ;Do it
  POP  DI,CX,AX                 ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CLEAR OUT THE OLD DATA FROM THE REPORT DATA BUFFER
;Inputs:  ES = TSR Data Area
;Outputs:
;Changes: ReportData becomes all zeroes
;------------------------------------------------------------------------------
ClearReportData:
  PUSH AX,CX,DI             ;Save used registers
  MOV  DI,ReportData        ;Point at buffer
  MOV  CX,(MaxReportSize/2) ;Number of words to write
  XOR  AX,AX                ;Write zeroes
  REP  STOSW                ;Do it
  POP  DI,CX,AX             ;Restore used registers
  RET

;------------------------------------------------------------------------------
;FIND A PARTICULAR TYPE OF DESCRIPTOR IN THE COMPLETE CONFIGURATION DESCRIPTOR
;Inputs:  DS = ES = TSR Data Area
;         [DI] = Pointer to start/middle of Configuration Descriptor
;          AL  = Descriptor Type to find
;Outputs: CF = Set if OK (Descriptor Found)
;              [DI] points at beginning of Descriptor
;               AX = Descriptor Length
;            = Clear if Error (Descriptor not found)
;              AX, DI unchanged
;Changes:
;------------------------------------------------------------------------------
FindDescrType:
  PUSH BX,SI               ;Save used registers
  MOV  SI,DI               ;Point SI at the starting Pointer
  XOR  BH,BH               ;Initialize high byte of Size to 0
Y10:                       ;Loop here to find Descriptor
  MOV  BL,[SI].DDLength    ;Put the Length in BL
  OR   BL,BL               ;Valid Descriptor?
  JZ  >Y70                 ;If not, Error
  CMP  AL,[SI].DDDescrType ;The Descriptor we're looking for?
  JE  >Y80                 ;If so, we're done
  ADD  SI,BX               ;If not, point at next Descriptor
  CMP  SI,(DescriptorData+MaxDescriptorSize) ;Gone past the end of the buffer?
  JBE  Y10                 ;If not, keep looking
Y70:                       ;Error
  STC                      ;Set Error Flag
  JMP >Y90                 ;Done
Y80:                       ;OK
  MOV  DI,SI               ;Update Pointer
  MOV  AX,BX               ;Put length in AX
  CLC                      ;Set OK Flag
Y90:                       ;Done
  POP  SI,BX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;COPY A REQUEST (CONTROL) STRUCTURE INTO THE INT14 STRUCTURE
;Inputs:  [CX] = Request Structure to Copy
;          ES  = TSR Data Area (contains both Request & Int14 Request)
;         [DI] = Int14 Request Structure to copy it to
;      or [SI] = Int14 Request Structure to copy it to
;Outputs:
;Changes: Int14 Structure contains Request Structure Data
;------------------------------------------------------------------------------
CopySetupReqToInt14SI:
  PUSH DI                    ;Save used registers
  MOV  DI,SI                 ;Put pointer in DI
  CALL CopySetupReqToInt14DI ;Copy it
  POP  DI                    ;Restore used registers
  RET

CopySetupReqToInt14DI:
  PUSH CX,DI,SI,DS                ;Save used registers
  MOV  DS,ES                      ;Point DS at correct Data Area
  ADD  DI,OFFSET I14RSetupReqData ;Point at correct part of structure
  MOV  SI,CX                      ;Point at structure to copy
  MOV  CX,(SetupRequestSize/2)    ;Number of words to copy
  REP  MOVSW                      ;Copy it
  POP  DS,SI,DI,CX                ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO DECIPHER THE REPORT DESCRIPTOR
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;DECIPHER THE REPORT DESCRIPTOR TO DETERMINE THE JOYSTICK CHARACTERISTICS
;Inputs:  ReportData
;         DS = ES = TSR Data Area
;         BX = Info Table Pointer
;Outputs: CF = Clear if OK (found valid Data)
;            = Set if Error (not a valid Joystick/GamePad)
;         UsagePage, Usage, Collection, ReportSize, ReportCount, Input,
;         UsageMin, UsageMax, LogicalMin, LogicalMax, PhysicalMin, PhysicalMax
;Changes:
;NOTES: To keep this code simple, we will assume that the Joystick and the
;         Report Descriptor don't do or have anything really weird (like
;         PUSH's and POP's).
;------------------------------------------------------------------------------
DecipherReportDescr:
  PUSH AX,BX,DI,SI,BP                ;Save used registers
  CALL ResetRptVars                  ;Initialize Report Variables
  MOV  SI,ReportData                 ;Point at Data
  MOV  BP,(ReportData+MaxReportSize) ;Point at end of data
  CALL LookForJoystick               ;Is it a Joystick or GamePad?
  JC  >D70                           ;If not, just quit
  LEA  DI,[BX].DIControlsData        ;If so, point at Control Struc
  MOV  BH,MaxControls                ;Initialize Control Counter
  XOR  BL,BL                         ;Starting Bit Offset = 0
D10:                                 ;Loop to here for each Ctl Grp
  CALL FindNextIOFTag                ;Scan thru the next Ctl Grp
  JC  >D80                           ;If done, just quit
  CMP  DL,RPtTagInput                ;Is it Input?
  JNE  D10                           ;If not, just continue
  MOV  IOFValue,AX                   ;If OK, store value
  CALL CalcControlType               ;See what kind of Control it is
  JC   D10                           ;If unknown, just continue
  CALL FillControlEntry              ;If OK, fill in the Table Entry
  JC   D10                           ;If invalid, try the next one
  ADD  DI,ControlStrucSize           ;Point at next Control
  DEC  BH                            ;Decrement the Counter
  JNZ  D10                           ;If not 0 yet, keep looking
  JMP >D80                           ;Done
D70:                                 ;Error
  STC                                ;Set Error Flag
  JMP >D90                           ;Done
D80:                                 ;OK
  CLC                                ;Set OK Flag
D90:                                 ;Done
  POP  BP,SI,DI,BX,AX                ;Restore used registers
  RET

;------------------------------------------------------------------------------
;RESET THE TEMPORARY REPORT VARIABLES TABLE TO ALL ZEROES
;Inputs:  ES = TSR Data Area
;         CLD already issued
;Outputs:
;Changes: All temporary report variables (UsagePage, Usage, etc)
;------------------------------------------------------------------------------
ResetRptVars:
  PUSH AX,CX,DI            ;Save used registers
  MOV  DI,OFFSET UsagePage ;Point at Table
  XOR  AX,AX               ;Fill with zeroes
  MOV  CX,RptVarsSize      ;Number of words to write
  REP  STOSW               ;Do it
  POP  DI,CX,AX            ;Restore used registers
  RET

;------------------------------------------------------------------------------
;SEE IF THE HID REPORT DESCRIPTOR IS FOR A GAMEPAD OR A JOYSTICK
;Inputs:  [SI] = Report Descriptor
;         [DI] = End of Report Descriptor
;Outputs: CF = Clear if it is a Josytcik or a GamePad
;            = Set if not
;Changes: SI, UsagePage, Usage, Collection
;NOTES:   According to the USB Spec, this should be at the top of the Descr:
;           Usage Page = Generic DeskTop, Usage = Joystick or GamePad,
;           Collection = Application, Usage = Pointer, Collection = Physical
;         We look for those exat things in that exact order.
;         If it's not there, we reject it as not being a Joystick or GamePad!

;         Well, things have changed.  A Logitech Precision GamePad (and
;           possibly other josyticks/gamepads as well) do not follow the
;           standards.  Well, knock me over with a feather!
;         The Logitech Precision Joystick has the first three items,
;           but the the Usage = Pointer & Collection = Physical.
;           So, we'll not check for those any more.
;------------------------------------------------------------------------------
LookForJoystick:
  PUSH AX                         ;Save used registers
J10:                              ;Look for Generic DeskTop Usage Page
  MOV  AL,RptTagUsagePage         ;Look for
  CALL LookForReportTag           ;  Usage Page
  JC  >J70                        ;If Error, Quit
  CMP  AL,RptGlbUPGenericDeskTop  ;Is it Generic DeskTop?
  JNE >J70                        ;If not, Quit
  MOV  UsagePage,AX               ;If OK, Store the Usage Page
J20:                              ;Look for Joystick or GamePad Usage
  MOV  AL,RptTagUsage             ;Look for
  CALL LookForReportTag           ;  Usage
  JC  >J70                        ;If Error, Quit
  OR   TSRFlags,NoBeep1Time       ;Don't Beep if not a GamePad or Joystick
  CMP  AL,RptGDJoystick           ;Is it Joystick?
  JE  >J25                        ;If so, continue
  CMP  AL,RptGDGamePad            ;Is it GamePad?
  JNE >J70                        ;If not, Quit
J25:                              ;Is Joystick or GamePad
  AND  TSRFlags,(NOT NoBeep1Time) ;Allow Beeps again
  MOV  Usage,AX                   ;Store the Usage
J30:                              ;Look for Physical Collection
  MOV  AL,RptTagCollection        ;Look for
  CALL LookForReportTag           ;  Collection
  JC  >J70                        ;If Error, Quit
  CMP  AL,RptMainColApplication   ;Is it Application?
  JNE >J70                        ;If not, Quit
  MOV  Collection,AX              ;If OK, Store the Collection
;J40:                              ;Look for Pointer Usage
;  MOV  AL,RptTagUsage             ;Look for
;  CALL LookForReportTag           ;  Usage
;  JC  >J70                        ;If Error, Quit
;  CMP  AL,RptGDPointer            ;Is it Pointer?
;  JNE >J70                        ;If not, Quit
;  MOV  Usage,AX                   ;Store the Usage
;J50:                              ;Look for Physical Collection
;  MOV  AL,RptTagCollection        ;Look for
;  CALL LookForReportTag           ;  Collection
;  JC  >J70                        ;If Error, Quit
;  CMP  AL,RptMainColPhysical      ;Is it Physical?
;  JNE >J70                        ;If not, Quit
;  MOV  Collection,AX              ;If OK, Store the Collection
  JMP >J80                        ;Done
J70:                              ;Error
  STC                             ;Set Error Flag
  JMP >J90                        ;Done
J80:                              ;OK
  CLC                             ;Set OK Flag
J90:                              ;Done
  POP  AX                         ;Restore used registers
  RET

;------------------------------------------------------------------------------
;LOOK FOR A SPECIFIC REPORT TAG IN THE REPORT DESCRIPTOR
;Inputs:  [SI] = Report Pointer
;         [BP] = End of Report Data Area
;         AL   = Report Tag to Look for
;Outputs: CF = Clear if Tag was found
;              AX  = Data Word immediately following the Tag
;                    AH = 0 if it is just a byte!
;             [SI] = Points to next Tag after the one found
;            = Set if Tag was not Found
;              AX = 0
;              SI >= BP
;Changes:
;NOTES: This works under the premise that Data is at most two bytes
;         after a Report Tag (which all Joystick Data should be!)
;------------------------------------------------------------------------------
LookForReportTag:
  PUSH BX,CX        ;Save used registers
  XOR  CH,CH        ;Size Adder is always a Byte
  MOV  BL,AL        ;Save Tag we're looking for
L10:                ;Loop to here to find the Tag
  LODSB             ;Get the next Tag
  OR   AL,AL        ;Legitimate Tag?
  JZ  >L70          ;If not, error
  MOV  CL,AL        ;Get the
  AND  CL,03h       ;  Data Size
  AND  AL,(NOT 03h) ;Mask out the Size so we can test it
  CMP  AL,BL        ;Is it the Tag we're looking for?
  JE  >L80          ;If so, we're done
  ADD  SI,CX        ;If not, point at the next one
  CMP  SI,BP        ;Are we past the end of the buffer?
  JB   L10          ;If not,I keep looking
L70:                ;Error
  XOR  AX,AX        ;AX = 0
  STC               ;Set Error Flag
  JMP >L90          ;Done
L80:                ;Found it
  XOR  AX,AX        ;Assume 0 bytes of data
  CMP  CL,1         ;How many data bytes are there?
  JB  >L85          ;If 0 bytes, handle it
  JA  >L82          ;If 2, handle it
  LODSB             ;If one, get the Data
  JMP >L85          ;Done
L82:                ;Data is two bytes
  LODSW             ;Get the Data
L85:                ;Have Data
  CLC               ;Set OK Flag
L90:                ;Done
  POP  CX,BX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;LOOK FOR THE NEXT INPUT, OUTPUT, OR FEATURE TAG IN THE REPORT DESCRIPTOR
;Inputs:  [SI] = Current pointer
;          BP  = End of Data Area
;Outputs: CF = Clear if valid data is found
;              Temp variables (UsagePage, Usage, etc.) updated appropriately
;              DL = Input/Output/Feature Tag (without the Size)
;              AX = Data Byte/Word after the Tag
;            = Set if no more data
;Changes: SI
;NOTES: This assumes that Tags only contain byte or word data, not DWord data.
;         If it ever does, we will be screwed up!
;       There's no legitimate reason a device would have DWord data, though, other
;         than the fact that it's possible to do.
;------------------------------------------------------------------------------
FindNextIOFTag:
  PUSH BX,CX               ;Save used registers
  XOR  CH,CH               ;Size comes in bytes
I10:                       ;Loop to here for each non-IOF
  CMP  SI,BP               ;End of Data Area?
  JAE >I70                 ;If so, quit
  LODSB                    ;Get the Tag
  OR   AL,AL               ;End of Data?
  JZ  >I70                 ;If so, quit
  MOV  CL,AL               ;Put Data Size
  AND  CL,03h              ;  in CX
;  CMP  CL,03h              ;Is it 4 bytes of data?
;  JE  >I15                 ;If so, skip it
  AND  AL,(NOT 03h)        ;Take size out of Tag
  CMP  AL,RptTagInput      ;Input?
  JE  >I50                 ;If so, we're done
  CMP  AL,RptTagOutput     ;Output?
  JE  >I50                 ;If so, we're done
  CMP  AL,RptTagFeature    ;Feature?
  JE  >I50                 ;If so, we're done
  MOV  BX,TagLookupTbl     ;Convert Tag to
  CALL SearchByteToWordTbl ;  a Pointer
  JNC >I20                 ;If Tag is recognized, handle it
;I15:                       ;Done with Tag
  ADD  SI,CX               ;If not recognized, Update Pointer
  JMP >I30                 ;Done with this one
I20:                       ;Valid tag
  CMP  CL,1                ;How big is the data?
  JB  >I30                 ;If 0 bytes, just continue
  JA  >I25                 ;If 2 bytes, handle it
  LODSB                    ;If one byte, get it
  XOR  AH,AH               ;Set high byte to 0
;  MOV  [BX],AX             ;  store it
;  JMP >I30                 ;Done
  JMP >I28                 ;Jump to store it
I25:                       ;Is two bytes long
  LODSW                    ;Get teh Data
I28:                       ;AX = Data to Store
  MOV  [BX],AX             ;Store the Data
I30:                       ;Have Data updated
  JMP  I10                 ;Keep looking
I50:                       ;Have IOF
  MOV  DL,AL               ;Put Tag in DL
  XOR  AX,AX               ;Assume Byte
  CMP  CL,1                ;How big is the data?
  JB  >I80                 ;If 0 bytes, we're done
  JA  >I55                 ;If two bytes, Handle it
  LODSB                    ;If one byte, get the Data
  JMP >I80                 ;Done
I55:                       ;Two-byte Tag
  LODSW                    ;Get the Data
  JMP >I80                 ;Done
I70:                       ;End of Data
  STC                      ;Set flag
  JMP >I90                 ;Done
I80:                       ;Have valid data
  CLC                      ;Set flag
I90:                       ;Done
  POP  CX,BX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE THE TYPE OF CONTROL DESCRIBED BY THE HID REPORT DESCRIPTOR
;Inputs:  UsagePage, Usage
;Outputs: CF = Clear if Valid data
;              AL = Control Type (Button, D-Pad, etc.)
;            = Set if Error (Unknown Type)
;              AL = 0
;Changes:
;------------------------------------------------------------------------------
CalcControlType:
  PUSH BX                        ;Save used regsiters
  MOV  BL,B UsagePage[0]         ;Get Usage Page
  MOV  AL,B Usage[0]             ;Get Usage
  CMP  BL,RptGlbUPGenericDeskTop ;Is it Generic Desktop?
  JE  >C10                       ;If so, handle it
  CMP  BL,RptGlbUPSimulationCtl  ;Is it Simulation Control?
  JE  >C40                       ;If so, handle it
  CMP  BL,RptGlbUPGameCtl        ;Is it Game Control?
  JE  >C50                       ;If so, handle it
  CMP  BL,RptGlbUPButton         ;Is it Button?
  JE  >C60                       ;If so, handle it
  JMP >C701                      ;If not, we don't know what it is!
C10:                             ;Generic Desktop
  MOV  BL,CTAxis                 ;Assume Axis
  CMP  AL,RptGDXAxis             ;Axis?
  JB  >C701                      ;If not, Error
  CMP  AL,RptGDRotateZ           ;Axis?
  JBE >C801                      ;If so, Done
  MOV  BL,CTSlider               ;Assume Slider
  CMP  AL,RptGDSlider            ;Slider?
  JE  >C801                      ;If so, Done
  CMP  AL,RptGDDial              ;Dial?
  JE  >C801                      ;If so, Done
  MOV  BL,CTDPad                 ;Assume D-Pad/Hat Switch
  CMP  AL,RptGDHatSwitch         ;Hat Switch?
  JE  >C801                      ;If so, Done
  CMP  AL,RptGDDPadUp            ;D-Pad?
  JB  >C15                       ;If not, continue
  CMP  AL,RptGDDPadLeft          ;D-Pad?
  JBE >C801                      ;If so, Done
C15:                             ;Not D-Pad/HatSwitch
  MOV  BL,CTButton               ;Assume Button
  CMP  AL,RptGDStart             ;Button?
  JB  >C70                       ;If not, Error
  CMP  AL,RptGDSelect            ;Button?
  JBE >C801                      ;If so, Done
  JMP >C701                      ;If none of these, Error
C40:                             ;Simulation Controls
  MOV  BL,CTAxis                 ;Assume Axis
  CMP  AL,RptSimFlightCtlStick   ;Axis?
  JB  >C701                      ;If not, Error
  CMP  AL,RptSimFlightStick      ;Axis?
  JBE >C801                      ;If so, Done
  MOV  BL,CTThrottle             ;Assume Throttle
  CMP  AL,RptSimThrottle         ;Throttle?
  JE  >C801                      ;If so, Done
C701:
  JMP >C70                       ;If none of these, Error
C801:
  JMP >C80
C50:                             ;Game Controls
  MOV  BL,CTDPad                 ;Assume D-Pad/HatSwitch
  CMP  AL,RptGamePOV             ;Hat Switch?
  JE  >C80                       ;If so, done
  MOV  BL,CTAxis                 ;Assume Axis
  CMP  AL,RptGameTurn            ;Axis?
  JB  >C70                       ;If not, Error
  CMP  AL,RptGamePOVHeight       ;Axis?
  JBE >C80                       ;If so, continue
  MOV  BL,CTButton               ;Assume Button
  CMP  AL,RptGameFlipper         ;Button?
  JBE >C70                       ;If not, Error
  CMP  AL,RptGamePadTrigger      ;Button?
  JBE >C80                       ;If so, Done
  JMP >C70                       ;If none of these, Error
C60:                             ;Buttons
  MOV  BL,CTButton               ;Always a Button!
  JMP >C80                       ;Done
C70:                             ;Error
  XOR  AL,AL                     ;Set
  STC                            ;  Error Flags
  JMP >C90                       ;Done
C80:                             ;OK
  MOV  AL,BL                     ;Set return byte
  CLC                            ;Set OK flag
C90:                             ;Done
  POP  BX                        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;FILL IN THE CONTROL TABLE ENTRY WITH APPROPRIATE DATA
;Inputs:  DS = ES = TSR Data Area
;         AL   = Control Type (Button, DPad, etc.)
;         BL   = Current Bit Offset Counter
;         [DI] = Table entry to fill in
;         Temp Report variables containing Data (UsagePage, Usage, etc.)
;Outputs: CF = Clear if OK
;              Fills in Table Entry at [DI]
;              Updates BL
;            = Set if Error
;Changes:
;------------------------------------------------------------------------------
FillControlEntry:
  PUSH AX,CX,DX               ;Save used registers
  MOV  AH,B ReportCount[0]    ;Get Number of Controls
  MOV  DL,B ReportSize[0]     ;Get Report Size
  CMP  AL,CTButton            ;Possible Button?
  JNE >E80                    ;If not, just store it
E10:                          ;Possible Button
  CMP  DL,1                   ;Is it really a button?
  JNE >E70                    ;If not, error
  CMP  IOFValue,RptMainIOFConstant ;Is it a constant?
  JNE >E80                    ;If so, Error
E70:                          ;Error
  STC                         ;Set Error Flag
  JMP >E90                    ;Done
E80:                          ;OK
  MOV  [DI].ControlType,AL    ;Store Control Type
  MOV  [DI].ControlQty,AH     ;Store Control Quantity
  MOV  [DI].ControlOffset,BL  ;Store Control Offset
  MOV  [DI].ControlNumBits,DL ;Store number of Bits per Entry
  CALL FillMinMax             ;Store Minimum and Maximum
  CLC                         ;Set Flag
E90:                          ;Done
  CALL CalcNextOffset         ;Update the Offset
  POP  DX,CX,AX               ;Restore used registers
  RET


;------------------------------------------------------------------------------
;FILL IN THE MIN/MAX VALUES IN THE CONTROL TABLE
;Inputs:  DS = ES = TSR Data Area
;         [DI] = Control Table entry to fill in
;         Temp Report variables containing Data (UsagePage, Usage, etc.)
;Outputs: Fills in ControlMin, ControlMax
;Changes:
;NOTE: All Joysticks are SUPPOSED to return the values stated as the Logical
;        Minimum and Logical Maximum in the Report Descriptor.  At least one
;        joystick (the one I have made by Inland), doesn't.  It returns
;        the values defined by Physical Min and Physical Max.  We try to test
;        for this possibility by assuming that if the Logical Min is
;        Negative, the Physical Min is 0, and the Physical Max is more than
;        the Physical Min, it is a joystick that needs to use the
;        Physical values instead of the Logical Values.  This hopefully won't
;        cause problems with any joysticks that work like they're supposed to.
;------------------------------------------------------------------------------
FillMinMax:
  PUSH AX,BX,CX,DX        ;Save used registers
  MOV  AX,LogicalMin      ;Get Logical Min
  MOV  BX,LogicalMax      ;  and Logical Max
  CMP  AX,BX              ;Is Logical Min less than Max?
  JB  >L80                ;If so, use Logical Values
  OR   AH,AH              ;Does AX have any high bits set?
  JNZ >L10                ;If so, it's already a word
  CBW                     ;If not, sign-extend AL to a Word
L10:                      ;AX is a complete word
  MOV  CX,PhysicalMin     ;Get Physical Min
  MOV  DX,PhysicalMax     ;  and Physical Max
  OR   CX,CX              ;Is the Physical Min 0?
  JNZ >L80                ;If not, we'll assume things are OK
  SUB  DX,CX              ;Calculate the difference between Physical Min and Max
  JZ  >L80                ;If no difference, we're done
  MOV  CX,BX              ;Calculate the difference between
  SUB  CX,AX              ;  Logical Min and Max
  CMP  CX,DX              ;Are the differences the same?
  JNE >L80                ;If not, use the Logical Values
  MOV  AX,PhysicalMin     ;If so, use Physical Min
  MOV  BX,PhysicalMax     ;  and Physical Max
L80:                      ;Done
  MOV  [DI].ControlMin,AX ;Store Min
  MOV  [DI].ControlMax,BX ;  and Max
  POP  DX,CX,BX,AX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE AND STORE THE OFFSET OF THE NEXT CONTROL ENTRY
;Inputs:  BL = Current Offset
;         ReportCount, ReportSize
;Outputs: BL = BL + (ReportCount * ReportSize)
;         Preserves Flags!
;Changes:
;------------------------------------------------------------------------------
CalcNextOffset:
  PUSHF                    ;Save flags
  PUSH AX                  ;Save used registers
  MOV  AL,B ReportCount[0] ;Get Report Count
  MUL  B ReportSize[0]     ;Multiply by Report Size
  ADD  BL,AL               ;Add it to the Offset
  POP  AX                  ;Restore used registers
  POPF                     ;Restore Flags
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE JOYSTICK MOVEMENTS AND BUTTONS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;THIS CODE IS PROCESSED EVERY TIME AN INTERRUPT COMES FROM THE DEVICE
;Inputs:  DS = ES = TSR Data Area
;         [BX] = Info Table Offset (contains DeviceData)
;Outputs: Processes "Raw" Joystick data into an appropriate format
;Changes: Lots of things
;------------------------------------------------------------------------------
DeviceChangeCode:
  OR   CX,CX                  ;Did we get any data?
  JZ  >V90                    ;If not, quit
  MOV  AL,[BX].DIReportIDData ;Is it the Correct
  CMP  AL,[BX].DIReportID     ;  Report ID?
  JNE >V90                    ;If not, try the next possibility
  CALL DeviceChangeJoystick   ;If so, handle it
V90:                          ;Done
  RETF                        ;Quit

;------------------------------------------------------------------------------
;HANDLE THE DEVICE NOTIFICATION FOR THE JOYSTICK REPORT ID
;Inputs:  DS = ES = TSR Data Area
;         [BX] = Info Table Offset (contains DeviceData)
;Outputs: Processes "Raw" Joystick data into an appropriate format
;Changes: Lots of things, including possibly all Registers
;------------------------------------------------------------------------------
DeviceChangeJoystick:
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO PROCESS NOTIFICATIONS FROM THE HOST DRIVER REGARDING DEVICE CHANGES
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HANDLE A NOTIFICATION FROM THE HOST DRIVER FOR SOMETHING RELATED TO THE DEVICE
;Inputs:   DS = ES = TSR Data Area
;          AX  = Device Owner Call Code (various possibilities)
;         [BX] = Info Table Offset
;          CX, DX = Varies by exact type of call
;Outputs: Depends on Call Type
;         Calls appropriate "subfunction"
;Changes: Nearly all registers
;------------------------------------------------------------------------------
DvcOwnerFarCall:
  MOV  DI,BX                   ;Point DI at the Info Table Entry
  MOV  BX,OwnerCallFunctionTbl ;Point at the Function table to search
  CALL SearchByteToWordTbl     ;Look for the function (in AL)
  JC  >H90                     ;If invalid function, quit
  CALL BX                      ;If OK, do it
H90:
  RETF

;------------------------------------------------------------------------------
;HANDLE A REQUEST FROM THE HOST SAYING THAT A NEW DEVICE HAS BEEN ADDED
;Inputs:   DS = ES = TSR Data Area
;         [DI] = Info Table Entry
;          CL  = Host Index
;          CH  = Device Address
;          DL  = Interface
;          DH  = Alternate Interface
;Outputs:
;Changes: Prompts us to look for a new Device earlier than normal
;NOTES:   Originally, this routine directly called LookForNewDevice.
;         For some reason, this did not work with some Devices (they would
;           return bad descriptors).  This is probably due to the Devices not
;           being given enough time to "reorganize" themselves after the
;           enumeration process of the Host Driver, which downloads the same
;           descriptors we download again here.
;         So now, instead of calling LookForNewDevice directly, this routine
;           sets the Int08Counter to a small number so that we look for
;           the new Device after a small delay.  Doing it after a small
;           delay, instead of doing it immediately, seems to work better
;           (at least with some Devices).
;------------------------------------------------------------------------------
DeviceAdded:
  CMP  Int08Counter,0 ;Disabled?
  JE  >A90            ;If so, quit
  MOV  Int08Counter,2 ;If not, look for a new Device right away
A90:                  ;Done
  RET

;------------------------------------------------------------------------------
;HANDLE A REQUEST FROM THE HOST SAYING THAT A DEVICE HAS BEEN DISCONNECTED
;Inputs:   DS = ES = TSR Data Area
;         [DI] = Info Table Entry
;          CL  = Host Index
;          CH  = Device Address
;Outputs:
;Changes: Removes Device from Configuration
;NOTES:   The Host Driver should automatically close the Periodic Interrupt
;         This is called if a REGISTERED Device has been disconnected.
;         This is also called when an Upstream device is Disconnected
;------------------------------------------------------------------------------
DeviceDisconnected:
  CALL ResetDvcEntryDI ;Delete entry from our table
  RET

;------------------------------------------------------------------------------
;HANDLE A REQUEST FROM THE HOST SAYING THAT AN UNREGISTERED DEVICE IS DISCO'D
;Inputs:  DS = ES = TSR Data Area
;         CL = Host Index
;         CH = Device Address
;Outputs:
;Changes:
;NOTES: This is called if an UNREGISTERED Device has been disconnected,
;         so it will NOT be in DeviceInfoTable.  It may or may not be
;         in the BadDeviceTable.
;------------------------------------------------------------------------------
Device0Disconnected:
  CALL DeleteBadDevices ;Delete the Entries from Bad Device Table (Uses CX)
  RET

;------------------------------------------------------------------------------
;HANDLE A REQUEST FROM THE HOST TO TEMPORARILY STOP LOOKING FOR DEVICES
;Inputs:   DS = ES = TSR Data Area
;         [DI] = Info Table Pointer
;          CL  = Host Index
;          CH  = Device Address
;          DL  = Interface Number
;          DH  = TimeOut Value to use (deciseconds)
;Outputs: DontLookCounter
;Changes:
;NOTES: This should only be called if a Device-specific Driver is trying
;         to take control of an already registered device from us.
;       We actually stop looking for ALL new Interfaces, rather than just
;         the one that is being requested.
;------------------------------------------------------------------------------
StartDontLook:
  PUSH AX,BX,DX,SI        ;Save used registers
  MOV  DontLookCounter,-1 ;Start not looking
  MOV  SI,Int14Request2   ;Point at Request Structure
  CALL RlsDvcNoResetDI    ;Release the Device, don't Reset it
  MOV  AL,DH              ;Put deciseconds in AL
  XOR  AH,AH              ;Multiply
  MOV  BX,18206           ;  deciseconds
  MUL  BX                 ;  by
  MOV  BX,10000           ;  1.8206
  DIV  BX                 ;  (number of timer ticks per decisecond)
  CMP  DX,5000            ;Do we need to round up?
  JB  >S90                ;If not, continue
  INC  AX                 ;If so, round up
S90:                      ;Done
  INC  AX                 ;Add one more Timer Tick for good measure
  MOV  DontLookCounter,AX ;Store the Counter Value
  POP  SI,DX,BX,AX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;HANDLE A REQUEST FROM A HOST SAYING THAT IT'S BEEN UNINSTALLED
;Inputs:   DS = ES = TSR Data Area
;         [DI] = Info Table Pointer
;          CL  = USB Host Index that isn't there any more
;Outputs:
;Changes: Removes appropriate Host Index & Devices from Tables
;------------------------------------------------------------------------------
HostDisconnected:
  PUSH BX,DI                    ;Save used registers
  MOV  DI,DeviceInfoTable       ;Point at table
  MOV  BL,MaxDevices            ;Number of table entries
D20:                            ;Loop to here for each table entry
  TEST [DI].DIFlags,DIFlagInUse ;Empty Table Entry?
  JZ  >D40                      ;If so, skip it
  CMP  [DI].DIHostIndex,CL      ;Is it the Host this Device is on?
  JNE >D40                      ;If not, skip it
  CALL ResetDvcEntryDI          ;If so, delete it from the Info Table
D40:                            ;Done with this table entry
  ADD  DI,DeviceInfoStrucSize   ;Point at the next Table Entry
  DEC  BL                       ;Decrement loop counter
  JNZ  D20                      ;If not done yet, keep looking
  POP  DI,BX                    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;HANDLE VARIOUS REQUESTS FROM THE USB HOST DRIVER ABOUT UPSTREAM CHANGES
;Inputs:   DS = ES = TSR Data Segment
;          Other registers: Depends on Call
;Outputs:
;Changes: We don't care about any of these calls, since they don't directly
;           affect our program.  Any critical changes to upstream devices
;           are eventually reflected to us as a call directly addressing
;           one of our Devices, which is how we handle those things.
;------------------------------------------------------------------------------
DeviceEnabled:        ;Device Enabled
DeviceDisabled:       ;Device Disabled
DeviceReset:          ;Device Reset
DeviceSuspend:        ;Device Suspended
DeviceResume:         ;Device Resumed
DevicePowerOn:        ;Device Power On
DevicePowerOff:       ;Device Power Off
DevicePowerReset:     ;Device Power Reset
NewHostAdded:         ;New Host Added
HostHWErr:            ;Host System/Processor Error
HostRun:              ;Host Running
HostStop:             ;Host Stopped
HostReset:            ;Host Reset
HostSuspend:          ;Host Suspended
HostResume:           ;Host Resumed
HostDebug:            ;Host in Debug Mode
HostSST:              ;Host Single-Stepped
TimingChange:         ;Host Timing Change
DeviceDisconnectedUS: ;Device Disconnect Upstream
DeviceEnabledUS:      ;Device Enable Upstream
DeviceDisabledUS:     ;Device Disable Upstream
DeviceResetUS:        ;Device Reset Upstream
DeviceSuspendUS:      ;Device Suspend Upstream
DeviceResumeUS:       ;Device Resume Upstream
DevicePowerOnUS:      ;Device Power On Upstream
DevicePowerOffUS:     ;Device Power Off Upstream
DevicePowerResetUS:   ;Device Power Reset Upstream
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SUPPORT CODE TO RELEASE/RESET A DEVICE
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;COMPLETELY RELEASE A DEVICE THAT WE CURRENTLY OWN (POSSIBLY INCLUDING A RESET)
;Inputs:   DS = ES = TSR Data Area
;         [DI] = Device Info Entry to Release
;         [SI] = Int 14 Request to use
;Outputs: Releases Device Entry
;           Closes Periodic Handle
;           Unregisters as Interface Owner
;           Resets Device (if appropriate)
;           Resets Device Info Entry
;Changes:
;------------------------------------------------------------------------------
RlsDvcNoResetDI:
  PUSH BX                                        ;Save used registers
  XOR  BL,BL                                     ;Mark as No Reset
  JMP >R00                                       ;Do it
RlsDvcDoResetDI:
  PUSH BX                                        ;Save used registers
  MOV  BL,-1                                     ;Mark as a Reset
;  JMP >R00                                       ;Do it
R00:
  PUSH AX                                        ;Save used registers
  MOV  W [SI].I14RCallBackAddr[0],-1             ;Set CallBackAddr to nothing
  MOV  AX,W [DI].DIHostIndex                     ;Copy Host Index and
  MOV  W [SI].I14RHostIndex,AX                   ;  Device Address
  MOV  AX,[DI].DIIntHandle                       ;Copy
  MOV  [SI].I14RRequestHandle,AX                 ;  Interrupt Handle Number
  MOV  [SI].I14RRequestType,I14RRTCloseHandle    ;Request = Close Handle
  CALL DoInt14CallSaveAllSI                      ;Do it
  MOV  AX,[DI].DIRegHandle                       ;Copy
  MOV  [SI].I14RRequestHandle,AX                 ;  Registry Handle
  MOV  [SI].I14RRequestType,I14RRTUnRegIntfOwner ;Request = UnRegister
  CALL DoInt14CallSaveAllSI                      ;Do it
  OR   BL,BL                                     ;Need to Reset the Device?
  JZ  >R80                                       ;If not, we're done
  MOV  [SI].I14RRequestType,I14RRTResetDevice    ;Request = Reset
  CALL DoInt14CallSaveAllSI                      ;Do it
R80:                                             ;Done with Host
  CALL ResetDvcEntryDI                           ;Delete the Device Info Entry
  POP  AX                                        ;Restore used registers
  POP  BX                                        ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SUPPORT CODE FOR DEVICE INFO TABLE
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;RESET A DEVICE INFO TABLE ENTRY
;Inputs:  DS = ES = TSR Data Area
;        [BX] or [DI] = Info Table Entry to reset
;         CLD already issued
;Outputs:
;Changes: Resets (clears out) Info Table Entry
;NOTES:   This preserves the Disabled/Enabled status of
;           the Device, so that the user does not need to worry about
;           re-setting it after a temporary Disconnect or Host Reset.
;         Unlike most routines, this one preserves Flags across the Call!
;------------------------------------------------------------------------------
ResetDvcEntryBX:
  PUSH DI              ;Save used registers
  MOV  DI,BX           ;Point DI at the Table Entry
  CALL ResetDvcEntryDI ;Reset the Entry
  POP  DI              ;Restore used registers
  RET

ResetDvcEntryDI:
  PUSH AX,CX,DI ;Save used registers
  PUSHF         ;Save flags
  CLI           ;Disable interrupts
  XOR  AX,AX    ;Need to store zeroes
  MOV  CX,(DeviceInfoStrucSize/2) ;Number of words to store
  REP  STOSW    ;Reset the reset of the table
  POPF          ;Restore flags
  POP  DI,CX,AX ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO FIND/STORE ENTRIES IN VARIOUS STRUCTURE-BASED TABLES
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;CONVERT A DEVICE INFO INDEX TO AN OFFSET
;Inputs:  ES = Data Segment where data is located
;         CL = Device Index, or BL = Device Index (if DIIndex2OffsetBL)
;Outputs: DI = Offset to Table Entry (Assuming ES is the segment)
;Changes:
;------------------------------------------------------------------------------
DIIndex2OffsetBL:
  PUSH CX             ;Save used registers
  MOV  CL,BL          ;Put Index in CL
  CALL DIIndex2Offset ;Do it
  POP  CX             ;Restore used registers
  RET

DIIndex2Offset:
  PUSH AX,CX,DX               ;Save used registers
  XOR  CH,CH                  ;Index is actually a byte
  MOV  DI,DeviceInfoTable     ;Offset to beginning of Table
  MOV  AX,DeviceInfoStrucSize ;Size of each entry
  MUL  CX                     ;Multiply Index by the size of each entry
  ADD  DI,AX                  ;Add the offset of the beginning of the table
  POP  DX,CX,AX               ;Restore used registers
  RET

;------------------------------------------------------------------------------
;FIND AN EMPTY INFO TABLE ENTRY
;Inputs:  DS = ES = TSR Data Area
;Outputs: ZF = Clear if OK (found an empty Table entry)
;              [BX] = Table Entry
;            = Set if error (Table is full)
;               BX  = 0
;Changes:
;------------------------------------------------------------------------------
FindEmptyInfoBX:
  PUSH CX                       ;Save used registers
  MOV  BX,DeviceInfoTable       ;Point at first Table Entry
  MOV  CX,MaxDevices            ;Number of Table Entries
E10:                            ;Loop to here to find empty Table Entry
  TEST [BX].DIFlags,DIFlagInUse ;Empty Table entry?
  JZ  >E90                      ;If so, continue
  ADD  BX,DeviceInfoStrucSize   ;Point at next table entry
  LOOP E10                      ;Keep looking
  XOR  BX,BX                    ;Table is full!
E90:                            ;Done
  OR   BX,BX                    ;Set Return Flag
  POP  CX                       ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SUPPORT CODE FOR BAD DEVICE TABLE
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;ADD A BAD (INCOMPATIBLE) DEVICE HOST & ADDRESS TO THE TABLE
;Inputs:  DS:[SI] = Int 14 Structure containing Bad Device Data (Host/Addr/Intf)
;Outputs: Adds Host & Address to Bad Device Table
;Changes:
;------------------------------------------------------------------------------
AddBadDevice:
  PUSH AX,BX,CX                 ;Save used registers
  PUSHF                         ;Save Flags
  CLI                           ;Disable Interrupts
  MOV  BX,BadDeviceTable        ;Point at Table
  MOV  CX,MaxBadDevices         ;Number of Entries in Table
A20:                            ;Loop here to find empty table entry
  TEST [BX].BDFlags,BDFlagInUse ;This entry already used?
  JNZ >A50                      ;If so, skip it
  OR   [BX].BDFlags,BDFlagInUse ;If not, mark it as used
  MOV  AX,W [SI].I14RHostIndex  ;Store the Host Index
  MOV  W [BX].BDHostIndex,AX    ;  & Device Address
  MOV  AL,[SI].I14RInterfaceNum ;Store the
  MOV  [BX].BDInterfaceNum,AL   ;  Interface Number
  MOV  AX,NewDeviceError        ;Store the
  MOV  [BX].BDNewDeviceError,AX ;  Error Code
  MOV  AL,NewDeviceStage        ;Store the
  MOV  [BX].BDNewDeviceStage,AL ;  New Device Stage
  JMP >A90                      ;Done
A50:                            ;Entry not Empty
  ADD  BX,BadDeviceStrucSize    ;Point at next entry
  LOOP A20                      ;Keep going until we're done
A90:                            ;Done
  POPF                          ;Restore Flags
  POP  CX,BX,AX                 ;Restore used registers
  RET

;------------------------------------------------------------------------------
;DELETE BAD (INCOMPATIBLE) DEVICE HOSTS & ADDRESSES FROM THE TABLE
;Inputs:  CL = Host Index, CH = Address
;Outputs: Deletes Host & Address from Bad Device Table
;Changes:
;NOTES: This is called as the result a a Device Disconnect, so we need to
;         delete all Interfaces of the Device.  There will probably only
;         be one Entry per Address, but we need to check all of them.
;------------------------------------------------------------------------------
DeleteBadDevices:
  PUSH AX,BX,CX,DX,DI            ;Save used registers
  PUSHF                          ;Save Flags
  MOV  AX,CX                     ;AL = Host Index, AH = Device Address
  MOV  DL,-1                     ;Don't care about the Interface Number
  CLI                            ;Disable Interrupts
D10:                             ;Loop here for each Table Entry
  CALL FindBadDeviceEntry        ;Any entries in the Table (returns BX)?
  JC  >D90                       ;If not, we're done
  PUSH AX                        ;If so, save used registers
  XOR  AX,AX                     ;Write zeroes
  MOV  CX,(BadDeviceStrucSize/2) ;Number of words to write
  MOV  DI,BX                     ;Point DI at Table Entry
  REP  STOSW                     ;Write them
  POP  AX                        ;Restore used registers
  JMP  D10                       ;Keep looking for more Entries
D90:                             ;Done
  POPF                           ;Restore Flags
  POP  DI,DX,CX,BX,AX            ;Restore used registers
  RET

;------------------------------------------------------------------------------
;COMPARE A HOST AND ADDRESS TO SEE IF IT'S IN OUR BAD DEVICE TABLE
;Inputs:  CL = Host, CH = Address, DL = Interface, DH = Alt Interface
;Outputs: CF = Set if it's not in the Bad Device Table
;            = Clear if it is in Table
;Changes:
;NOTES: This ignores the Alt Interface Setting (we don't care about it).
;------------------------------------------------------------------------------
TestBadDevice:
  PUSH AX,BX              ;Save used registers
  MOV  AX,CX              ;AL = Host Index, AH = Device Address
                          ;DL = Interface Number
  CALL FindBadDeviceEntry ;Is it in the Table (returns BX)?
  POP  BX,AX              ;Restore used registers
  RET

;------------------------------------------------------------------------------
;FIND A MATCHING HOST/ADDRESS/INTERFACE ENTRY IN THE BAD DEVICE TABLE
;Inputs:  AL = Host Index to find
;         AH = Device Address to find
;         DL = Interface Number to find
;              if -1, we don't care about the Interface Number
;Outputs: CF = Clear if Entry Found
;              BX = Entry Offset
;            = Set if Entry not found
;              BX = Undefined
;Changes:
;------------------------------------------------------------------------------
FindBadDeviceEntry:
  PUSH CX                       ;Save used registers
  PUSHF                         ;Save flags
  MOV  BX,BadDeviceTable        ;Point at Table
  MOV  CX,MaxBadDevices         ;Number of Entries in Table
  CLI                           ;Disable Interrupts
E20:                            ;Loop here to find empty table entry
  TEST [BX].BDFlags,BDFlagInUse ;Valid Entry?
  JZ  >E50                      ;If not, skip it
  CMP  W [BX].BDHostIndex,AX    ;Do the Host Index & Device Address match?
  JNE >E50                      ;If not, skip it
  CMP  DL,-1                    ;Do we care about the Interface Number?
  JE  >E80                      ;If not, we've found it!
  CMP  [BX].BDInterfaceNum,DL   ;Does the Interface Number match?
  JE  >E80                      ;If so, we've found it!
E50:                            ;Go to next entry
  ADD  BX,BadDeviceStrucSize    ;Point at the next entry
  LOOP E20                      ;Keep looking
E70:                            ;Error
  POPF                          ;Restore Flags
  STC                           ;Set Not Found Flag
  JMP >E90                      ;Done
E80:                            ;OK
  POPF                          ;Restore Flags
  CLC                           ;Set Found Flag
E90:                            ;Done
  POP  CX                       ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO ISSUE INT 14h CALLS TO THE HOST DRIVER
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;ISSUE AN INT 14 CALL TO THE USB HOST
;Inputs:  DS:[DX] = Int 14 Request (filled with appropriate data)
;      OR DS:[DI]
;      OR DS:[SI]
;Outputs: CF = Set if error (host stalled, etc.)
;            = Clear if OK
;Changes: Sends the appropriate info to the USB Host via Int 14 call
;------------------------------------------------------------------------------
DoInt14CallSaveAllSI:       ;Save all changed registers
                            ;  [SI] = Int14 Structure
  PUSH DX                   ;Save used registers
  MOV  DX,SI                ;Point DX at the Data Offset
  CALL DoInt14CallSaveAllDX ;Do it
  POP  DX                   ;Restore used registers
  RET

DoInt14CallAXSI:     ;Save all changed registers except AX,
                     ;  [SI] = Int14 Structure
  PUSH DX            ;Save used registers
  MOV  DX,SI         ;Point DX at the Data Offset
  CALL DoInt14CallAX ;Do it
  POP  DX            ;Restore used registers
  RET

DoInt14CallCXDI:     ;Save all changed registers except CX,
                     ;  [DI] = Int14 Structure
  PUSH DX            ;Save used registers
  MOV  DX,DI         ;Point DX at the Data Offset
  CALL DoInt14CallCX ;Do it
  POP  DX            ;Restore used registers
  RET

DoInt14CallAXCXSI:     ;Save all changed registers except AX & CX
                       ;  [SI] = Int14 Structure
  MOV  DX,SI           ;Point DX at the Data Offset
  CALL DoInt14CallAXCX ;Do it
  RET

DoInt14CallCXDXSI:     ;Save all changed registers except CX & DX
                       ;  [SI] = Int14 Structure
  MOV  DX,SI           ;Point DX at the Data Offset
  CALL DoInt14CallCXDX ;Do it
  RET

DoInt14CallSaveAllDX: ;Save all changed registers
                      ;  [DX] = Int14 Structure
  PUSH AX,BX,CX,DX    ;Save registers that Int14 changes!
  CALL DoInt14Call    ;Do it
  POP  DX,CX,BX,AX    ;Restore used registers
  RET

DoInt14CallAX:
  PUSH BX,CX,DX    ;Save registers that Int14 changes, except AX!!
  CALL DoInt14Call ;Do it
  POP  DX,CX,BX    ;Restore used registers
  RET

DoInt14CallCX:
  PUSH AX,BX,DX    ;Save registers that Int14 changes, except CX!!
  CALL DoInt14Call ;Do it
  POP  DX,BX,AX    ;Restore used registers
  RET

DoInt14CallAXCX:
  PUSH BX,DX       ;Save registers that Int14 changes, except AX & CX!!
  CALL DoInt14Call ;Do it
  POP  DX,BX       ;Restore used registers
  RET

DoInt14CallCXDX:
  PUSH AX,BX       ;Save registers that Int14 changes, except CX & DX!!
  CALL DoInt14Call ;Do it
  POP  BX,AX       ;Restore used registers
  RET

;Int 14 returns various values in AX, BX, CX, & DX
DoInt14Call:
  STI           ;Enable Interrupts
  MOV  AX,5001h ;Set Function
  MOV  BX,'US'  ;Set
  MOV  CX,'B!'  ;  Registers
  STC           ;Preset Error Flag
  INT  14h      ;Do it
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE INT 15h (BIOS Services)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HAVE INTERRUPT 15h (BIOS SERVICES) RUN THIS PROGRAM EVERY TIME IT OCCURS
;Inputs:
;Outputs: Emulates a Game Port with a Joystick Attached to it
;         Depending on Exact Call SubType (value in DX), will return
;           various values in AX, BX, CX and/or DX
;Changes:
;------------------------------------------------------------------------------
Int15Hdr:
  DB TYPE IntHdr DUP (0) ;Header for removable interrupt vector code

Int15:
  PUSH BP                          ;Save used registers
  MOV  BP,SP                       ;Point BP at the Stack
  PUSHF                            ;Save flags
  STI                              ;Enable interrupts
  CLD                              ;Go forward with string functions
  CALL MakeStack                   ;Set up our own stack space
  PUSH DS,ES                       ;Save used registers
  MOV  DS,CS                       ;Point DS
  MOV  ES,CS                       ;  and ES at our data area
  CMP  AH,Int15JoystickCall        ;Is it one of the Joystick functions?
  JNE  Int15Old                    ;If not, it's not for us
  TEST TSRFlags,DisableSts         ;Are we Disabled?
  JNZ  Int15Old                    ;If so, quit
  CALL GotAJoystick                ;Are there any Enabled Joysticks?
  JC   Int15Old                    ;If not, quit
  CMP  DX,-1                       ;Is it the Digital Install Check Function?
  JE  >F40                         ;If so, jump to handle it
  CMP  DX,1                        ;Is it Function 0 (Buttons) or 1 (Axes)?
  JE  >F30                         ;If Function 1, jump to handle it
  JA  >F70                         ;If neither Buttons nor Axes, Error
F20:                               ;Get Buttons
  AND  AL,0Fh                      ;Mask out old values in high nibble of AL
  OR   AL,BtnMask                  ;Mask in buttons to hoigh nibble of AL
  JMP >F80                         ;Done
F30:                               ;Get Axes
  CALL CopyXxValues                ;Get the Axes values (AX, BX, CX, DX)
  JMP >F80                         ;Done
F40:                               ;Digital Joystick Install Check
  INC  DX                          ;Set DX = 0 for the Return
  JMP >F80                         ;Done
F70:                               ;Error
  POP  ES,DS                       ;Restore used registers
  CALL ReturnStack                 ;Restore original Stack Space
  OR   B SS:[BP+6],CarryFlag       ;Set Carry Flag for the return
  MOV  AH,I15ErrFuncNoSupt         ;Set Error Code (Function not Supported)
  JMP >F90                         ;Done
F80:                               ;No Error
  POP  ES,DS                       ;Restore used registers
  CALL ReturnStack                 ;Restore original Stack Space
  AND  B SS:[BP+6],(NOT CarryFlag) ;Clear Carry Flag for the return
;  JMP >F90                         ;Done
F90:                               ;Done
  POPF                             ;Restore flags
  POP  BP                          ;Restore used registers
  IRET

Int15Old:
  POP  ES,DS                       ;Restore used registers
  CALL ReturnStack                 ;Restore original Stack Space
  POPF                             ;Restore flags
  POP  BP                          ;Restore used registers
  JMP  D CS:Int15Hdr.OldVector     ;Let the Old Interrupt Handler do it


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE INT 08h (Timer Tick)
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;HAVE INTERRUPT 08 (TIMER) RUN THIS EVERY TIME IT OCCURS
;Inputs:
;Outputs: Searches for Newly attached Device
;Changes:
;------------------------------------------------------------------------------
Int08Hdr:
  DB TYPE IntHdr DUP (0) ;Header for removable interrupt vector code

Int08:
;  PUSHF                          ;Save flags
  PUSHF                          ;Call the
  CALL D CS:Int08Hdr.OldVector   ;  Old Interrupt Handler
  STI                            ;Enable interrupts
  CLD                            ;Go forward with string functions
  CALL MakeStack                 ;Set up our own Stack Space
  PUSH DI,SI,DS,ES               ;Save used registers
  MOV  DS,CS                     ;Point DS and
  MOV  ES,CS                     ;  ES at our data area
  AND  TSRFlags2,(NOT SameTick)  ;Mark as a new Timer Tick
  MOV  BtnMask,0F0h              ;Assume no valid
  CALL ResetxXValues             ;  joysticks installed
  CALL GotAJoystick              ;Are there any valid joysticks?
  JC  >E10                       ;If not, continue
  CALL GetButtons                ;Calculate Buttons status (BtnMask)
  CALL GetAxes                   ;Calculate Axes values (AXValue, etc.)
E10:                             ;Buttons & Coordinates calculated
  MOV  DI,OFFSET Int08Counter    ;Point DI at Int08Counter
  MOV  SI,OFFSET DontLookCounter ;Point BX at DontLookCounter
  CMP  W [SI],0                  ;Need to Decrement DontLookCounter?
  JE  >E20                       ;If not, continue
  DEC  W [SI]                    ;If so, Decrement it
  JNZ >E90                       ;If not 0 yet, quit
  CMP  B [DI],0                  ;Disabled?
  JE  >E90                       ;If so, quit
  MOV  B [DI],1                  ;If not, look for Device right away
E20:                             ;Done with DontLookCounter
  CMP  B [DI],0                  ;Are we supposed to look yet?
  JE  >E90                       ;If not, just quit
  DEC  B [DI]                    ;Decrement the Delay Counter
  JNZ >E90                       ;If not 0 yet, quit
  MOV  B [DI],182                ;If 0, reset for next time (approx 10 seconds)
  PUSH AX,BX,CX,DX,BP            ;Save used registers
  CALL LookForNewDevice          ;Look for a new Device
  POP  BP,DX,CX,BX,AX            ;Restore used registers
E90:                             ;Done
  POP  ES,DS,SI,DI               ;Restore used registers
  CALL ReturnStack               ;Restore Original Stack Space
  IRET
;  POPF                           ;Restore flags
;  JMP  D CS:Int08Hdr.OldVector   ;Jump to old Interrupt

;------------------------------------------------------------------------------
;TEST AND SEE IF THERE ARE ANY ENABLED JOYSTICKS INSTALLED
;Inputs:  DS = ES = TSR Data Area
;Outputs: CF = Clear if there is at least one Enabled Joystick
;            = Set if no enabled Joysticks
;Changes:
;------------------------------------------------------------------------------
GotAJoystick:
  PUSH BX,CX                    ;Save used registers
  MOV  BX,DeviceInfoTable       ;Point at the Table
  MOV  CX,MaxDevices            ;Number of Table Entries
G10:                            ;Loop to here for each table Entry
  TEST [BX].DIFlags,DIFlagInUse ;Is a Joystick installed here?
  JNZ >G80                      ;If so, we've got one
  ADD  BX,DeviceInfoStrucSize   ;Point at the next Table Entry
  LOOP G10                      ;Keep looking
G70:                            ;No Enabled Joysticks
  STC                           ;Set return flag
  JMP >G90                      ;Done
G80:                            ;At least one Enabled Joystick
  CLC                           ;Set return flag
G90:                            ;Done
  POP  CX,BX                    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE BUTTONS STATUS APPROPRIATE FOR THE INT 15h CALL
;Inputs:  DS = ES = TSR Data Area
;         BtnMask = F0h (No buttons pressed)
;Outputs: BtnMask (High Nibble = Buttons Status, Low Nibble = 0)
;Changes:
;------------------------------------------------------------------------------
GetButtons:
  PUSH AX,CX,DX,DI,SI    ;Save used registers
  MOV  DI,OFFSET BtnMask ;[DI] = BtnMask
;  MOV  B [DI],0F0h       ;Initialize Mask to no buttons pressed
  MOV  DH,TSRFlags       ;DH = TSRFlags
  MOV  SI,A01Xlat        ;[SI] = Button 01 Translation Table entry
  TEST DH,Buttons15      ;Using the 15-button protocol?
  JNZ >B30               ;If so, jump to handle it
B10:                     ;Using 4-button protocol
  MOV  CX,4              ;Need to get 4 buttons
  MOV  DL,(NOT 10h)      ;DL = Mask to use for BtnMask
B15:                     ;Loop to here for each button
  CALL GetControlData    ;Get the button data (uses [SI], rtns AX)
  JZ  >B20               ;If not pressed, continue
  AND  [DI],DL           ;If so, mask it in
B20:                     ;Button masked in, if appropriate
  SHL  DL,1              ;Shift the bit mask over
  ADD  SI,XlatStrucSize  ;Point at the next button
  LOOP B15               ;Keep going until we're done
  JMP >B90               ;Done
B30:                     ;Using 15 button protocol
  MOV  CX,15             ;Need to test 15 buttons
  MOV  DL,10h            ;DL = Button Mask
B35:                     ;Loop to here for each button
  CALL GetControlData    ;Get the button data (uses [SI], rtns AX)
  JZ  >B40               ;If not pressed, continue
  NOT  DL                ;If pressed,
  AND  [DI],DL           ;  set the button mask
  JMP >B90               ;done
B40:                     ;Button masked in, if appropriate
  ADD  DL,10h            ;Update the bit mask
  ADD  SI,XlatStrucSize  ;Point at the next button
  LOOP B35               ;Keep going until we're done
B90:                     ;Done
  POP  SI,DI,DX,CX,AX    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE AXES STATUS FOR THE INT 15h CALL
;Inputs:  DS = ES = TSR Data Area
;         AXValue ... DXValue = 0
;Outputs: AXValue, BXValue, CXValue, DXValue
;Changes:
;------------------------------------------------------------------------------
GetAxes:
  PUSH AX,CX,DX,DI,SI    ;Save used registers
  MOV  DI,OFFSET AXValue ;[DI] = AXValue
  MOV  DH,TSRFlags       ;DH = TSRFlags
  MOV  SI,AXXlat         ;[SI] = Axis AX Translation Table entry
  MOV  CX,4              ;Assume no ThrustMaster
  TEST DH,ThrustMaster   ;ThrustMaster Protocol?
  JZ  >X10               ;If not, continue
  INC  CX                ;If so, we need 5 axes
X10:                     ;CX = Number of Axes to get
  CALL GetControlData    ;Get the Axis data (uses [SI], rtns AX)
  STOSW                  ;Store the coordinate
  ADD  SI,XlatStrucSize  ;Point at the next Axis
  LOOP X10               ;Keep going until we're done
  TEST DH,ThrustMaster   ;ThrustMaster Protocol?
  JZ  >X90               ;If not, we're done
  CALL CookThrust        ;If so, calculate the ThrustMaster coordinates
X90:                     ;Done
  POP  SI,DI,DX,CX,AX    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE DATA FOR A PARTICULAR CONTROL
;Inputs:   DS = ES = TSR Data Area
;         [SI] = Translation Table entry to use
;                  (Contains RELATIVE Joystick Index, Control Index & Type)
;Outputs:  CF = Clear if OK
;               AX = Control Data
;               ZF = Set if AX = 0
;                  = Clear if AX <> 0
;             = Set if error (Invalid Translation table entry)
;               AX = 0
;               ZF = Set
;Changes:
;NOTES: If Control is a "Button Pair" (two buttons acting as an Axis),
;         this returns NormalizeMax/2 if neither or both buttons are pressed,
;         MinCoord if the first (Left/Up) button is pressed, NormalizeMax
;         if the second (Right/Down) button is pressed).
;------------------------------------------------------------------------------
GetControlData:
  PUSH BX,DI,SI,BP              ;Save used registers
  MOV  BL,[SI].XlatJIndex       ;BL = Joystick Index to use
  CMP  BL,-1                    ;Valid Index?
  JE  >C70                      ;If not, error
  CALL DIIndex2OffsetBL         ;If OK, [DI] = Device Info Pointer
  TEST [DI].DIFlags,DIFlagInUse ;Is a Joystick installed here?
  JZ  >C70                      ;If not, error
  MOV  BX,W [SI].XlatCType      ;BL = Control Type, BH = Control Index
  CMP  BL,-1                    ;Valid Control Type?
  JE  >C70                      ;If not, error
  CMP  BH,-1                    ;Valid Control Index?
  JE  >C70                      ;If not, error
  MOV  BP,SI                    ;[BP] = Translation Table entry
  LEA  SI,[DI].DIRawData        ;[SI] = Raw Data
  ADD  DI,OFFSET DIControlsData ;[DI] = Translation Data
  CMP  BL,CTDPad                ;Is it a DPad or a Button?
  JA  >C40                      ;If not, handle a regular Axis
C10:                            ;It's a button or a DPad
  CALL GetDIDataWord            ;Get the "Raw" Data (AX)
  CALL HandleSpecialCtl         ;Convert it as appropriate
  JNC >C80                      ;If it worked, we're done
  JMP >C70                      ;If not, error
C40:                            ;It's a "regular" Axis
  CALL GetDINormalized          ;Get the Normalized Data (AX)
  JNC >C80                      ;If it worked, we're done
C70:                            ;Error
  XOR  AX,AX                    ;AX = 0 (also sets ZF)
  STC                           ;Set CF return flag
  JMP >C90                      ;Done
C80:                            ;OK
  OR   AX,AX                    ;Set ZF return flag
  CLC                           ;Set CF return flag
C90:                            ;Done
  POP  BP,SI,DI,BX              ;Restore used registers
  RET

;------------------------------------------------------------------------------
;HANDLE THE SPECIAL CONTROL PROCESSING NEEDED FOR A DPAD OR BUTTON
;Inputs:   DS  = ES = TSR Data Area
;         [BP] = Translation Table entry we're processing
;         [SI] = Raw Data
;         [DI] = Controls Data
;          BL  = Control Type (CTDPad or CTButton)
;          AX  = "Raw" Data (if DPad = 0-7, If Button = first button)
;Outputs: CF = Clear if OK
;              AX = Appropriate Data
;            = Set if Error
;              AX = 0
;Changes:
;------------------------------------------------------------------------------
HandleSpecialCtl:
  PUSH BX,DX           ;Save used registers
  CMP  BL,CTButton     ;Is it a Button?
  JNE >S40             ;If not, handle a DPAd
  MOV  BH,DS:[BP].XlatCIndex2 ;BH = Second Index
  CMP  BH,-1           ;Is this a Button Pair simulating an Axis?
  JE  >S80             ;If not, it's OK
S10:                   ;Is two buttons simulating an Axis
  MOV  DL,AL           ;If so, DL = first button status
  CALL GetDIDataWord   ;Get the second button Data (AX)
  JC  >S70             ;If error, quit
  MOV  DH,AL           ;If OK, DH = Second Button Status
  MOV  AX,NormalizeMax ;Assume maximized
  OR   DL,DL           ;Left/Up button pressed?
  JNZ >S30             ;If so, jump to handle it
S20:                   ;Left/Up button NOT pressed
  OR   DH,DH           ;Right/Down button pressed?
  JNZ >S80             ;If so, it's maximized
  SHR  AX,1            ;If not, it's centered
  JMP >S80             ;Done
S30:                   ;Left/up button pressed
  SHR  AX,1            ;Assume centered (both buttons pressed)
  OR   DH,DH           ;Is the right/down button also pressed?
  JNZ >S80             ;If so, we're done
  MOV  AX,MinCoord     ;If not, it's Left/Up
  JMP >S80             ;Done
S40:                   ;Is a DPad
  CALL AdjustDPadData  ;Adjust the DPad data into a "normal" format
  MOV  DX,CookDPadX    ;Assume X direction
  CMP  DS:[BP].XlatCIndex2,XlatDPadX ;Is it X direction?
  JE  >S50             ;If so, continue
  MOV  DX,CookDPadY    ;If not, it's Y Direction
S50:                   ;[DX] = Code to Call
  CALL DX              ;Do the conversion
  JMP >S80             ;Done
S70:                   ;Error
  XOR  AX,AX           ;AX = 0 (also sets ZF)
  STC                  ;Set CF return flag
  JMP >S90             ;Done
S80:                   ;OK
  OR   AX,AX           ;Set ZF return flag
  CLC                  ;Set CF return flag
S90:                   ;Done
  POP  DX,BX           ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE NORMALIZED COORDINATE FOR A SPECIFIC CONTROL
;Inputs:  DS = ES  = TSR Data Area
;         [DI] = Controls Table Base Offset
;         [SI] = Raw Data
;         BL   = ControlType (Button, etc)
;         BH   = Index Number (0-based)
;Outputs: CF = Clear if OK
;              AX = "Normalized" Value for the Control
;            = Set if error (invalid Type or Index)
;              AX = 0
;Changes:
;------------------------------------------------------------------------------
GetDINormalized:
  PUSH BX,CX,DX        ;Save used registers
  CALL GetDIDataWord   ;Get the Word (AX)
  JC  >Z70             ;If Error, Quit (AX = 0)
  CALL GetDIMinMax     ;Get the Min (CX) and Max (DX)
  SUB  AX,CX           ;Compensate Value for Minimum
  SUB  DX,CX           ;Compensate Maximum for Minimum
  MOV  BX,DX           ;Move Maximum into BX
  MUL  NormalizeMax    ;Normalize the
  DIV  BX              ;  current Value
  SHR  BX,1            ;Do we need to
  CMP  DX,BX           ;  round it up?
  JB  >Z30             ;If not, continue
  INC  AX              ;If so, round it up
Z30:                   ;Value is rounded up
  CMP  AX,MinCoord     ;Is it too small?
  JAE >Z40             ;If not, continue
  MOV  AX,MinCoord     ;If so, make it the minimum
  JMP >Z80             ;Done
Z40:                   ;Test for too big (shouldn't be, but we'll test anyway)
  CMP  AX,NormalizeMax ;Is it more than it should be?
  JBE >Z80             ;If not, it's OK
  MOV  AX,NormalizeMax ;If so, just Maximize it
  JMP >Z80             ;Done
Z70:                   ;Error
  STC                  ;Set Error Flag
  JMP >Z90             ;Done
Z80:                   ;OK
  CLC                  ;Set OK flag
Z90:                   ;Done
  POP  DX,CX,BX        ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET A SPECIFIC WORD VALUE FROM A CONTROL
;Inputs:   ES  = TSR Data Area
;         [DI] = Controls Table Base Offset
;         [SI] = Raw Data
;          BL  = ControlType (Button, etc)
;          BH  = Index Number (0-based)
;Outputs: CF = Clear if OK
;              AX = Appropriate Data Word
;            = Set if error (invalid Type or Index)
;              AX = 0
;Changes
;NOTES: This will find any Index matching the Control Type given, even if the
;         Controls are not contiguous (if there are other types of Controls
;         separating the Controls we are looking for)
;------------------------------------------------------------------------------
GetDIDataWord:
  PUSH BX,CX,DX,DI,SI,DS      ;Save used registers
  MOV  DS,ES                  ;Point DS at TSR Data
  MOV  DL,MaxControls         ;Table Size Counter
W10:                          ;Loop to here to find the correct entry
  CMP  BL,[DI].ControlType    ;Is it the correct Type?
  JNE >W50                    ;If not, try the next one
  MOV  CH,[DI].ControlQty     ;Get Quantity of Controls Here
  MOV  CL,[DI].ControlOffset  ;Get Offset of First Control
W15:                          ;Loop here to find correct Index
  SUB  BH,1                   ;Decrement the Control Index
  JC  >W30                    ;If it's the Index we're looking for, we're done
  DEC  CH                     ;Decrement our local Counter
  JZ  >W50                    ;If no more here, look for another Control Set
  ADD  CL,[DI].ControlNumBits ;Update the Offset
  JMP  W15                    ;Keep looking in this Control Set
W30:                          ;Pointed at correct Entry
  CMP  CL,8                   ;Is the Offset more than a Byte?
  JB  >W40                    ;If not, we're close!
  INC  SI                     ;If so, go to
  SUB  CL,8                   ;  the next byte
  JMP  W30                    ;Keep skipping, if we need to
W40:                          ;Pointed at Correct Byte Offset
  MOV  BX,[SI+2]              ;Copy High Word into BX
  MOV  AX,[SI]                ;Copy Low Word into AX
  OR   CL,CL                  ;Do we need to Shift at all?
  JZ  >W47                    ;If not, we're done with this part
W43:                          ;Loop to here to shift bits to low part of AX
  SHR  AX,1                   ;Move the low bits over
  SHR  BX,1                   ;Move the high bits over
  JNC >W45                    ;If low bit was not set, continue
  OR   AH,80h                 ;If it was set, set the high bit of AX
W45:                          ;Done shifting this bit
  DEC  CL                     ;Decrement our Loop Counter
  JNZ  W43                    ;If not 0 yet, keep shifting
W47:                          ;Done putting bits into low part of AX
  MOV  CL,16                  ;Calculate
  SUB  CL,[DI].ControlNumBits ;  Shift Factor
  SHL  AX,CL                  ;Get rid of
  SHR  AX,CL                  ;  unwanted bits
  JMP >W80                    ;Done
W50:                          ;Go to the next one
  ADD  DI,ControlStrucSize    ;Point at next entry
  DEC  DL                     ;End of Table?
  JNZ  W10                    ;If not, keep looking
W70:                          ;Error
  XOR  AX,AX                  ;Set
  STC                         ;  Error Codes
  JMP >W90                    ;Done
W80:                          ;OK
  CLC                         ;Clear Carry Flag for the return
W90:                          ;Done
  POP  DS,SI,DI,DX,CX,BX      ;Restore used registers
  RET

;------------------------------------------------------------------------------
;GET THE MIN/MAX VALUES FOR A SPECIFIC CONTROL
;Inputs:   ES  = TSR Data Area
;          BL  = ControlType (Button, etc)
;          BH  = Index Number (0-based)
;         [DI] = Controls Table Base Offset
;         [SI] = Raw Data
;Outputs: CX = Min Value for Coordinate
;         DX = Max Value for Coordinate
;Changes:
;NOTES: This assumes that the Control actually exists (it was tested some
;         other way).
;------------------------------------------------------------------------------
GetDIMinMax:
  PUSH AX,BX,DI,DS         ;Save used registers
  MOV  DS,ES               ;Point DS at TSR Data
  MOV  AL,MaxControls      ;Table Size Counter
X10:                       ;Loop to here for each Table Entry
  CMP  BL,[DI].ControlType ;Is it the correct Type?
  JNE >X50                 ;If not, try the next one
  MOV  AH,[DI].ControlQty  ;Get Quantity of Controls Here
X20:                       ;Loop here to find correct Index
  SUB  BH,1                ;Decrement the Control Index
  JC  >X90                 ;If it's the Inded we're looking for, we're done
  DEC  AH                  ;Decrement our local Counter
  JNZ  X20                 ;If nto zero yet, keep looking
X50:                       ;Go to the next one
  ADD  DI,ControlStrucSize ;Point at next entry
  DEC  AL                  ;End of Table?
  JNZ  X10                 ;If not, keep looking
X90:                       ;Done ([DI] Points at Correct Control)
  MOV  CX,[DI].ControlMin  ;Put Min in CX
  MOV  DX,[DI].ControlMax  ;Put Min in DX
  POP  DS,DI,BX,AX         ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CONVERT "STANTARD" COORDINATES INTO THRUSTMASTER PROTOCOL
;Inputs:  DS = ES = TSR Data Area
;         CXValue, DXValue, GXValue
;         MovePercent, NormalizeMax
;Outputs: CXValue, DXValue
;Changes:
;------------------------------------------------------------------------------
CookThrust:
  PUSH AX,BX,CX,DX       ;Save used registers
  PUSH DI,SI             ;Save used registers
  MOV  AX,NormalizeMax   ;Get the
  SHR  AX,1              ;  Center
  MOV  DI,AX             ;  Value
  MOV  SI,MovePercent    ;Multiply
  MUL  SI                ;  by
  MOV  SI,100            ;  Movement
  DIV  SI                ;  Percent
  MOV  SI,DI             ;SI =
  ADD  SI,AX             ;  Maximum value
  SUB  DI,AX             ;DI = Minimum value
  MOV  CX,CXValue        ;CX = X Direction
  MOV  DX,DXValue        ;DX = Y Direction
T10:                     ;Have values calculated
  XOR  BL,BL             ;Default = Centered (Valid, not Left/Right/Up/Down)
  OR   CX,CX             ;Valid X?
  JNZ >T11               ;If so, continue
  OR   BL,XInvalid       ;If not, mark it as invalid
T11:                     ;X validity handled
  OR   DX,DX             ;Valid Y?
  JNZ >T12               ;If so, continue
  OR   BL,YInvalid       ;If not, mark it as invalid
T12:                     ;Y validity handled
  OR   CX,CX             ;Invalid?
  JZ  >T14               ;If so, it can't be Left or Right
  CMP  CX,DI             ;X Left?
  JA  >T13               ;If not, continue
  OR   BL,XLeft          ;If so, mark it as Left
T13:                     ;X Left handled
  CMP  CX,SI             ;X Right?
  JB  >T14               ;If not, continue
  OR   BL,XRight         ;If so, mark it as Right
T14:                     ;X handled
  OR   DX,DX             ;Invalid?
  JZ  >T20               ;If so, it can't be Up or Down
  CMP  DX,DI             ;Y Up?
  JA  >T15               ;If not, continue
  OR   BL,YUp            ;If so, mark it as Up
T15:                     ;Y Up handled
  CMP  DX,SI             ;Y Down?
  JB  >T20               ;If not, continue
  OR   BL,YDown          ;If so, mark it as Down
T20:                     ;All bit-masks set
  XOR  AX,AX             ;Assume invalid
  CMP  BL,(XInvalid+YInvalid) ;Both coordinates invalid?
  JE  >T90               ;If so, we're done
T22:                     ;At least 1 coordinate is valid
  MOV  AX,NormalizeMax   ;Assume centered
  OR   BL,BL             ;Everything centered?
  JZ  >T90               ;If so, we're done
  CMP  BL,XInvalid       ;X Invalid & Y Centered?
  JE  >T90               ;If so, we're done
  CMP  BL,YInvalid       ;Y Invalid & X Centered?
  JE  >T90               ;If so, we're done
T30:                     ;Not Invalid or Centered
  TEST BL,(YUp+YDown)    ;Y Uncentered?
  JNZ >T40               ;If so, handle it
T32:                     ;Y Zero or Centered
  TEST BL,XLeft          ;Is it Left?
  JZ  >T36               ;If not, it's Right
T34:                     ;Left
  SHR  AX,1              ;Set
  MOV  BX,AX             ;  Left
  SHR  AX,1              ;  Return
  ADD  AX,BX             ;  Value
  JMP >T90               ;Done
T36:                     ;Right
  SHR  AX,1              ;Set
  SHR  AX,1              ;  Return Value
  JMP >T90               ;Done
T40:                     ;Y Uncentered
  TEST BL,(XLeft+XRight) ;X Uncentered?
  JNZ >T90               ;If so, we're done
T42:                     ;Y Uncentered, X Zero or Centered
  TEST BL,YUp            ;Is it Up?
  JZ  >T46               ;If not, it's Down
T44:                     ;Up
  MOV  AX,MinCoord       ;Set Up Value
  JMP >T90               ;Done
T46:                     ;Down
  SHR  AX,1              ;Set Down Value
T90:                     ;Done (AX = THrustMaster coordinate to store)
  MOV  DXValue,AX        ;Store the ThrustMaster value
  MOV  AX,GXValue        ;Store the
  MOV  CXValue,AX        ;  Gas Pedal value
  POP  SI,DI             ;Restore used registers
  POP  DX,CX,BX,AX       ;Restore used registers
  RET

;------------------------------------------------------------------------------
;ADJUST DPAD DATA INTO A "NORMAL" FORMAT
;Inputs:  DS = ES = TSR Data Area
;          AX  = Raw DPad Coordinate from Joystick
;          BL  = ControlType (DPad)
;          BH  = Index Number (0-based)
;         [DI] = Controls Table Base Offset
;         [SI] = Raw Data
;Outputs: AX = Value converted to a "normalized" format
;                0 = Center, 1 = Up, 2 = Up & Right, ..., 8 = Up & Left
;Changes:
;NOTE: This will adjust for either a 4-way or 8-way Hat Switch
;------------------------------------------------------------------------------
AdjustDPadData:
  PUSH CX,DX       ;Save used registers
  OR   AH,AH       ;Is it more than 255?
  JNZ >D70         ;If so, mark it as Centered
  CALL GetDIMinMax ;Get the Minimum (CX) and Maximum (DX), uses BX
  CMP  AL,DL       ;Is the current value more than the Maximum?
  JA  >D70         ;If so, mark it as Centered
  CMP  CL,1        ;Is the Minimum 0 or 1?
  JA  >D70         ;If neither, Error
  JE  >D40         ;If 1, jump to handle it
D10:               ;Minimum is 0
  CMP  DL,3        ;Is it 4-way?
  JNE >D30         ;If not, jump to handle it
D20:               ;Minimum 0, 4-way
  SHL  AX,1        ;Multiply by 2
  INC  AX          ;Add 1
  JMP >D90         ;Done
D30:               ;Minimum 0, not 4-way
  CMP  DL,7        ;Is it 8-way?
  JNE >D70         ;If not, Error
D35:               ;Minimum 0, 8-way
  INC  AX          ;Add 1
  JMP >D90         ;Done
D40:               ;Minimum is 1
  OR   AX,AX       ;Is it 0 (Centered)?
  JZ  >D90         ;If so, it's OK like it is
  CMP  DL,4        ;Is it 4-way?
  JNE >D60         ;If not, jump to handle it
D50:               ;Minimum 1, 4-Way
  DEC  AX          ;Subtract 1
  SHL  AX,1        ;Multiply by 2
  INC  AX          ;Add 1
  JMP >D90         ;Done
D60:               ;Minimum 1, not 4-way
  CMP  DL,8        ;Is it 8-way?
  JE  >D90         ;If so, it's OK like it is
D70:               ;Return 0 (Centered)
  XOR  AX,AX       ;Just return 0
D90:               ;Done
  POP  DX,CX       ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CONVERT (COOK) A D-PAD COORDINATE INTO A JOYSTICK COORDINATE
;Inputs:  DS = ES  = TSR Data Area
;         AX = Raw DPad Coordinate (8-Way) from Joystick
;         NormalizeMax
;Outputs: AX = Value converted to "Cooked" Coordinate
;Changes:
;------------------------------------------------------------------------------
CookDPadX:
  PUSH DX              ;Save used registers
  XOR  DL,DL           ;Mark as getting X Axis
  JMP >P00             ;Do it
CookDPadY:
  PUSH DX              ;Save used registers
  MOV  DL,1            ;Mark as getting Y Axis
;  JMP >P00             ;Do it
P00:
  OR   AL,AL           ;Is it Centered?
  JZ  >P40             ;If so, it's Centered
  OR   DL,DL           ;Getting X or Y?
  JNZ >P30             ;If Y, jump to handle it
P10:                   ;Getting X
  CMP  AL,1            ;Is it just Up?
  JE  >P40             ;If so, it's Centered
  CMP  AL,5            ;Is it just Down?
  JE  >P40             ;If so, it's Centered
  CMP  AL,4            ;Is it Right?
  JBE >P50             ;If so, it's Right
  JMP >P60             ;If not, it's Left
P30:                   ;Getting Y
  CMP  AL,3            ;Is it just Right?
  JE  >P40             ;If so, it's Centered
  CMP  AL,7            ;Is it just Left?
  JE  >P40             ;If so, it's Centered
  CMP  AL,2            ;Is it Up?
  JBE >P60             ;If so, it's Up
  CMP  AL,8            ;Is it Up?
  JE  >P60             ;If so, it's Up
  JMP >P50             ;If not, it's Down
P40:                   ;Centered
  MOV  AX,NormalizeMax ;Set
  SHR  AX,1            ;  Centered
  JMP >P90             ;Done
P50:                   ;Right/Down
  MOV  AX,NormalizeMax ;Set Right/Down
  JMP >P90             ;Done
P60:                   ;Left/Up
  MOV  AX,MinCoord     ;Set Left/Up
P90:                   ;Done
  POP  DX              ;Restore used registers
  RET

;------------------------------------------------------------------------------
;RESET THE AXValue -> GXValue VARIABLES
;Inputs:  DS = ES  = TSR Data Area
;Outputs:
;Changes:
;------------------------------------------------------------------------------
ResetXxValues:
  PUSH AX,CX,DI          ;Save used registers
  MOV  DI,OFFSET AXValue ;Point at beginning of Table
  XOR  AX,AX             ;Fill with Zeroes
  MOV  CX,5              ;Number of entries to changes
  REP  STOSW             ;Fill teh Table
  POP  DI,CX,AX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;COPY AXValue -> DXValue to REGISTERS AX -> DX
;Inputs:  DS = ES  = TSR Data Area
;Outputs:
;Changes:
;------------------------------------------------------------------------------
CopyXxValues:
  PUSH DI        ;Save used registers
  MOV  DI,OFFSET AXValue ;[DI] = First Coordinate Value
  MOV  AX,[DI+0] ;Copy
  MOV  BX,[DI+2] ;  return
  MOV  CX,[DI+4] ;  register
  MOV  DX,[DI+6] ;  values
  POP  DI        ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;CODE TO HANDLE I/O VIRTUALIZATION
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;ISSUE A VIRTUALIZE I/O REQUEST TO THE MEMORY MANAGER
;Inputs:  CS = DS = TSR Data Area
;         VirtIOHandle (-1 if not Virtualized yet)
;Outputs: ZF = Clear if OK (I/O is Virtualized)
;                VirtIOHandle is stored
;            = Set if error
;                VirtIOHandle = unchanged (-1)
;Changes:
;NOTES: This must be called with CS = DS, and DS must be our TSR Data Area
;         (the segment that will be used when the I/O Virtualization Code
;         is called).  Therefore, this code is in the TSR portion of our
;         program.  Normally, something like this would be in the
;         initialization code instead of the TSR, but there are special
;         circumstances here.
;------------------------------------------------------------------------------
InstallVIO:
  PUSH AX,BX,CX         ;Save used registers
  PUSH EDX,DI,SI        ;Save used registers
  CMP  VirtIOHandle,-1  ;Already virtualized?
  JNE >V90              ;If so, we're done
  MOV  AX,VirtIOFuncAX  ;Function 4A15h (Manipulate Virtual I/O Handler)
  MOV  BX,VirtIOBXInst  ;BX = Function  = Install
  MOV  CX,VirtIOTblSize ;CX = Number if Ports to Trap (# Entries in Table)
  MOV  SI,VirtIOTable   ;DS:[SI] = I/O Dispatch Table
  MOV  DX,[SI]          ;EDX =
  SHL  EDX,16           ;  Port Number
  MOV  DX,[SI]          ;  Range
  MOV  DI,LastTSRByte   ;DI = Number of Bytes needed in Segments
  STC                   ;Preset Error Flag
  INT  2Fh              ;Do it (returns CF)
  JC  >V90              ;If error, quit
  MOV  VirtIOHandle,AX  ;If OK, store the Handle Number
V90:                    ;Done
  CMP  VirtIOHandle,-1  ;Set return flag
  POP  SI,DI,EDX        ;Restore used registers
  POP  CX,BX,AX         ;Restore used registers
  RET

;------------------------------------------------------------------------------
;UNINSTALL THE I/O VIRTUALIZATION
;Inputs:  CS = DS = TSR Data Area
;         VirtIOHandle
;Outputs: CF = Clear if OK (I/O virtualization is uninstalled)
;            = Set if error
;Changes:
;NOTES: This code does not actually need to be called from the TSR, unlike
;         the initialization code directly above.  We are putting it here
;         simply for convenience, and because it's small.  If it was a large,
;         complicated piece of code, we wouldn't put it in the TSR section
;         even for the sake of convenience.
;------------------------------------------------------------------------------
UninstallVIO:
  PUSH AX,BX,SI          ;Save used registers
  MOV  SI,VirtIOHandle   ;SI = Handle
  CMP  SI,-1             ;Did virtualization work?
  JNE >U20               ;If so, continue
  CLC                    ;If not, set Uninstalled return code
  JMP >U90               ;Done
U20:                     ;We are virtualized
  MOV  AX,VirtIOFuncAX   ;Function 4A15h (Manipulate Virtual I/O Handler)
  MOV  BX,VirtIOBXUninst ;BX = Function = Uninstall
                         ;SI = Handle
  STC                    ;Preset Error Flag
  INT  2Fh               ;Do it (returns CF)
  JC  >U90               ;If it didn't work, we're done
  MOV  VirtIOHandle,-1   ;If it did, mark Handle as unused
U90:                     ;Done (CF set as needed)
  POP  SI,BX,AX          ;Restore used registers
  RET

;------------------------------------------------------------------------------
;PERFORM THE PM CALL FOR I/O PORT 201h ACCESS
;Inputs:  CS = PM CS Selector
;         DS = PM DS Selector (Alias for CS)
;         AL/AX/EAX = Input Value (if OUT DX,Ax)
;         CL = Direction
;              Bit 2 (04h) Clear if IN Ax,DX
;                          Set if OUT DX,Ax
;         DX = Port Number Accessed
;Outputs: CF = Clear if I/O has been virtualized
;                AL = Value to return if call was IN Ax,DX
;                     EMM386 does CBW to AL if call was IN AX,DX
;                     EMM386 hangs on IN EAX,DX
;              Set if I/O is not virtualized
;                PM Virtualization hander gets data from actual I/O Port
;Changes:
;NOTE: This procedure is called from 16-bit protected mode, NOT from
;        V86 or real mode.  For the most part, that doesn't really matter,
;        except for one thing -- the segment registers.  The segment
;        registers are actually indexes to entries in a not-easy-to-access
;        table, NOT segment addresses as is usually the case.  The practical
;        implication of that is that we cannot issue any FAR procedure calls
;        (including INT requests?).  We can freely access code and data
;        within our own segment (the TSR), but can't access any memory outside
;        our segment.
;      This must end in a RETF, not a RET!
;------------------------------------------------------------------------------
PMCode201:
  TEST TSRFlags,DisableSts ;Are we Disabled?
  JNZ >W70                 ;If so, quit
  CALL GotAJoystick        ;Are there any Enabled Joysticks?
  JC  >W70                 ;If not, quit
W10:                       ;Need to process things
  TEST CL,PMCallCXOut      ;Is it an OUT DX,AL?
  JNZ >W50                 ;If so, handle it
W20:                       ;Is IN AL,DX
  PUSH BP,ES               ;Save used registers
  MOV  ES,DS               ;ES = TSR Data Area
  CALL CalcElapsedTimeBP   ;Calculate elapsed Time since OUT instruction (BP)
  MOV  AL,BtnMask          ;High Nibble of AL = Button Status
  CALL CalcAxesBits        ;Calculate Axis Data (AL Low Nibble)
  POP  ES,BP               ;Restore used registers
  JMP >W80                 ;Done
W50:                       ;Is OUT DX,AL
  PUSH AX                  ;Save used registers
  CALL GetTimer            ;Get the current Timer value
  MOV  StartTimer,AX       ;Store it
  OR   TSRFlags2,SameTick  ;Mark the Timer Tick Flag
  POP  AX                  ;Restore used registers
  JMP >W80                 ;Done
W70:                       ;Not virtualized
  STC                      ;Set return flag
  JMP >W90                 ;Done
W80:                       ;Virtualized
  CLC                      ;Set return flag
W90:                       ;Done
  RETF

;------------------------------------------------------------------------------
;CALCULATE THE ELAPSED TIME SINCE THE ORIGINAL OUT DX,AL
;Inputs:  DS = ES = TSR Data Selector
;         StartTimer
;         TSRFlags2.SameTick
;Outputs: ZF = Set if error (Elapsed Time unknown)
;                BP = 1-
;            = Clear if OK
;                BP = Elapsed Time
;Changes:
;------------------------------------------------------------------------------
CalcElapsedTimeBP:
  PUSH AX                 ;Save used registers
  MOV  BP,-1              ;Assume Unknown Time
  TEST TSRFlags2,SameTick ;Has the Timer Tick "rolled"?
  JZ  >P90                ;If so, we're done
  MOV  BP,StartTimer      ;BP = Starting Timer
  CALL GetTimer           ;AX = Current Timer
  SUB  BP,AX              ;BP = Elapsed Time
P90:                      ;Done
  CMP  BP,-1              ;Set return flag
  POP  AX                 ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE THE APPROPRIATE BIT MASK FOR THE VIRTUALIZED IN AL,DX FUNCTION
;Inputs:  DS = ES = TSR Data Selector
;         BP = Elapsed Time since OUT DX,AL was issued
;         CLD already issued
;Outputs: AL (Low Nibble)  = Appropriate Bit Mask
;         AL (High Nibble) = Unchanged
;Changes:
;------------------------------------------------------------------------------
CalcAxesBits:
  PUSH BX,CX,DX,DI,SI    ;Save used registers
  MOV  BX,AX             ;Save original AX
  AND  BL,0F0h           ;Mask out low nibble of BL
  MOV  SI,OFFSET AXValue ;[SI] = First coordinate to get
  MOV  CX,4              ;CX = Number of coordinates to get
  MOV  DL,1              ;DL = Bit mask to use
X10:                     ;Loop to here for each Axis
  LODSW                  ;Get the next Axis word
  CALL CalcAxisBit       ;Mask in the coordinaet bit as appropriate
  LOOP X10               ;Keep going until we're done
  MOV  AX,BX             ;Put return value in AX
  POP  SI,DI,DX,CX,BX    ;Restore used registers
  RET

;------------------------------------------------------------------------------
;CALCULATE AND SET AN APPROPRIATE BIT FOR AN AXIS CONTROL
;Inputs:  DS = ES = TSR Data Selector
;         BP = Elapsed Time since OUT DX,AL was issued (-1 if expired)
;         AX = Coordinate, as appropriate for BIOS (INT 15h) call
;         DL = Bit Mask to use
;         BL = Current Bit mask (in low nibble)
;              Bit we're working with preset to 0 (we set it to 1 if approp)
;Outputs: BL = Bit masked in if appropriate
;         DL = DL SHL 1
;         AX = AX SHL 4
;Changes: AX
;------------------------------------------------------------------------------
CalcAxisBit:
  SHL  AX,4  ;Multiply by 16 (appropriate for direct I/O calls)
  JZ  >B80   ;If invalid coordinate, bit is always 1
  CMP  BP,-1 ;Expired Timer after last OUT?
  JE  >B90   ;If so, bit is 0
  CMP  BP,AX ;Are we still within the timeout parameters?
  JAE >B90   ;If not, the bit is 0
B80:         ;Need to set the bit
  OR   BL,DL ;Mask in the bit
B90:         ;Done
  SHL  DL,1  ;Shift the bit mask over for next time
  RET

;------------------------------------------------------------------------------
;GET CURRENT TIMER COUNTER FROM PORT 40h (THE CLOCK INTERRUPT)
;Inputs:
;Outputs: AX = Current timer counter word
;Changes:
;------------------------------------------------------------------------------
GetTimer:
  PUSHF       ;Save flags
  CLI         ;Disable interrupts
  MOV  AL,06h ;Bits 7:6 =  00 = Timer 0
              ;Bits 5:4 =  00 = Latch Counter
              ;Bits 3:1 = 011 = Mode 3 (Square Wave)
              ;Bit    0 =   0 = Binary Counter (16 bits)
  OUT  43h,AL ;Tell the PIT what we're going to do
  IN   AL,40h ;Get LSB of timer counter
  MOV  AH,AL  ;Save it
  IN   AL,40h ;Get MSB of timer counter
  XCHG AH,AL  ;Put things in the right order
  POPF        ;Restore flags
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;MISCELLANEOUS SUPPORT FUNCTIONS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;SEARCH A BYTE-TO-WORD LOOKUP TABLE FOR A MATCH
;Inputs:  ES:[BX] = Table to search
;         AL      = Byte to search for
;Outputs: CF = Clear if a byte match as found in table
;              BX = Word from Table
;            = Set if no match found in table
;              BX = unchanged
;Changes: Last Entry in Table (end-of-table marker) = DB -1, DW -1
;------------------------------------------------------------------------------
SearchByteToWordTbl:
  PUSH AX,SI,DS  ;Save used registers
  CLD            ;Go forward with string functions
  MOV  DS,ES     ;Point DS at correct data area
  MOV  SI,BX     ;Put pointer in SI
  MOV  AH,AL     ;Put byte to check in AH
B10:             ;Loop to here for each table entry
  LODSB          ;Get the next table entry
  CMP  AL,-1     ;Is it possibly the end of the table?
  JNE >B20       ;If not, continue
  CMP  W [SI],-1 ;Is it actually the end of the table?
  JE  >B70       ;If so, there's no match
B20:             ;Not end of table
  CMP  AL,AH     ;Is it a match?
  JE  >B80       ;If so, handle it!
  INC  SI,2      ;If not, skip over this table entry
  JMP  B10       ;And keep looking
B70:             ;No entry found
  STC            ;Set the not found flag
  JMP >B90       ;Quit
B80:             ;Entry found [SI]
  MOV  BX,[SI]   ;Point BX at the table entry
  CLC            ;Set the found flag
B90:             ;Done
  POP  DS,SI,AX  ;Restore used registers
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;STACK-RELATED FUNCTIONS
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

;------------------------------------------------------------------------------
;CREATE/DELETE OUR OWN STACK
;Inputs:  CS = TSR Data Area
;         StackInUse
;Outputs: Interrupts Enabled
;Changes: SS,SP to/from our stack
;------------------------------------------------------------------------------
MakeStack:
  CLI                   ;Disable interrupts
  PUSHF                 ;Save
  POP  CS:TempFlags     ;  Flags
  INC  CS:StackInUse    ;Increment number-of-calls counter
  CMP  CS:StackInUse,1  ;Is this the first call?
  JNE >M90              ;If not, the stack is already in use
  MOV  CS:TempBX,BX     ;  BX in memory
  POP  BX               ;Save MakeStack's return address in BX
  MOV  CS:OldSS,SS      ;Save original SS
  MOV  CS:OldSP,SP      ;Save original SP
  MOV  SP,CS            ;Put our CS
  MOV  SS,SP            ;  into SS
  MOV  SP,LastTSRByte-2 ;SP = Top of Stack
  PUSH BX               ;Restore MakeStack's return address to stack
  MOV  BX,CS:TempBX     ;Restore BX from memory
M90:                    ;Done
  PUSH CS:TempFlags     ;Restore
  POPF                  ;  Flags
  STI                   ;Enable interrupts
  RET

ReturnStack:
  CLI                ;Disable interrupts
  PUSHF              ;Save
  POP  CS:TempFlags  ;  Flags
  DEC  CS:StackInUse ;Decrement number-of-calls counter
  JNZ >R90           ;If sack is still in use, quit
  MOV  CS:TempBX,BX  ;Save BX in memory
  POP  BX            ;Save MakeStack's return address in BX
  MOV  SS,CS:OldSS   ;Restore original SS
  MOV  SP,CS:OldSP   ;Restore original SP
  PUSH BX            ;Restore MakeStack's return address to stack
  MOV  BX,CS:TempBX  ;Restore BX from memory
R90:                 ;Done
  PUSH CS:TempFlags  ;Restore
  POPF               ;  Flags
  STI                ;Enable interrupts
  RET


;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
;SPACE FOR OUR TSR STACK
;±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±

  EVEN 16
  DB (StackSize/8) DUP ('TSRStack')


LastTSRByte:


;ÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛ
;ÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛÛ


;ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
;DATA NEEDED TO INSTALL/UPDATE/SHOW STATUS (NOT NEEDED DIRECTLY IN TSR)
;ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ

;==============================================================================
;TSR Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Table of Interrupt Numbers that the TSR Intercepts
  ;First byte of each entry is the Interrupt Number
  ;Second word is the Pointer to our Interrupt Handler Code Header
  ;----------------------------------------------------------------------------
  IntNumTable:
    DB 2Fh       ;TSR Multiplex
     DW Int2FHdr
    DB 15h       ;BIOS Services
     DW Int15Hdr
    DB 08h       ;Timer Tick
     DW Int08Hdr
    DB 0         ;End of Table

  ;----------------------------------------------------------------------------
  ;Data needed to install as a TSR, Hooking into the Multiplex Int
  ;----------------------------------------------------------------------------
  FirstHandle DB 0 ;First available user handle for Int 2Fh


;==============================================================================
;Miscellaneous
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Miscellaneous Yes/No flags (individual bits)
  ;----------------------------------------------------------------------------
  ProgFlags        DB 00h ;General Program Yes/No Flags #1
    Help          EQU 01h ;User wants help?
    Uninstall     EQU 02h ;Uninstall resident program?
    InMemory      EQU 04h ;Already installed in memory?
    UseLowMemory  EQU 08h ;User does not want us in High Memory
    MemoryMoved   EQU 10h ;TSR Memory has been moved by our Auto-Code
    FoundSuptFile EQU 20h ;Found Support File in the Path

  ProgFlags2   DB 00h ;General Program Yes/No Flags #2
    DoEnvir   EQU 01h ;Parsing/Testing Environment variable
    DoStdIn   EQU 02h ;Parsing/Testing StdIn buffer
    Write2Err EQU 04h ;Write to ERR instead of Pause/CON

  StatusFlags    DB 00h ;General Program Yes/No Flags #3
    Report      EQU 01h ;Show HID Report Data
    Status      EQU 02h ;Show Status
    Descriptors EQU 04h ;Show Device/Config Descriptors Data
    BadDevices  EQU 08h ;Print Bad Device Table
    Alias       EQU 10h ;Write the Alias List to the Screen
    ErrLvl      EQU 20h ;Show ErrorLevel Table

  ;----------------------------------------------------------------------------
  ;Miscellaneous Strings we need to write to the screen
  ;----------------------------------------------------------------------------
  HexString: DB '0000',0
  CrLfMsg:   DB CR,LF,0
  SingleMsg: DB ' '
  NoMsg:     DB 0
  Space3Msg: DB ' '
  Space2Msg: DB ' '
  SpaceMsg:  DB ' ',0


;==============================================================================
;Pause Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings and Data needed to Pause the screen
  ;----------------------------------------------------------------------------
  PauseMsg:
    DB CR,LF
    DB ' MORE   (Esc stops Pausing, Ctrl-C stops Completely, any other Continues)',CR,0
  PauseNMsg:
    DB ' MORE                                                                    ',CR,LF,0
  PauseDMsg:
    DB '                                                                               ',CR,0
  PauseRows       DW ? ;Number of rows per screen
  PauseHeaderPtr  DW 1 ;Pointer to Header Message (start with a fake one <> 0)
  PauseHeaderSize DW 2 ;Number of lines in the Header Message
  PauseRowCount   DW 2 ;Current Row Counter


;==============================================================================
;DOS Environment Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Variables to search for our Environment Variable
  ;----------------------------------------------------------------------------
  EnvVarString:  DB 'USBJSTIK='    ;Environment Variable String
  EnvVarSize    EQU $-EnvVarString ;Length of String
  EnvVarPointer  DW -1             ;Pointer to Program Environment Variable

  ;----------------------------------------------------------------------------
  ;Variables to search for an extended Command Line String
  ;This should only be valid/needed if the Command Line Size (PSP:[80h]) is 7Eh
  ;----------------------------------------------------------------------------
  CmdLineVarString:  DB 'CMDLINE='         ;Environment Variable String
  CmdLineVarSize    EQU $-CmdLineVarString ;Length of String
  CmdLineVarPointer  DW -1                 ;Pointer to Program Environment Variable


;==============================================================================
;EXEC Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Size of our program stack (in bytes)
  ;----------------------------------------------------------------------------
  ProgStackSize EQU 512

  ;----------------------------------------------------------------------------
  ;Variables to Locate and Run another Program (EXEC Child Program)
  ;----------------------------------------------------------------------------
  PathToUse:       DB MaxPathSize DUP (0) ;Path to Use
  OurPathPointer   DW -1                  ;Pointer to our Path String
  CurrentPath:     DB  0                  ;Current Path (Zero-Length ASCIIZ)
  SupportFile:     DB 'USBSUPT1.COM',0    ;Support File Name to Look for

  PathVarString1:  DB 'PATH='             ;PATH Environment String Header (DOS)
  PathVarString2:  DB 'Path='             ;PATH Environment String Header (NT?)
  PathVarSize     EQU $-PathVarString2    ;Length of String
  PathVarPointer   DW -1                  ;Pointer to PATH Environment Variable

  ;----------------------------------------------------------------------------
  ;Variables needed to do EXEC Call
  ;----------------------------------------------------------------------------
  CmdTailSize DB CmdTailMax-2           ;Length of command tail (Maximize it)
  CmdTail:    DB CmdTailMax DUP (CR)    ;Command Tail for EXEC Call
  ParamBlock: DB ParamBlockSize DUP (?) ;Parameter Block for EXEC Call
  FCB1:       DB FCBSize DUP (?)        ;File Control Block #1
  FCB2:       DB FCBSize DUP (?)        ;File Control Block #2
  OldSPExec   DW ?                      ;SP may be destroyed by EXEC Call

  ;----------------------------------------------------------------------------
  ;Strings needed to write Descriptor Header Information to the screen
  ;----------------------------------------------------------------------------
  HostIndexMsg:  DB 'USB HOST INDEX: ',0
  DvcAddressMsg: DB 'DEVICE ADDRESS: ',0

  ;----------------------------------------------------------------------------
  ;Strings needed to set up Command Tail for Exec Call
  ;----------------------------------------------------------------------------
  ReportDescrMsg:     DB 'ReportDescriptor '
  ReportDescrMsgAddr: DB 'xxxx:xxxx '
  ReportDescrCallBk:  DB 'xxxx:xxxx'
                      DB  0

  DescriptorMsg:     DB 'Descriptor '
  DescriptorMsgAddr: DB 'xxxx:xxxx '
  DescriptorMsgHost: DB 'xxh '
  DescriptorMsgDvc:  DB 'xxh '
  DescriptorCallBk:  DB 'xxxx:xxxx'
                     DB  0

  TDStatusMsg:    DB 'TDStatusCode '
  TDStatusCode:   DB 'xxxxh '
  TDStatusCallBk: DB 'xxxx:xxxx'
                  DB 0

  Int14ErrMsg:    DB 'Int14ErrorCode '
  Int14ErrCode:   DB 'xxxxh '
  Int14ErrCallBk: DB 'xxxx:xxxx'
                  DB 0

  ;----------------------------------------------------------------------------
  ;Error Message for when the Support File is not found
  ;----------------------------------------------------------------------------
  NoSuptFileMsg:
    DB 'Error! Need Support File ',0


;==============================================================================
;Help Screen Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Data needed if the User has changed the name of the program from USBJSTIK
  ;----------------------------------------------------------------------------
  RealName:         ;Real name of our program (MUST end in 0)
    DB 'USBJSTIK',0 ;  & MUST have enough space for 8-char name
  RealNameSz DW 8   ;Size of RealName (not incl 0)

  ;----------------------------------------------------------------------------
  ;Syntax Help String (if user asks for Help)
  ;----------------------------------------------------------------------------
  SyntaxMsgHdr:
    DB 'SYNTAX: ',0
  SyntaxMsg:
    DB '[Options]',CR,LF
    DB LF
    DB '  ?      Í Show this HELP screen',CR,LF
    DB '  A      Í Show all ALIASES for these command line Options',CR,LF
    DB '  ErrLvl Í Show all ErrorLevels (DOS Return Codes)',CR,LF
    DB '  U      Í UNINSTALL from memory',CR,LF
    DB '  L:Y/N  Í Force installation into LOW memory (Default = No)',CR,LF
    DB LF
    DB '  S   Í Display current STATUS of program',CR,LF
    DB '  C   Í Diplay CONFIGURATION (& other) descriptors of last joystick found',CR,LF
    DB '  R   Í Show HID REPORT descriptor of last joystick found',CR,LF
    DB '  J:# Í Display current status of JOYSTICK Index # (0-7)',CR,LF
    DB LF
    DB '  B        Í Show list of BAD (incompatible) joysticks found',CR,LF
    DB '  Beep:Y/N Í BEEP speaker when bad joystick is found (Default = Yes)',CR,LF
    DB LF
    DB '  Ctr:# Í Use # as BIOS Center coordinate (10-200, Default = 50)',CR,LF
    DB '  I:#   Í Virtualize I/O Port # (200h-20Fh, Default = 201h)',CR,LF
    DB '             (requires appropriate memory manager, like EMM386 or 386MAX)',CR,LF
    DB LF
    DB '  F:Y/N Í Use FIFTEEN-button protocol (Default = No (4-buttons))',CR,LF
    DB '  T:Y/N Í Use THRUSTMASTER protocol for 4-way DPad/HatSwitch (Default = No)',CR,LF
    DB '  P:#   Í Be # PERCENT from Center to detect as movement (20-80, Default = 50)',CR,LF
    DB LF
    DB '  M:Entity FROM J#,CType,C#[,C2#] Í MAP Analog Entity FROM USB Control',CR,LF
    DB '    Entity = Analog Joystick Axis (AX, AY, BX, BY, AZ) or Button (A01-A15)',CR,LF
    DB '    J#     = USB Joystick/GamePad Index (0-7)',CR,LF
    DB '    CType  = Control Type (Axis, Throttle, Slider, DPad, Button)',CR,LF
    DB '    C#     = Control Index (0-99)',CR,LF
    DB '    C2#    = Second Control Index (0-99) (if required)'
    DB 0


;==============================================================================
;Program Status Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings needed to print the Program Status to the screen
  ;----------------------------------------------------------------------------
  StatusMsg1:
    DB '  COMBINED USB JOYSTICK STATUS            INDIVIDUAL JOYSTICKS',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ   ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 'Number of Buttons (4,15):    ',0
  StatusMsg2:
    DB                                 '   Idx Axs Thr Sld Hat Btn Hst Adr Itf',CR,LF
    DB 'ThrustMaster Protocol:       ',0
  StatusMsg3:
    DB                                 '   ÄÄÄ ÄÄÄ ÄÄÄ ÄÄÄ ÄÄÄ ÄÄÄ ÄÄÄ ÄÄÄ ÄÄÄ',CR,LF
    DB 'Virtualize I/O Port:       ',0
  StatusMsg4:
    DB 'BIOS Center Coord:         ',0
  StatusMsg5:
    DB 'Movement Percent:          ',0
  Status1EndMsg:
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',0
  Status2EndMsg:
    DB '                                   ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB LF
    DB LF
    DB '       USB JOYSTICK CONTROL => ANALOG JOYSTICK ENTITY MAPPING',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 'Alg Joy Cntrl Control ³ Alg Joy Cntrl Control ³ Alg Joy Cntrl Control',CR,LF
    DB 'Ety Idx Type   Index  ³ Ety Idx Type   Index  ³ Ety Idx Type   Index',CR,LF
    DB 'ÄÄÄ ÄÄÄ ÄÄÄÄÄ ÄÄÄÄÄÄÄ ³ ÄÄÄ ÄÄÄ ÄÄÄÄÄ ÄÄÄÄÄÄÄ ³ ÄÄÄ ÄÄÄ ÄÄÄÄÄ ÄÄÄÄÄÄÄ',CR,LF
    DB 0

  MapEndMsg:
    DB CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  CMsgSep:       DB ' ³ ',0

  CMsgButton:    DB 'Buttn',0
  CMsgHat:       DB 'HatSw',0
  CMsgSlider:    DB 'Slide',0
  CMsgThrottle:  DB 'Throt',0
  CMsgAxis:      DB 'Axis ',0
  CMsgSize      EQU $-CMsgAxis

  ;----------------------------------------------------------------------------
  ;Note: This is the order we actually write the Translation Table entries in.
  ;      The Translation table is stored Axes first (AX ... AZ) followed by
  ;        the Buttons (A01 .. A15).
  ;      When we write them we do it in three columns, with the first column
  ;        being the Axes, the second column being Buttons 1-8, and the third
  ;        column being Buttons 9-15.  This list is sorted by the order we
  ;        need to write them in.
  ;----------------------------------------------------------------------------
  XlatMsgList:
    DB 'AX ',0
    DB 'A01',0
    DB 'A09',0
    DB 'AY ',0
    DB 'A02',0
    DB 'A10',0
    DB 'BX ',0
    DB 'A03',0
    DB 'A11',0
    DB 'BY ',0
    DB 'A04',0
    DB 'A12',0
    DB 'AZ ',0
    DB 'A05',0
    DB 'A13',0
    DB 'A06',0
    DB 'A14',0
    DB 'A07',0
    DB 'A15',0
    DB 'A08',0

  YesMsg:  DB 'Yes',0
  NoMsgS:  DB ' No',0

  DuplicatesMsg:
    DB LF
    DB 'A USB Joystick Control is mapped to more than one Analog Joystick Entity.',CR,LF
    DB 'USBJSTIK will continue, but this may cause you some problems!',CR,LF
    DB 0


;==============================================================================
;Individual Joystick Status Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Joystick Index to Get the status of
  ;----------------------------------------------------------------------------
  JoyStatusIndex DB -1 ;-1 = N/A

  ;----------------------------------------------------------------------------
  ;Strings needed to print the Status to the screen
  ;----------------------------------------------------------------------------
  AxisMsg:     DB ' AXIS ',0
  ThrottleMsg: DB 'THROT ',0
  SliderMsg:   DB 'SLIDE ',0
  DPadMsg:     DB 'HAT ',0
  ButtonMsg:   DB 'B ',0
  LineMsg5:    DB '=='
  LineMsg3:    DB '=='
  LineMsg1:    DB '= ',0
  CrMsg:       DB CR,0

  NoStatusMsg:
    DB CR
    DB 'Could not find a valid USB Joystick or GamePad at Index ',0


;==============================================================================
;Bad Device Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings needed to print Bad Device Table to the screen
  ;----------------------------------------------------------------------------
  BadDeviceHdr:
    DB ' BAD (INCOMPATIBLE) JOYSTICKS',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB  LF
    DB 'HOST  DVC   INTF  STAGE  ERROR',CR,LF
    DB 'INDX  ADDR  NUM    NUM   CODE',CR,LF
    DB 'ÄÄÄÄ  ÄÄÄÄ  ÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄ',CR,LF
    DB  0

  NoneFoundMsg:
    DB '#ÄÄ#  #ÄÄ#  None  #ÄÄÄ# #ÄÄÄ#',CR,LF,0
  BadBeepMsg:
    DB 'Beep for Bad Joysticks: ',0


;==============================================================================
;ErrorLevel Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;ErrorLevels, and Table for ErrorLevel Description Strings
  ;----------------------------------------------------------------------------
  ErLvlOption   EQU  1 ;Bad Option on the command line
  ErLvlMemory   EQU  2 ;Memory problem with the computer
  ErLvlUninst   EQU  3 ;Not in memory yet, can't perform Request
  ErLvlVersion  EQU  4 ;Another version of the program already installed
  ErLvlDOSVer   EQU  5 ;DOS Version too old
  ErLvlStdIn    EQU  6 ;StdIn file too big
  ErLvlNoHost   EQU  7 ;No USB Host Driver installed
  ErLvlHostInit EQU  8 ;Error while trying to initialize host request
  ErLvlNoData   EQU  9 ;No Report/Descriptor Data to Print
  ErLvlSuptFile EQU 10 ;Could not Find Support File
  ErLvlNoDevice EQU 11 ;No Devices installed, can't show Raw Data

  ErrLvlHdr:
    DB  CR,LF
    DB '                      ERRORLEVELS (DOS RETURN CODES)',CR,LF
    DB '  ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB '   0 No Error.',CR,LF
    DB 0

  ErrLvlTbl:
    DB ErLvlOption
       DB "Bad Command-line Option.",0
    DB ErLvlMemory
       DB "Memory problem with the computer.",0
    DB ErLvlUninst
       DB "USBJSTIK is not installed in memory yet -- can't perform Request.",0
    DB ErLvlVersion
       DB "A different version of USBJSTIK is already installed in memory.",0
    DB ErLvlDOSVer
       DB "DOS must be at least version 3.00.",0
    DB ErLvlStdIn
       StdInTooBigMsg:
       DB 'The Redirected Input Option File ("USBJSTIK < {FileName}") is too big.',0
    DB ErLvlNoHost
       DB "Could not find a compatible USB Host Driver in memory.",0
    DB ErLvlHostInit
       DB "Could not properly initialize the USB Host Driver.",0
    DB ErLvlNoData
       DB "There is no Report or Configuration Descriptor data to write.",0
    DB ErLvlSuptFile
       DB "Could not find the required USBSUPT1.COM support file.",0
    DB ErLvlNoDevice
       DB "No Joystick is available to show the Raw Data for.",0
    DB -1,-1 ;End of Table


;==============================================================================
;Alias Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Strings needed to print Command Line Aliases to the screen
  ;----------------------------------------------------------------------------
  AliasHdrMsg:
    DB '                       ALIASES FOR COMMAND-LINE OPTIONS',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  YesNoHdrMsg:
    DB '       ALIASES FOR YES & NO',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  JStikHdrMsg:
    DB '         ALIASES FOR JOYSTICK INDEXES',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  DIHdrMsg:
    DB 'ALIASES FOR JOYSTICK NAMES',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  EntityHdrMsg:
    DB 'ALIASES FOR ANALOG JOYSTICK ENTITIES',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  SubEntityHdrMsg:
    DB 'ALIASES FOR ANALOG JOYSTICK SUBENTITIES',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  CtrlTypeHdrMsg:
    DB '           ALIASES FOR CONTROL TYPES',CR,LF
    DB 'ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ',CR,LF
    DB 0

  ;----------------------------------------------------------------------------
  ;Table needed to temporarily store Aliases.
  ;They are originally sorted in reverse alphabetical order.
  ;To write them in forward alphabetical order, we temporarily store
  ;  the String Pointers, in the original reverse order, in this table.
  ;  We then write the strings, starting with the last entry in this table
  ;  and moving backwards.
  ;The number of entries in this table must be AT LEAST as big as the largest
  ;  number of Aliases for a single command Option.  Most Options don't have
  ;  more than a dozen or so Aliases.
  ;----------------------------------------------------------------------------
  AliasSortTbl: DW 50 DUP (?) ;Table to store Alias Strings (to reverse order)


;==============================================================================
;Command-line (Parsing) Related
;==============================================================================

  ;----------------------------------------------------------------------------
  ;Extra Memory Segment (used to store compressed contents of STDIN)
  ;----------------------------------------------------------------------------
  StdInSegment DW ?

  ;----------------------------------------------------------------------------
  ;Data needed to Parse the command line for Options
  ;----------------------------------------------------------------------------
  ParseTest  DB Yes ;Testing the command for errors?
  ParseError DB  No ;Error while Parsing Command Line?

  ;----------------------------------------------------------------------------
  ;Various Parsing-related messages we may need to print to the screen
  ;----------------------------------------------------------------------------
  ParseCmdMsg:
    DB 'Error in the command-line Options for USBJSTIK:',CR,LF,0
  ParseEnvMsg:
    DB 'Error in the Environment variable "USBJSTIK":',CR,LF,0
  ParseStdInMsg:
    DB 'Error in the redirected input file ("USBJSTIK < {FileName}"):',CR,LF,0
  ParseErrMsg:
    DB '^ Error',CR,LF,LF,0
  ParseErrEnv:
    DB 'Reset the Environment variable (type "SET USBJSTIK=") and then',CR,LF
  ParseErrMsg2:
    DB 'Type "USBJSTIK ?" for Help.',CR,LF,0

  Copyright:
    DB "USBJSTIK 0.11, (C) 2007-2009, Bret E. Johnson.",CR,LF
    DB "DOS Driver for up to 8 USB Joysticks or GamePads.",CR,LF
    DB  LF,0
  EnvMsg:
    DB  'Environment: ',0
  InstallMsg1:
    DB 'USBJSTIK has been ',0
  InstallMsgAuto:
    DB 'automatically ',0
  InstallMsgHigh:
    DB 'installed into Upper Memory.',0
  InstallMsgHole:
    DB 'installed into a Low Memory "Hole".',0
  InstallMsgNorm:
    DB 'installed into Low Memory.',0
  InstallMsgLast:
    DB CR,LF
    DB 'Type "USBJSTIK U" to Uninstall USBJSTIK from memory.',CR,LF,0
  DOSVerMsg:
    DB 'You must be using DOS version 3.00 or later to use this program.',0
  NoHostMsg:
    DB 'There must be a compatible USB Host Driver installed in memory',CR,LF
    DB '  (something like USBUHCI.COM) before this program can be installed.',0
  HostInitErrMsg:
    DB 'There was an error while trying to initialize the USB Host.',0
  NoEnvironMsg:
    DB 'There is no DOS Environment.',CR,LF
    DB 'There is something WEIRD going on here!',0
  ExtraMemoryMsg:
    DB 'There is not enough available memory to run this program!',0
  WrongVerMsg:
    DB 'Another version of USBJSTIK was found in memory.',CR,LF
    DB 'Please UNINSTALL the other version before continuing.',0
  NoDescrDataMsg:
    DB 'There is no Descriptor Data to Write!',0
  UninstallMsg:
    DB 'USBJSTIK has been Uninstalled from memory.',CR,LF,0
  NoUninstallMsg:
    DB 'Unable to Uninstall USBJSTIK from memory, but it has been Disabled.',CR,LF
    DB "Remove any TSR's installed after USBJSTIK and try again.",CR,LF
    DB LF
    DB 'To Re-Enable USBJSTIK, simply type "USBJSTIK" at the command-line.',0
  ReEnabledMsg:
    DB 'USBJSTIK has been Re-Enabled.',CR,LF
    DB LF,0
  UninstallErrMsg:
    DB "Can't find USBJSTIK in memory.",CR,LF
    DB 'You must install it before it can be Uninstalled.',0
  UpdateMsg:
    DB 'Resident USBJSTIK has been updated with new information.',0

  BadDvcErrMsg:
    DB 'Bad Device',0
  JoyStatusErrMsg:
    DB 'Joystick Status',0
  ReportErrMsg:
    DB 'Report '
  DescrErrMsg:
    DB 'Descriptor',0
  StatusErrMsg:
    DB 'Program Status',0
  DataErrMsg:
    DB ' Data is not available until after',CR,LF
    DB '  USBJSTIK has been installed into memory.',0

  ;----------------------------------------------------------------------------
  ;Strings needed to write the Command-line error message
  ;----------------------------------------------------------------------------
