FILE	*tmpf;

long
getsize()
{
	register c;
	long j;

	c = getc(tmpf);
	if(c == EOF)
		return((long)-1);
	if(c <= 253)
		return((long)c);
	if(c == 255)
		return((long)-1);
	j = 0;
	for(c=0;c<3;c++)
		j = (j<<8) + (getc(tmpf)&0377);
	return(j);
}

putsize(s)
long	s;
{
	if(s <= 253) {
		putc((char)s, tmpf);
		return;
	}
	putc(254, tmpf);
	putc((char)(s>>16), tmpf);
	putc((char)(s>>8), tmpf);
	putc((char)s, tmpf);
}
