bread(bno, buf, cnt)
daddr_t bno;
char *buf;
{
	int n;
	extern errno;

	lseek(fi, bno<<BSHIFT, 0);
	if((n=read(fi, buf, cnt)) != cnt) {
		printf("read error %D\n", bno);
		printf("count = %d; errno = %d\n", n, errno);
		exit(0);
	}
}
