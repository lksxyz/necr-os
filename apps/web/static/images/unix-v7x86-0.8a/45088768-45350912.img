static int
mncmp(p1,p2)
char *p1;
char *p2;
{
    return strcmp(p1, ((struct mntbl *)p2)->mn);
}

static char *
bsearch(key, base, nmemb, size, compar)
char *key;
char *base;
unsigned nmemb;
unsigned size;
int (*compar) ();
{
    char *ptr;
    unsigned lo, hi, ix;
    int x;

    lo = 1;
    hi = nmemb;
    while (hi >= lo) {
        ix = (lo + hi) / 2;
        ptr = base + (ix - 1) * size;
        x = compar(key, ptr);
        if (!x)
            return ptr;
        if (x < 0)
            hi turn;
	for (i=0; i<15; i++)
		close(i);
	dup(dup(open("/dev/null", 0)));
	sprintf(sbuf, "/bin/mv %.14s %s", file, PDIR);
	system(sbuf);
	chdir(PDIR);
	if (stat(file, &stbuf) == -1)
		exit(1);
	setgid(stbuf.st_gid);
	setuid(stbuf.st_uid);
	if (pid = fork()) {
		if (pid == -1)
			exit(1);
		wait((int *)0);
		unlink(file);
		exit(0);
	}
	nice(3);
	execl("/bin/sh", "sh", file, 0);
	execl("/usr/bin/sh", "sh", file, 0);
	fprintf(stderr, "Can't execl shell\n");
	exit(1);
}
