static
write()
{
    unsigned i;

    /* Write a.out header */
    output(4, 0x0107);
    for (i = 0; i < 3; i++)
        output(4, pcs[i] - bs[i]);
    output(4, symid * 16);
    output(4, 0);
    for (i = 0; i < 2; i++)
        output(4, nrel[i] * 8);
    /* Write .text and .data */
    for (i = 0; i < bs[2]; i++)
        output(1, bf[i]);
    /* Write relocation bits */
    for (i = 0; i < 2; i++)
        relout(i);
    /* Write symbol table */
    symout();
}

static unsigned
symout()
{
    		bp = search(blk);
		fcp = &sfile;
	}
	else
		fcp = &dfile;
	if(bp->b_bno == blk)
		return(bp);
	flush(fcp,bp);
	if(bread(fcp,bp->b_un.b_buf,blk,BSIZE) != NO) {
		bp->b_bno = blk;
		return(bp);
	}
	bp->b_bno = (daddr_t)-1;
	return(NULL);
}


flush(fcp,bp)
struct filecntl *fcp;
register BUFAREA *bp;
{
	if(bp->b_dirty) {
		bwrite(fcp,bp->b_un.b_buf,bp->b_bno,BSIZE);
	}
	bp->b_dirty = 0;
}


