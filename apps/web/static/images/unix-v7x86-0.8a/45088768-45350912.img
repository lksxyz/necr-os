static int
setlab(opt)
int opt;
{
    int n;

    if (tk_val < 0 || tk_val > 9)
        return E_MISC;
    n = lab[tk_val];
    if (opt != 0) {
        n++;
        if (opt == 2)
            lab[tk_val] = n;
    }
    if (n > 9999999)
        return E_MISC;
    sprintf(tk_str, "%d%07d", tk_val, n);
    tk_len = 8;
    return 0;
}

