slp()
{
	register i;
	time_t t;

	time(&t);
	i = itime - t;
	if(i > 0)
		sleep(i);
}

ex(s)
char *s;
{
	int st;

	if(fork()) {
		wait(&st);
		return;
	}
	if(fork())
		exit(0);
	freopen("/", "r", stdin);
	execl("/bin/sh", "sh", "-c", s, 0);
	exit(0);
}

