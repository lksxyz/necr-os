int edebug = 0;
ecomp( p ) register NODE *p; {
	if( edebug ) fwalk( p, eprint, 0 );
	if( !reached ){
		werror( "statement not reached" );
		reached = 1;
		}
	p = optim(p);
	walkf( p, prtdcon );
	locctr( PROG );
	ecode( p );
	tfree(p);
	}

