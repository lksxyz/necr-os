	case UGE:
		p->lval = (p->lval-val)>=0;
		break;
	case UGT:
		p->lval = (p->lval-val)>0;
		break;
	case EQ:
		p->lval = p->lval == val;
		break;
	case NE:
		p->lval = p->lval != val;
		break;
	default:
		return(0);
