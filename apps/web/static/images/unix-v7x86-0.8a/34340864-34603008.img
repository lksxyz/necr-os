		break;

	case STARG:
	case STASG:
	case STCALL:
	case UNARY STCALL:
		/* set up size parameters */
		p->stsize = (tsize(STRTY,p->left->cdim,p->left->csiz)+SZCHAR-1)/SZCHAR;
		p->stalign = talign(STRTY,p->left->csiz)/SZCHAR;
		break;

	case REG:
		rbusy( p->rval, p->type );
	default:
		p->name[0] = '\0';
		}

	p->rall = NOPREF;

	if( ty != LTYPE ) p2tree( p->left );
	if( ty == BITYPE ) p2tree( p->right );
