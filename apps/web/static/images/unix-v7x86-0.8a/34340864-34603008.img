union ndu {

	struct {
		int op;
		int rall;
		TWORD type;
		int su;
		char name[NCHNAM];
		NODE *left;
		NODE *right;
		};
	
	struct {
		int op;
		int rall;
		TWORD type;
		int su;
		char name[NCHNAM];
