notlval(p) register NODE *p; {

	/* return 0 if p an lvalue, 1 otherwise */

	again:

	switch( p->op ){

	case FLD:
		p = p->left;
		goto again;

	case NAME:
	case OREG:
	case UNARY MUL:
		if( ISARY(p->type) || ISFTN(p->type) ) return(1);
	case REG:
		return(0);

	default:
		return(1);

		}

	}

NODE *
bcon( i ){ /* make a constant node with value i */
	register NODE *p;

	p = block( ICON, NIL, /* UNIX V7 source code: see /COPYRIGHT or www.tuhs.org for details. */

# include <stdio.h>
# include "prep.h"

int	(*acts[])() =	{0,
			coll,
			save,
			ctout,
			gobble2,
			hyphen,
			bsp,
			bslash,
			punc
			};


