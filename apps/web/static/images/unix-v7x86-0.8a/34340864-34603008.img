		if(c & 0200) {
			fprintf(stderr, "Illegal character: %o line %d file %s\n",
				c, lno, arg);
			exit(1);
		}

		if(l == 0 && (c == '.' || c == '\'')) {
			while((c = getc(fi)) != '\n' )
				if(c == -1)	return;
			lno++;
			l = -1;
