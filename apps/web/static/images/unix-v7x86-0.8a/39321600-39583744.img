	call	rblk
	and	$7,si
	shl	$6,si
	add	$buf,si
	mov	$inod,di
1:	movsw
	cmp	$inod+64,di
	jb	1b
	ret

// read in a mapped block
// file offset is in bno
// Uses ax, si
rmblk:
	mov	bno,ax
	cmp	$10,ax
	jb	1f
