// primary bootstrap

	.code16

	.set partid,0x72
	.set boot,start+1024

start:
	jmp	start1
	nop

// boot sector bios parameter block

	.ascii	"v7/x86  "
	.word	512		// bytes per sector
	.byte	0
	.word	0
	.byte	0
	.word	0
	.word	0
	.byte	0		// media descriptor
	.word	0
	.word	18		// sectors per track
	.word	2		// drive heads
hidden: .word	0		// hidden sectors
	.word	0
	.word	0
	.word	0
