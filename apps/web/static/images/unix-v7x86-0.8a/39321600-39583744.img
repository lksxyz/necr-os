struct wordent *
freenod(p1, p2)
	register struct wordent *p1, *p2;
{
	register struct wordent *retp = p1->prev;

	while (p1 != p2) {
		xfree(p1->word);
		p1 = p1->next;
		xfree(p1->prev);
	}
	retp->next = p2;
	p2->prev = retp;
	return (retp);
}

