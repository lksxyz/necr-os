	int sign;

	sign = 0;
	if (cp[0] == '+' && cp[1])
		cp++;
	if (*cp == '-') {
		sign++;
		cp++;
		if (!digit(*cp))
			goto bad/WORD))*(BLOCK/WORD);
		q = (union store *)sbrk(0);
